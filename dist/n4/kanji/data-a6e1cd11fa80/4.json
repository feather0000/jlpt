["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">兄</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>兄长；哥哥</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケイ・キョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あに</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">兄</span><span class=\"kana\" lang=\"ja\">あに</span><span class=\"k-wz\">哥哥；兄长；大伯子；姐夫（配偶的兄长或姐姐的丈夫）</span></li><li><span class=\"k-w\" lang=\"ja\">兄弟</span><span class=\"kana\" lang=\"ja\">きょうだい</span><span class=\"k-wz\">兄弟姐妹；手足；同父异母（或同母异父）的兄弟姐妹；继兄弟姐妹；养兄弟姐妹；伙伴；朋友</span></li><li><span class=\"k-w\" lang=\"ja\">お兄さん</span><span class=\"kana\" lang=\"ja\">おにいさん</span><span class=\"k-wz\">哥哥；大哥；小伙子；哥们；老兄</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">犬</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>狗</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いぬ・いぬ-</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">犬</span><span class=\"kana\" lang=\"ja\">いぬ</span><span class=\"k-wz\">犬；狗；告密者；线人；奸细；内奸；失败者；混蛋；假的；劣质的；无用的；徒劳的</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">妹</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>妹妹</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">マイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いもうと</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">妹</span><span class=\"kana\" lang=\"ja\">いもうと</span><span class=\"k-wz\">妹妹</span></li><li><span class=\"k-w\" lang=\"ja\">従姉妹</span><span class=\"kana\" lang=\"ja\">いとこ</span><span class=\"k-wz\">女表亲；女堂姐妹</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">姉</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>姐姐</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あね・はは</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">姉</span><span class=\"kana\" lang=\"ja\">あね</span><span class=\"k-wz\">姐姐；姊姊</span></li><li><span class=\"k-w\" lang=\"ja\">お姉さん</span><span class=\"kana\" lang=\"ja\">おねえさん</span><span class=\"k-wz\">姐姐；大姐；年轻女性；小姐；（称呼女服务员等）小姐；服务员；姐姐（艺伎对前辈的敬称）；大姐姐；年长的女孩</span></li><li><span class=\"k-w\" lang=\"ja\">従姉妹</span><span class=\"kana\" lang=\"ja\">いとこ</span><span class=\"k-wz\">女表亲；女堂姐妹</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">漢</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>中国；汉族</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">漢字</span><span class=\"kana\" lang=\"ja\">かんじ</span><span class=\"k-wz\">汉字</span></li><li><span class=\"k-w\" lang=\"ja\">漢和</span><span class=\"kana\" lang=\"ja\">かんわ</span><span class=\"k-wz\">中国和日本；汉语和日语；汉和词典；汉字词典</span></li><li><span class=\"k-w\" lang=\"ja\">漢語</span><span class=\"kana\" lang=\"ja\">かんご</span><span class=\"k-wz\">汉语词；汉语借词；汉语；汉族语言</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">坊</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>男孩；僧侣住所；僧侣</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボウ・ボッ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">寝坊</span><span class=\"kana\" lang=\"ja\">ねぼう</span><span class=\"k-wz\">睡懒觉；睡过头；爱睡懒觉的人；贪睡的人</span></li><li><span class=\"k-w\" lang=\"ja\">赤ん坊</span><span class=\"kana\" lang=\"ja\">あかんぼう</span><span class=\"k-wz\">婴儿；婴幼儿</span></li><li><span class=\"k-w\" lang=\"ja\">坊や</span><span class=\"kana\" lang=\"ja\">ぼうや</span><span class=\"k-wz\">男孩；儿子；孩子；小男孩；毛头小伙；初出茅庐的人</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">凄</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>可怕；惊人；厉害；寒冷；荒凉</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セイ・サイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さむ.い・すご.い・すさ.まじい</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">凄い</span><span class=\"kana\" lang=\"ja\">すごい</span><span class=\"k-wz\">可怕的；令人惊恐的；惊人的；了不起的；非常棒的；极好的；数量庞大的；极其广大的；极其；非常；十分</span></li><li><span class=\"k-w\" lang=\"ja\">物凄い</span><span class=\"kana\" lang=\"ja\">ものすごい</span><span class=\"k-wz\">惊人的；巨大的；极端的；可怕的；恐怖的；令人毛骨悚然的</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">痩</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>变瘦；消瘦</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソウ・チュウ・シュウ・シュ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">や.せる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">痩せる</span><span class=\"kana\" lang=\"ja\">やせる</span><span class=\"k-wz\">变瘦；减肥；消瘦；（土壤）变贫瘠；变不毛；变荒芜</span></li></ul></div></li>"]