["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">特</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>特殊</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">トク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">特に</span><span class=\"kana\" lang=\"ja\">とくに</span><span class=\"k-wz\">特别；尤其；格外；特意</span></li><li><span class=\"k-w\" lang=\"ja\">特別</span><span class=\"kana\" lang=\"ja\">とくべつ</span><span class=\"k-wz\">特别；特殊；非凡；例外的；格外的</span></li><li><span class=\"k-w\" lang=\"ja\">特急</span><span class=\"kana\" lang=\"ja\">とっきゅう</span><span class=\"k-wz\">特快列车（需要购买特快车票的列车）；特快列车（停靠站数有限的列车）；火急；紧急</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">私</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>我；私；私人</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">わたくし・わたし</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">私</span><span class=\"kana\" lang=\"ja\">あたし</span><span class=\"k-wz\">我；我（女性或年长者用语）</span></li><li><span class=\"k-w\" lang=\"ja\">私鉄</span><span class=\"kana\" lang=\"ja\">してつ</span><span class=\"k-wz\">私营铁路；民营铁路</span></li><li><span class=\"k-w\" lang=\"ja\">私立</span><span class=\"kana\" lang=\"ja\">しりつ</span><span class=\"k-wz\">私立的</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">朝</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>早晨；朝代；政权；时代；时期；朝鲜</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span><