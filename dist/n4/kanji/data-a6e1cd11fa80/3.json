["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">古</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>旧；古老；陈旧；古时</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">コ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ふる.い・ふる-・-ふる.す</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">古い</span><span class=\"kana\" lang=\"ja\">ふるい</span><span class=\"k-wz\">老的；陈旧的；古老的；破旧的；长久的；由来已久的；历史悠久的；远古的；久远的；陈腐的；老套的；俗气的；过时的；落伍的；不合时宜的</span></li><li><span class=\"k-w\" lang=\"ja\">中古</span><span class=\"kana\" lang=\"ja\">ちゅうこ</span><span class=\"k-wz\">二手的；旧的；用过的；中古时代；（日本特指平安时代的）中世纪</span></li><li><span class=\"k-w\" lang=\"ja\">稽古</span><span class=\"kana\" lang=\"ja\">けいこ</span><span class=\"k-wz\">练习；训练；学习</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">歌</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>歌曲；歌唱</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">うた・うた.う</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">歌</span><span class=\"kana\" lang=\"ja\">うた</span><span class=\"k-wz\">歌曲；歌唱；古典日本诗歌（尤指短歌）；现代诗歌</span></li><li><span class=\"k-w\" lang=\"ja\">歌う</span><span class=\"kana\" lang=\"ja\">うたう</span><span class=\"k-wz\">唱；歌唱；歌咏；用诗歌表达；吟诵</span></li><li><span class=\"k-w\" lang=\"ja\">歌手</span><span class=\"kana\" lang=\"ja\">かしゅ</span><span class=\"k-wz\">歌手；歌唱家</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">買</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>买</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">バイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">か.う</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">買う</span><span class=\"kana\" lang=\"ja\">かう</span><span class=\"k-wz\">买</span></li><li><span class=\"k-w\" lang=\"ja\">買い物</span><span class=\"kana\" lang=\"ja\">かいもの</span><span class=\"k-wz\">购物；购买的商品</span></li><li><span class=\"k-w\" lang=\"ja\">売買</span><span class=\"kana\" lang=\"ja\">ばいばい</span><span class=\"k-wz\">买卖；贸易；交易（如人口贩运、军火走私、毒品贩运等）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">悪</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>坏；恶；邪恶；恶劣；不良</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">アク・オ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">わる.い・わる-・あ.し・にく.い・-にく.い・ああ・いずくに・いずくんぞ・にく.む</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">悪い</span><span class=\"kana\" lang=\"ja\">にくい</span><span class=\"k-wz\">可恨的；讨厌的；令人厌恶的；令人恼火的；令人气恼的；了不起的；极好的；令人钦佩的；可爱的；美妙的</span></li><li><span class=\"k-w\" lang=\"ja\">悪魔</span><span class=\"kana\" lang=\"ja\">あくま</span><span class=\"k-wz\">魔鬼；恶魔；妖魔；撒旦；魔鬼；魔罗；阻碍修行的邪魔</span></li><li><span class=\"k-w\" lang=\"ja\">悪口</span><span class=\"kana\" lang=\"ja\">あっこう</span><span class=\"k-wz\">辱骂；谩骂</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">図</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>地图；图画；计划；图谋；大胆</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ズ・ト</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">え・はか.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">地図</span><span class=\"kana\" lang=\"ja\">ちず</span><span class=\"k-wz\">地图；地图册；图表；平面图</span></li><li><span class=\"k-w\" lang=\"ja\">図書館</span><span class=\"kana\" lang=\"ja\">としょかん</span><span class=\"k-wz\">图书馆</span></li><li><span class=\"k-w\" lang=\"ja\">図</span><span class=\"kana\" lang=\"ja\">ず</span><span class=\"k-wz\">图；画；图表；图示；图解；地图；景象；场景</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">週</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>星期</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">今週</span><span class=\"kana\" lang=\"ja\">こんしゅう</span><span class=\"k-wz\">这周；本周</span></li><li><span class=\"k-w\" lang=\"ja\">先週</span><span class=\"kana\" lang=\"ja\">せんしゅう</span><span class=\"k-wz\">上周；前一周</span></li><li><span class=\"k-w\" lang=\"ja\">毎週</span><span class=\"kana\" lang=\"ja\">まいしゅう</span><span class=\"k-wz\">每周；每个星期</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">歩</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>步行；走；步（计数单位）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ホ・ブ・フ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ある.く・あゆ.む</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">歩く</span><span class=\"kana\" lang=\"ja\">あるく</span><span class=\"k-wz\">行走；步行</span></li><li><span class=\"k-w\" lang=\"ja\">散歩</span><span class=\"kana\" lang=\"ja\">さんぽ</span><span class=\"k-wz\">散步；漫步</span></li><li><span class=\"k-w\" lang=\"ja\">進歩</span><span class=\"kana\" lang=\"ja\">しんぽ</span><span class=\"k-wz\">进步；进展；改进；发展</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">風</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>风；样式；气息；风气；风度</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">フウ・フ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かぜ・かざ-</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">風</span><span class=\"kana\" lang=\"ja\">かぜ</span><span class=\"k-wz\">风；微风；气流；样子；风格；举止；感冒；流感</span></li><li><span class=\"k-w\" lang=\"ja\">風邪</span><span class=\"kana\" lang=\"ja\">かぜ</span><span class=\"k-wz\">感冒；流感；流行性感冒；风寒；呼吸道炎症性疾病</span></li><li><span class=\"k-w\" lang=\"ja\">お風呂</span><span class=\"kana\" lang=\"ja\">おふろ</span><span class=\"k-wz\">洗澡；浴缸</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">紙</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>纸</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かみ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">紙</span><span class=\"kana\" lang=\"ja\">かみ</span><span class=\"k-wz\">纸</span></li><li><span class=\"k-w\" lang=\"ja\">手紙</span><span class=\"kana\" lang=\"ja\">てがみ</span><span class=\"k-wz\">信件；便条</span></li><li><span class=\"k-w\" lang=\"ja\">紙屑</span><span class=\"kana\" lang=\"ja\">かみくず</span><span class=\"k-wz\">废纸；纸屑；纸片</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">黒</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>黑色；变黑；发黑</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">コク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">くろ・くろ.ずむ・くろ.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">黒</span><span class=\"kana\" lang=\"ja\">くろ</span><span class=\"k-wz\">黑；黑色；黑棋子；有罪；罪人</span></li><li><span class=\"k-w\" lang=\"ja\">黒い</span><span class=\"kana\" lang=\"ja\">くろい</span><span class=\"k-wz\">黑色的；深色的；黝黑的；晒黑的（皮肤）；可疑的；犯罪的；非法的；污黑的；烟熏的；沾满污垢的；邪恶的；恶毒的；黑心的；不吉利的；凶兆的；不祥的</span></li><li><span class=\"k-w\" lang=\"ja\">黒板</span><span class=\"kana\" lang=\"ja\">こくばん</span><span class=\"k-wz\">黑板</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">花</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>花；花朵</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カ・ケ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はな</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">花</span><span class=\"kana\" lang=\"ja\">はな</span><span class=\"k-wz\">花；花朵；花卉；花瓣；樱花；美丽；美貌；盛开；绽放（尤指樱花）；插花；花道；花牌；花札；最好的；最优秀的；华丽的；美好的；灿烂的；可爱的</span></li><li><span class=\"k-w\" lang=\"ja\">花瓶</span><span class=\"kana\" lang=\"ja\">かびん</span><span class=\"k-wz\">花瓶；插花瓶</span></li><li><span class=\"k-w\" lang=\"ja\">花見</span><span class=\"kana\" lang=\"ja\">はなみ</span><span class=\"k-wz\">赏樱花；赏花</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">春</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>春天；春季</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シュン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">春</span><span class=\"kana\" lang=\"ja\">はる</span><span class=\"k-wz\">春季；春天；新年；盛年；鼎盛时期；黄金时代；青春期；少年时期；性欲；情欲</span></li><li><span class=\"k-w\" lang=\"ja\">青春</span><span class=\"kana\" lang=\"ja\">せいしゅん</span><span class=\"k-wz\">青春；少年时代；人生的春天</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">赤</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>红色</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セキ・シャク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あか・あか-・あか.い・あか.らむ・あか.らめる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">赤</span><span class=\"kana\" lang=\"ja\">あか</span><span class=\"k-wz\">红；深红；猩红；含红色的颜色（如褐色、粉红色、橙色等）；红色（共产主义者）；红灯（交通）；红字（财务或校对中）；赤字；完全的；彻底的；完美的；明显的；铜；红色五点牌</span></li><li><span class=\"k-w\" lang=\"ja\">赤い</span><span class=\"kana\" lang=\"ja\">あかい</span><span class=\"k-wz\">红色；深红色；绯红色；朱红色；红色的；共产主义的</span></li><li><span class=\"k-w\" lang=\"ja\">赤ん坊</span><span class=\"kana\" lang=\"ja\">あかんぼう</span><span class=\"k-wz\">婴儿；婴幼儿</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">青</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>蓝色；绿色</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セイ・ショウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あお・あお-・あお.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">青</span><span class=\"kana\" lang=\"ja\">あお</span><span class=\"k-wz\">蓝色；青色；绿色；绿灯；黑色（马的毛色）；蓝色五点牌；未成熟的；未熟的；年轻的</span></li><li><span class=\"k-w\" lang=\"ja\">青い</span><span class=\"kana\" lang=\"ja\">あおい</span><span class=\"k-wz\">蓝色；蔚蓝；绿色；苍白；灰白；未成熟；不成熟；缺乏经验</span></li><li><span class=\"k-w\" lang=\"ja\">青年</span><span class=\"kana\" lang=\"ja\">せいねん</span><span class=\"k-wz\">青年；年轻人</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">館</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>建筑；宅邸；宫殿；大宅</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">やかた・たて</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">映画館</span><span class=\"kana\" lang=\"ja\">えいがかん</span><span class=\"k-wz\">电影院；影院；电影馆</span></li><li><span class=\"k-w\" lang=\"ja\">大使館</span><span class=\"kana\" lang=\"ja\">たいしかん</span><span class=\"k-wz\">大使馆</span></li><li><span class=\"k-w\" lang=\"ja\">図書館</span><span class=\"kana\" lang=\"ja\">としょかん</span><span class=\"k-wz\">图书馆</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">屋</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>屋顶；房屋；店铺；商人；卖家</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">オク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">や</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">部屋</span><span class=\"kana\" lang=\"ja\">へや</span><span class=\"k-wz\">房间；室；公寓；寓所；单间公寓；（相扑）部屋；相扑训练团体</span></li><li><span class=\"k-w\" lang=\"ja\">八百屋</span><span class=\"kana\" lang=\"ja\">やおや</span><span class=\"k-wz\">蔬菜水果店；菜店；多面手；杂家；什么都会一点的人</span></li><li><span class=\"k-w\" lang=\"ja\">屋上</span><span class=\"kana\" lang=\"ja\">おくじょう</span><span class=\"k-wz\">屋顶；楼顶</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">色</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>颜色；色彩；脸色；情色；色泽</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショク・シキ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いろ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">色</span><span class=\"kana\" lang=\"ja\">いろ</span><span class=\"k-wz\">色彩；颜色；色调；色泽；肤色；脸色；表情；神情；面容；样子；气质；风貌；性格；个性；品格；声调；音色；语气；爱欲；色欲；情欲；风流韵事；情人；相好；美貌；魅力；姿色；种类；类型；品种</span></li><li><span class=\"k-w\" lang=\"ja\">黄色</span><span class=\"kana\" lang=\"ja\">きいろ</span><span class=\"k-wz\">黄色；琥珀色</span></li><li><span class=\"k-w\" lang=\"ja\">茶色</span><span class=\"kana\" lang=\"ja\">ちゃいろ</span><span class=\"k-wz\">褐色；浅褐色；棕色</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">走</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>跑</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はし.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">走る</span><span class=\"kana\" lang=\"ja\">はしる</span><span class=\"k-wz\">跑；行驶；行进；移动；航行；冲；疾驰；飞奔；撤退；逃离；叛逃；投奔；逃跑；潜逃；私奔；闪现；划过；（疼痛）窜过；掠过；迅速传开；变坏；走向极端；转变；沦为；被情感所左右；卷入；陷入；贯通；延伸；绵延；横亘</span></li><li><span class=\"k-w\" lang=\"ja\">走行</span><span class=\"kana\" lang=\"ja\">そうこう</span><span class=\"k-wz\">(汽车、公共汽车等的)行驶；运行；行程；(程序的)运行</span></li><li><span class=\"k-w\" lang=\"ja\">逃走</span><span class=\"kana\" lang=\"ja\">とうそう</span><span class=\"k-wz\">逃走；逃亡；脱逃</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">秋</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>秋天</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あき・とき</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">秋</span><span class=\"kana\" lang=\"ja\">あき</span><span class=\"k-wz\">秋季；秋天</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">夏</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>夏天</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カ・ガ・ゲ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">なつ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">夏</span><span class=\"kana\" lang=\"ja\">なつ</span><span class=\"k-wz\">夏季；夏天</span></li><li><span class=\"k-w\" lang=\"ja\">夏休み</span><span class=\"kana\" lang=\"ja\">なつやすみ</span><span class=\"k-wz\">暑假；暑期</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">習</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a>学习；练习</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シュウ・ジュ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">なら.う・なら.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">習う</span><span class=\"kana\" lang=\"ja\">ならう</span><span class=\"k-wz\">向…学习；跟…学；学习；受训</span></li><li><span class=\"k-w\" lang=\"ja\">練習</span><span class=\"kana\" lang=\"ja\">れんしゅう</span><span class=\"k-wz\">练习；训练；操练；锻炼</span></li><li><span class=\"k-w\" lang=\"ja\">習慣</span><span class=\"kana\" lang=\"ja\">しゅうかん</span><span class=\"k-wz\">习惯</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">駅</div><div class=\"k-body\"><p class=\"k-m\"><a cla