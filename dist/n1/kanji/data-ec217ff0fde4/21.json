["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">肪</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>肥胖；脂肪</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">脂肪</span><span class=\"kana\" lang=\"ja\">しぼう</span><span class=\"k-wz\">脂肪；油脂；猪油；板油</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">扶</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>帮助；援助；协助</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">フ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たす.ける</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">扶養</span><span class=\"kana\" lang=\"ja\">ふよう</span><span class=\"k-wz\">赡养；供养</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">戯</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>玩耍；嬉戏；戏弄；戏剧</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ギ・ゲ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たわむ.れる・ざ.れる・じゃ.れる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">戯曲</span><span class=\"kana\" lang=\"ja\">ぎきょく</span><span class=\"k-wz\">戏剧；剧本；中国戏曲</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">伍</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>五；五人组；队列；行列</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ゴ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いつつ</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">忌</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>忌讳；禁忌；厌恶；丧事；忌日</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">い.む・い.み・い.まわしい</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">濁</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>浊音；浑浊；不纯；污浊；浊点</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ダク・ジョク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">にご.る・にご.す</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">濁る</span><span class=\"kana\" lang=\"ja\">にごる</span><span class=\"k-wz\">（液体或气体）变浑浊；变混浊；变污浊；变不纯净；（声音、颜色等）变沉闷；变不清晰；变模糊；变沙哑；（内心、社会等）变不纯净；被腐化；被污染；（辅音）浊化；发浊音</span></li><li><span class=\"k-w\" lang=\"ja\">清濁</span><span class=\"kana\" lang=\"ja\">せいだく</span><span class=\"k-wz\">善恶；清浊；清音与浊音</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">奔</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>奔跑；匆忙</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ホン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はし.る</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">斗</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>北斗；斗（容量单位）；酒勺</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ト・トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">蘭</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>兰花；荷兰</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ラン・ラ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">迅</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>快速；迅速</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">迅速</span><span class=\"kana\" lang=\"ja\">じんそく</span><span class=\"k-wz\">迅速；快速；敏捷；迅疾；及时</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">肖</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>相似；模仿</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あやか.る</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">鉢</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>钵；花盆；锅；头盖</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ハチ・ハツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">鉢</span><span class=\"kana\" lang=\"ja\">はち</span><span class=\"k-wz\">碗；锅；盆；花盆；植物盆；头顶；头盖骨</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">朽</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>腐朽；腐烂；隐居</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">く.ちる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">朽ちる</span><span class=\"kana\" lang=\"ja\">くちる</span><span class=\"k-wz\">腐烂；腐朽；衰败；默默无闻地死去；无名而终；随时间推移而被遗忘；湮没于时间</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">殻</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>外壳；空壳</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カク・コク・バイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">から・がら</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">殻</span><span class=\"kana\" lang=\"ja\">から</span><span class=\"k-wz\">壳；外壳；果壳；荚；谷壳</span></li><li><span class=\"k-w\" lang=\"ja\">貝殻</span><span class=\"kana\" lang=\"ja\">かいがら</span><span class=\"k-wz\">贝壳；贝类外壳</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">享</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>享受；享有；领受</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キョウ・コウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">う.ける</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">享受</span><span class=\"kana\" lang=\"ja\">きょうじゅ</span><span class=\"k-wz\">享受；享有；获得</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">秦</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>秦朝（中国古代王朝）；（指）中国；（指）外国归化人</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はた</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">茅</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>茅草；白茅</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボウ・ミョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かや・ちがや</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">藩</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>藩（大名领地）；屏障</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ハン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">沙</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>沙</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">サ・シャ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">すな・よなげる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">無沙汰</span><span class=\"kana\" lang=\"ja\">ぶさた</span><span class=\"k-wz\">久未写信或联系；疏于问候；久无音讯</span></li><li><span class=\"k-w\" lang=\"ja\">御無沙汰</span><span class=\"kana\" lang=\"ja\">ごぶさた</span><span class=\"k-wz\">久未通信；久疏问候；疏于联络</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">輔</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>帮助；辅助</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ホ・フ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たす.ける</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">媒</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>中介；媒人</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">バイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">なこうど</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">鶏</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>鸡</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">にわとり・とり</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">鶏肉</span><span class=\"kana\" lang=\"ja\">とりにく</span><span class=\"k-wz\">鸡肉；家禽肉；禽肉</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">禅</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>禅（佛教修行）；静思</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ゼン・セン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">しずか・ゆず.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">禅</span><span class=\"kana\" lang=\"ja\">ぜん</span><span class=\"k-wz\">禅定；深度冥想；禅宗；禅</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">嘱</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>委托；请求；传话</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">しょく.する・たの.む</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">胴</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>躯干；船体；轮毂</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ドウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">胴</span><span class=\"kana\" lang=\"ja\">どう</span><span class=\"k-wz\">躯干；躯体；身体；腹部；腰部；剑道胸甲；击中胸甲；鼓框；音箱；船体；庄家</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">迭</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>转移；交替</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">テツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">挿</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>插入；放入；嫁接；佩戴（刀剑）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さ.す・はさ.む</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">挿す</span><span class=\"kana\" lang=\"ja\">さす</span><span class=\"k-wz\">插入；放入；扦插；插枝；插花；插；摆花；佩（刀）；将（刀）插于腰带；关闭；上锁；闩上；扣紧</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">嵐</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>暴风雨；风暴</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ラン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あらし</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">嵐</span><span class=\"kana\" lang=\"ja\">あらし</span><span class=\"k-wz\">风暴；暴风雨；骚动；喧嚣；（如抗议的）浪潮；（如变革的）风潮；（纸牌游戏「おいちょかぶ」）三张同点数牌的组合</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">椎</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>椎（栲树）；槌（木槌）；脊柱</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ツイ・スイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つち・う.つ</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">絹</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>丝绸</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">きぬ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">絹</span><span class=\"kana\" lang=\"ja\">きぬ</span><span class=\"k-wz\">丝绸；丝</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">陪</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>陪同；跟随；侍奉；服从</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">バイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">剖</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>分割；剖开</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">解剖</span><span class=\"kana\" lang=\"ja\">かいぼう</span><span class=\"k-wz\">解剖；尸检；验尸；分析；事后检讨</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">譜</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>乐谱；系谱；谱表；图表</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">フ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">楽譜</span><span class=\"kana\" lang=\"ja\">がくふ</span><span class=\"k-wz\">乐谱；乐曲谱</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">郁</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>文化进步；香气</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">イク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">悠</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>永久；遥远；长久；悠闲</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ユウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">悠々</span><span class=\"kana\" lang=\"ja\">ゆうゆう</span><span class=\"k-wz\">悠闲；从容；安详；镇定；轻松；舒适；毫不费力；遥远；辽阔；无边；无尽；永恒</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">淑</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>优雅；温和；纯洁</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シュク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">しと.やか</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">帆</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>帆</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ハン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ほ</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">暁</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>拂晓；黎明；（事件发生的）当口</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ギョウ・キョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あかつき・さと.る</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">傑</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>卓越；杰出；优秀</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">すぐ.れる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">傑作</span><span class=\"kana\" lang=\"ja\">けっさく</span><span class=\"k-wz\">杰作；佳作；名作；（无意中）滑稽可笑的；荒诞的；离谱的；疯狂的</span></li><li><span class=\"k-w\" lang=\"ja\">傑</span><span class=\"kana\" lang=\"ja\">けつ</span><span class=\"k-wz\">（数词）最...的；前...名的</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">楠</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>樟树</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ナン・ダン・ゼン・ネン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">くす・くすのき</dd></dl><ul class=\"k-ws\"></ul></div></li>"]