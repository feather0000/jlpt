["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">宴</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>宴会；宴席；酒宴</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">エン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">うたげ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">宴会</span><span class=\"kana\" lang=\"ja\">えんかい</span><span class=\"k-wz\">宴会；宴席；招待会；酒席</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">鷹</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>鹰</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヨウ・オウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たか</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">賓</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>贵宾；客人；服从</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヒン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">まろうど・したがう</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">虜</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>俘虏；蛮夷；对敌人的蔑称</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">リョ・ロ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">とりこ・とりく</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">捕虜</span><span class=\"kana\" lang=\"ja\">ほりょ</span><span class=\"k-wz\">战俘；俘虏；被俘者</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">陶</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>陶器；瓷器</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">すえ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">陶器</span><span class=\"kana\" lang=\"ja\">とうき</span><span class=\"k-wz\">陶器；陶制品；陶瓷；瓷器</span></li><li><span class=\"k-w\" lang=\"ja\">鬱陶しい</span><span class=\"kana\" lang=\"ja\">うっとうしい</span><span class=\"k-wz\">阴郁的；沉闷的；烦人的；恼人的；阴沉的；沉闷的</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">鐘</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>钟；铃；锣；磬</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かね</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">鐘</span><span class=\"kana\" lang=\"ja\">かね</span><span class=\"k-wz\">钟；大钟；编钟</span></li><li><span class=\"k-w\" lang=\"ja\">釣鐘</span><span class=\"kana\" lang=\"ja\">つりがね</span><span class=\"k-wz\">寺庙的吊钟；悬钟；丧钟</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">憾</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>遗憾；悔恨；怨恨</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">うら.む</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div clas