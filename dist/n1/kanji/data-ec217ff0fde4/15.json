["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">践</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>践踏；踩；实践；履行</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ふ.む</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">実践</span><span class=\"kana\" lang=\"ja\">じっせん</span><span class=\"k-wz\">实践；付诸实践；实施；实践（作为社会活动的）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">呈</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>呈送；展示；赠送；发送；呈现</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">テイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">進呈</span><span class=\"kana\" lang=\"ja\">しんてい</span><span class=\"k-wz\">呈献；赠送；奉献</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">疎</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>疏远；稀疏；粗疏；避开；疏漏</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソ・ショ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">うと.い・うと.む・まば.ら</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">疎か</span><span class=\"kana\" lang=\"ja\">おろそか</span><span class=\"k-wz\">疏忽；疏漏；粗心；懈怠</span></li><li><span class=\"k-w\" lang=\"ja\">過疎</span><span class=\"kana\" lang=\"ja\">かそ</span><span class=\"k-wz\">人口稀少；人口密度低；人口减少</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">仰</div><div class=\"k-body\