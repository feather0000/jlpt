["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">娠</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>妊娠</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">妊娠</span><span class=\"kana\" lang=\"ja\">にんしん</span><span class=\"k-wz\">妊娠；怀孕；受孕</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">奉</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>奉献；进献；供奉；遵守</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ホウ・ブ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たてまつ.る・まつ.る・ほう.ずる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">奉る</span><span class=\"kana\" lang=\"ja\">たてまつる</span><span class=\"k-wz\">奉献；呈献；献上；拥立；奉戴；敬而远之；恭敬地做；谨……（谦让补助动词）</span></li><li><span class=\"k-w\" lang=\"ja\">奉仕</span><span class=\"kana\" lang=\"ja\">ほうし</span><span class=\"k-wz\">服侍；侍奉；服务；教堂工作；优惠销售；无偿提供服务</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">憂</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>忧郁；悲伤；忧虑；哀叹；不幸</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ユウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">うれ.える・うれ.い・う.い・う.き</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">憂鬱</span><span class=\"kana\" lang=\"ja\">ゆううつ</span><span class=\"k-wz\">抑郁；忧郁；沮丧；阴郁；消沉</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">朴</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>朴素；单纯；温顺；厚朴（树名）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ほう・ほお・えのき</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">素朴</span><span class=\"kana\" lang=\"ja\">そぼく</span><span class=\"k-wz\">朴素；自然；天真；不做作</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">亭</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>亭子；餐馆；宅邸；别墅；艺名</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">テイ・チン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">淳</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>淳朴；淳厚</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジュン・シュン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あつ.い</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">怪</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>可疑；怪异；幽灵</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カイ・ケ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あや.しい・あや.しむ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">怪我</span><span class=\"kana\" lang=\"ja\">けが</span><span class=\"k-wz\">伤害；伤口；错误；意外；损失</span></li><li><span class=\"k-w\" lang=\"ja\">怪しい</span><span class=\"kana\" lang=\"ja\">あやしい</span><span class=\"k-wz\">可疑的；值得怀疑的；不正当的；鬼鬼祟祟的；可疑的；不确定的；不太可能的；不可信的；不可靠的；笨拙的；别扭的；摇晃的；差劲的；奇怪的；古怪的；诡异的；令人不安的；不祥的；险恶的；危险的；不确定的；暧昧的；有暧昧嫌疑的；神秘的；迷人的；有魅力的；诱人的；令人陶醉的</span></li><li><span class=\"k-w\" lang=\"ja\">怪獣</span><span class=\"kana\" lang=\"ja\">かいじゅう</span><span class=\"k-wz\">怪兽；怪物</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">鳩</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>鸽子；聚集</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キュウ・ク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はと・あつ.める</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">酔</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>醉；陶醉；晕车；麻醉</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">スイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">よ.う・よ.い・よ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">酔う</span><span class=\"kana\" lang=\"ja\">よう</span><span class=\"k-wz\">醉；喝醉；酩酊；晕车；晕船；感到恶心；陶醉；欣喜若狂；心醉神迷</span></li><li><span class=\"k-w\" lang=\"ja\">酔っ払い</span><span class=\"kana\" lang=\"ja\">よっぱらい</span><span class=\"k-wz\">醉汉；酒鬼；醉酒；喝醉</span></li><li><span class=\"k-w\" lang=\"ja\">麻酔</span><span class=\"kana\" lang=\"ja\">ますい</span><span class=\"k-wz\">麻醉</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">惜</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>珍惜；吝惜；惋惜；舍不得；遗憾</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セキ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">お.しい・お.しむ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">惜しい</span><span class=\"kana\" lang=\"ja\">おしい</span><span class=\"k-wz\">遗憾的；可惜的；令人惋惜的；珍贵的；宝贵的；值得珍惜的；屈才的；大材小用的；好得不相称的；差点儿；险些；功亏一篑</span></li><li><span class=\"k-w\" lang=\"ja\">惜しむ</span><span class=\"kana\" lang=\"ja\">おしむ</span><span class=\"k-wz\">舍不得；吝惜；节省；小气；遗憾；惋惜；悔恨；不愿意；不甘心；珍视；重视；看重；爱惜；疼爱；珍爱</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">穫</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>收获；收割</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">収穫</span><span class=\"kana\" lang=\"ja\">しゅうかく</span><span class=\"k-wz\">收获；庄稼；收成；劳动成果；收益；结果；回报；捕获量；猎获量；渔获物</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">佳</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>优秀；美丽；良好；令人愉快；熟练</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">佳句</span><span class=\"kana\" lang=\"ja\">かく</span><span class=\"k-wz\">文学中的佳句；美妙的文学段落</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">潤</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>润湿；受惠；利益；恩惠；魅力</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジュン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">うるお.う・うるお.す・うる.む</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">潤う</span><span class=\"kana\" lang=\"ja\">うるおう</span><span class=\"k-wz\">变得湿润；被润湿；变得潮湿；受湿；获利；受益；变得繁荣；兴旺；致富；（心灵）得到滋润；（精神）得到充实</span></li><li><span class=\"k-w\" lang=\"ja\">利潤</span><span class=\"kana\" lang=\"ja\">りじゅん</span><span class=\"k-wz\">利润；收益</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">悼</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>哀悼；悼念</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いた.む</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">乏</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>匮乏；稀少；有限</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">とぼ.しい・とも.しい</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">窮乏</span><span class=\"kana\" lang=\"ja\">きゅうぼう</span><span class=\"k-wz\">贫困；赤贫；穷乏；贫穷</span></li><li><span class=\"k-w\" lang=\"ja\">欠乏</span><span class=\"kana\" lang=\"ja\">けつぼう</span><span class=\"k-wz\">缺乏；不足；短缺；匮乏</span></li><li><span class=\"k-w\" lang=\"ja\">貧乏</span><span class=\"kana\" lang=\"ja\">びんぼう</span><span class=\"k-wz\">贫穷；赤贫；贫困；拮据</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">該</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>该；上述；该特定</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ガイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">該当</span><span class=\"kana\" lang=\"ja\">がいとう</span><span class=\"k-wz\">相当于；适用于；符合；属于；满足（条件）；达到（要求）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">赴</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>前往；趋向；变成</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">フ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おもむ.く</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">赴く</span><span class=\"kana\" lang=\"ja\">おもむく</span><span class=\"k-wz\">前往；朝向；按照...进行；变成；面临；遵守；同意；服从</span></li><li><span class=\"k-w\" lang=\"ja\">赴任</span><span class=\"kana\" lang=\"ja\">ふにん</span><span class=\"k-wz\">赴任；就任；赴新职</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">桑</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>桑树</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">くわ</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">桂</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>连香树；肉桂；月桂</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かつら</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">髄</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>骨髓；髓；精华</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ズイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">虎</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>老虎；醉汉</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">コ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">とら</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">虎</span><span class=\"kana\" lang=\"ja\">とら</span><span class=\"k-wz\">虎；老虎；酒鬼；醉汉；酗酒者</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">盆</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>托盘；盆（容器）；盂兰盆节</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">盆</span><span class=\"kana\" lang=\"ja\">ぼん</span><span class=\"k-wz\">盘；托盘；家；户；家庭；盂兰盆节；盂兰盆会；中元节；赌窝；赌场</span></li><li><span class=\"k-w\" lang=\"ja\">盆地</span><span class=\"kana\" lang=\"ja\">ぼんち</span><span class=\"k-wz\">盆地；（山间等的）盆状地形</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">晋</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>前