["<li class=\"kcard\" data-id=\"n1:k:概\"><div class=\"k-ch\" lang=\"ja\">概</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>概</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ガイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おおむ（ね）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">概念</span><span class=\"kana\" lang=\"ja\">がいねん</span><span class=\"k-wz\">概念</span></li><li><span class=\"k-w\" lang=\"ja\">概要</span><span class=\"kana\" lang=\"ja\">がいよう</span><span class=\"k-wz\">概要</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:趣\"><div class=\"k-ch\" lang=\"ja\">趣</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>趣</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シュ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おもむき</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">趣旨</span><span class=\"kana\" lang=\"ja\">しゅし</span><span class=\"k-wz\">宗旨；主旨</span></li><li><span class=\"k-w\" lang=\"ja\">趣</span><span class=\"kana\" lang=\"ja\">おもむき</span><span class=\"k-wz\">情趣；韵味</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:緯\"><div class=\"k-ch\" lang=\"ja\">緯</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>纬</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">イ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">—</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">経緯</span><span class=\"kana\" lang=\"ja\">けいい</span><span class=\"k-wz\">原委；经过</span></li><li><span class=\"k-w\" lang=\"ja\">緯度</span><span class=\"kana\" lang=\"ja\">いど</span><span class=\"k-wz\">纬度</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:拠\"><div class=\"k-ch\" lang=\"ja\">拠</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>据</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キョ・コ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">よ（る）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">根拠</span><span class=\"kana\" lang=\"ja\">こんきょ</span><span class=\"k-wz\">根据</span></li><li><span class=\"k-w\" lang=\"ja\">証拠</span><span class=\"kana\" lang=\"ja\">しょうこ</span><span class=\"k-wz\">证据</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:衰\"><div class=\"k-ch\" lang=\"ja\">衰</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>衰</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">スイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おとろ（える）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">衰える</span><span class=\"kana\" lang=\"ja\">おとろえる</span><span class=\"k-wz\">衰弱；衰退（动词）</span></li><li><span class=\"k-w\" lang=\"ja\">衰退</span><span class=\"kana\" lang=\"ja\">すいたい</span><span class=\"k-wz\">衰退（名词）</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:懸\"><div class=\"k-ch\" lang=\"ja\">懸</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>悬</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケン・ケ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">か（ける）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">懸念</span><span class=\"kana\" lang=\"ja\">けねん</span><span class=\"k-wz\">担忧</span></li><li><span class=\"k-w\" lang=\"ja\">懸命</span><span class=\"kana\" lang=\"ja\">けんめい</span><span class=\"k-wz\">拼命</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:兆\"><div class=\"k-ch\" lang=\"ja\">兆</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>兆；征兆</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">チョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">きざ（し）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">兆し</span><span class=\"kana\" lang=\"ja\">きざし</span><span class=\"k-wz\">征兆；苗头</span></li><li><span class=\"k-w\" lang=\"ja\">前兆</span><span class=\"kana\" lang=\"ja\">ぜんちょう</span><span class=\"k-wz\">前兆</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:妥\"><div class=\"k-ch\" lang=\"ja\">妥</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>妥</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ダ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">—</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">妥協</span><span class=\"kana\" lang=\"ja\">だきょう</span><span class=\"k-wz\">妥协</span></li><li><span class=\"k-w\" lang=\"ja\">妥当</span><span class=\"kana\" lang=\"ja\">だとう</span><span class=\"k-wz\">妥当</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:弊\"><div class=\"k-ch\" lang=\"ja\">弊</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>弊</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヘイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">—</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">弊害</span><span class=\"kana\" lang=\"ja\">へいがい</span><span class=\"k-wz\">弊病；危害</span></li><li><span class=\"k-w\" lang=\"ja\">弊社</span><span class=\"kana\" lang=\"ja\">へいしゃ</span><span class=\"k-wz\">敝公司</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:踏\"><div class=\"k-ch\" lang=\"ja\">踏</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>踏</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ふ（む）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">踏まえる</span><span class=\"kana\" lang=\"ja\">ふまえる</span><span class=\"k-wz\">根据；立足于</span></li><li><span class=\"k-w\" lang=\"ja\">踏襲</span><span class=\"kana\" lang=\"ja\">とうしゅう</span><span class=\"k-wz\">沿袭</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:携\"><div class=\"k-ch\" lang=\"ja\">携</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>携</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たずさ（わる）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">携帯</span><span class=\"kana\" lang=\"ja\">けいたい</span><span class=\"k-wz\">携带；手机</span></li><li><span class=\"k-w\" lang=\"ja\">提携</span><span class=\"kana\" lang=\"ja\">ていけい</span><span class=\"k-wz\">合作</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:覆\"><div class=\"k-ch\" lang=\"ja\">覆</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>覆</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">フク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おお（う）・くつがえ（す）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">覆う</span><span class=\"kana\" lang=\"ja\">おおう</span><span class=\"k-wz\">覆盖</span></li><li><span class=\"k-w\" lang=\"ja\">覆面</span><span class=\"kana\" lang=\"ja\">ふくめん</span><span class=\"k-wz\">蒙面</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:促\"><div class=\"k-ch\" lang=\"ja\">促</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>促</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">うなが（す）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">促進</span><span class=\"kana\" lang=\"ja\">そくしん</span><span class=\"k-wz\">促进</span></li><li><span class=\"k-w\" lang=\"ja\">催促</span><span class=\"kana\" lang=\"ja\">さいそく</span><span class=\"k-wz\">催促</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:損\"><div class=\"k-ch\" lang=\"ja\">損</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>损</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">そこ（なう）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">損害</span><span class=\"kana\" lang=\"ja\">そんがい</span><span class=\"k-wz\">损害</span></li><li><span class=\"k-w\" lang=\"ja\">損失</span><span class=\"kana\" lang=\"ja\">そんしつ</span><span class=\"k-wz\">损失</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:免\"><div class=\"k-ch\" lang=\"ja\">免</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>免</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">メン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">まぬが（れる）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">免許</span><span class=\"kana\" lang=\"ja\">めんきょ</span><span class=\"k-wz\">执照</span></li><li><span class=\"k-w\" lang=\"ja\">免除</span><span class=\"kana\" lang=\"ja\">めんじょ</span><span class=\"k-wz\">免除</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:遂\"><div class=\"k-ch\" lang=\"ja\">遂</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>遂</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">スイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">と（げる）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">遂行</span><span class=\"kana\" lang=\"ja\">すいこう</span><span class=\"k-wz\">执行；完成</span></li><li><span class=\"k-w\" lang=\"ja\">未遂</span><span class=\"kana\" lang=\"ja\">みすい</span><span class=\"k-wz\">未遂</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:阻\"><div class=\"k-ch\" lang=\"ja\">阻</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>阻</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はば（む）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">阻止</span><span class=\"kana\" lang=\"ja\">そし</span><span class=\"k-wz\">阻止</span></li><li><span class=\"k-w\" lang=\"ja\">阻害</span><span class=\"kana\" lang=\"ja\">そがい</span><span class=\"k-wz\">阻碍</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:還\"><div class=\"k-ch\" lang=\"ja\">還</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>还</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">—</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">還元</span><span class=\"kana\" lang=\"ja\">かんげん</span><span class=\"k-wz\">回馈；还原</span></li><li><span class=\"k-w\" lang=\"ja\">返還</span><span class=\"kana\" lang=\"ja\">へんかん</span><span class=\"k-wz\">归还</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:顕\"><div class=\"k-ch\" lang=\"ja\">顕</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>显</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">—</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">顕著</span><span class=\"kana\" lang=\"ja\">けんちょ</span><span class=\"k-wz\">显著</span></li><li><span class=\"k-w\" lang=\"ja\">顕微鏡</span><span class=\"kana\" lang=\"ja\">けんびきょう</span><span class=\"k-wz\">显微镜</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n1:k:滑\"><div class=\"k-ch\" lang=\"ja\">滑</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>滑</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カツ・コツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">すべ（る）・なめ（らか）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">円滑</span><span class=\"kana\" lang=\"ja\">えんかつ</span><span class=\"k-wz\">顺利；圆滑</span></li><li><span class=\"k-w\" lang=\"ja\">滑らか</span><span class=\"kana\" lang=\"ja\">なめらか</span><span class=\"k-wz\">光滑；流畅</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">氏</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>氏族；姓氏</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">うじ・-うじ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">氏</span><span class=\"kana\" lang=\"ja\">うじ</span><span class=\"k-wz\">姓氏；血统；出身；氏族</span></li><li><span class=\"k-w\" lang=\"ja\">氏名</span><span class=\"kana\" lang=\"ja\">しめい</span><span class=\"k-wz\">姓名；身份</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">統</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>统治；统括；整体；关系</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">す.べる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">伝統</span><span class=\"kana\" lang=\"ja\">でんとう</span><span class=\"k-wz\">传统；惯例</span></li><li><span class=\"k-w\" lang=\"ja\">大統領</span><span class=\"kana\" lang=\"ja\">だいとうりょう</span><span class=\"k-wz\">（国家的）总统；大人物；老大；老兄</span></li><li><span class=\"k-w\" lang=\"ja\">系統</span><span class=\"kana\" lang=\"ja\">けいとう</span><span class=\"k-wz\">系统；血统；世系；家系；（颜色的）色系；（语言的）语系；派别；学派；（进化上的）近缘关系；（遗传学）有共同祖先的群体；品系；菌株</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">保</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>保护；保持；维持；保证；支持</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ホ・ホウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たも.つ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">保証</span><span class=\"kana\" lang=\"ja\">ほしょう</span><span class=\"k-wz\">保证；担保；保障；保修；质保</span></li><li><span class=\"k-w\" lang=\"ja\">保存</span><span class=\"kana\" lang=\"ja\">ほぞん</span><span class=\"k-wz\">保存；保留；储存；维护；（计算机）保存文件；存盘</span></li><li><span class=\"k-w\" lang=\"ja\">保健</span><span class=\"kana\" lang=\"ja\">ほけん</span><span class=\"k-wz\">健康保护；卫生；保健；健康教育</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">第</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>序号；住宅</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ダイ・テイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">次第</span><span class=\"kana\" lang=\"ja\">しだい</span><span class=\"k-wz\">取决于；根据；一……就……；……后立即；按照；无论什么；顺序；程序；次序；情况；经过；事态；原因；理由</span></li><li><span class=\"k-w\" lang=\"ja\">落第</span><span class=\"kana\" lang=\"ja\">らくだい</span><span class=\"k-wz\">考试不及格；留级；未达到标准；不符合要求</span></li><li><span class=\"k-w\" lang=\"ja\">第</span><span class=\"kana\" lang=\"ja\">だい</span><span class=\"k-wz\">序数词前缀</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">派</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>派系；派遣；学派；宗派；集团</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ハ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">派手</span><span class=\"kana\" lang=\"ja\">はで</span><span class=\"k-wz\">艳丽；显眼；华丽；俗气</span></li><li><span class=\"k-w\" lang=\"ja\">派</span><span class=\"kana\" lang=\"ja\">は</span><span class=\"k-wz\">派系；集团；小团体；帮派；（政治）派系；派别；阵营；学派；流派；画派；宗派；教派；教团</span></li><li><span class=\"k-w\" lang=\"ja\">特派</span><span class=\"kana\" lang=\"ja\">とくは</span><span class=\"k-wz\">派遣；特派；特别派遣</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">案</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>计划；提案；草案；担忧；桌子</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">アン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つくえ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">案内</span><span class=\"kana\" lang=\"ja\">あんない</span><span class=\"k-wz\">引导；带路；指引；信息；通知；告知；来访通报；通报访客到来；邀请；邀约；相识；了解；知晓</span></li><li><span class=\"k-w\" lang=\"ja\">案</span><span class=\"kana\" lang=\"ja\">あん</span><span class=\"k-wz\">主意；计划；提案；建议；议案；草稿；初稿；预期；期望；书桌；台架</span></li><li><span class=\"k-w\" lang=\"ja\">提案</span><span class=\"kana\" lang=\"ja\">ていあん</span><span class=\"k-wz\">提案；建议；议案</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">策</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>计划；方案；政策；策略；手段</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">サク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">対策</span><span class=\"kana\" lang=\"ja\">たいさく</span><span class=\"k-wz\">措施；步骤；对策；应对方案；反制措施；策略；备考准备</span></li><li><span class=\"k-w\" lang=\"ja\">策</span><span class=\"kana\" lang=\"ja\">さく</span><span class=\"k-wz\">计划；政策；手段；措施；策略；方案；永字八法第五法；右上挑</span></li><li><span class=\"k-w\" lang=\"ja\">政策</span><span class=\"kana\" lang=\"ja\">せいさく</span><span class=\"k-wz\">政策；政治措施</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">基</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../../n1/kanji/\">N1</a>基础；根本；（化学）基；（机器量词）台</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">もと・もとい</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">基</span><span class=\"kana\" lang=\"ja\">もと</span><span class=\"k-wz\">起源；源头；开端；基础；基底；根基；根本；原因；起因；（原）材料；原料；配料；底料（如蛋糕用）；高汤；己方；自己一边；本金；本钱；成本价；（植物的）根；（树的）主干；（笔、筷子等的）握持部分；柄部；和歌的前三句；（植物或树木的计数单位）株；棵；（鹰猎中鹰的计数单位）只</span></li><li><spa