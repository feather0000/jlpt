["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">初</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>初</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はじ（め）・はつ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">最初</span><span class=\"kana\" lang=\"ja\">さいしょ</span><span class=\"k-wz\">最初</span></li><li><span class=\"k-w\" lang=\"ja\">初めて</span><span class=\"kana\" lang=\"ja\">はじめて</span><span class=\"k-wz\">第一次</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">伝</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>传</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">デン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つた（える）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">伝言</span><span class=\"kana\" lang=\"ja\">でんごん</span><span class=\"k-wz\">留言；口信</span></li><li><span class=\"k-w\" lang=\"ja\">手伝う</span><span class=\"kana\" lang=\"ja\">てつだう</span><span class=\"k-wz\">帮忙</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">連</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>连</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">レン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つ（れる）・つら（なる）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">連絡</span><span class=\"kana\" lang=\"ja\">れんらく</span><span class=\"k-wz\">联系</span></li><li><span class=\"k-w\" lang=\"ja\">連れる</span><span class=\"kana\" lang=\"ja\">つれる</span><span class=\"k-wz\">带（人）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">確</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>确</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たし（か）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">確認</span><span class=\"kana\" lang=\"ja\">かくにん</span><span class=\"k-wz\">确认</span></li><li><span class=\"k-w\" lang=\"ja\">確か</span><span class=\"kana\" lang=\"ja\">たしか</span><span class=\"k-wz\">确实；大概</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">認</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>认</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ニン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">みと（める）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">認める</span><span class=\"kana\" lang=\"ja\">みとめる</span><span class=\"k-wz\">承认；认可</span></li><li><span class=\"k-w\" lang=\"ja\">承認</span><span class=\"kana\" lang=\"ja\">しょうにん</span><span class=\"k-wz\">批准</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">政</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>政治；政务；政事</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セイ・ショウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">まつりごと・まん</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">政治</span><span class=\"kana\" lang=\"ja\">せいじ</span><span class=\"k-wz\">政治；政务</span></li><li><span class=\"k-w\" lang=\"ja\">政府</span><span class=\"kana\" lang=\"ja\">せいふ</span><span class=\"k-wz\">政府；行政；内阁</span></li><li><span class=\"k-w\" lang=\"ja\">政党</span><span class=\"kana\" lang=\"ja\">せいとう</span><span class=\"k-wz\">政党</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">議</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>审议；协商；讨论；考虑</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ギ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">会議</span><span class=\"kana\" lang=\"ja\">かいぎ</span><span class=\"k-wz\">会议；集会；大会；理事会；代表大会；国会</span></li><li><span class=\"k-w\" lang=\"ja\">会議室</span><span class=\"kana\" lang=\"ja\">かいぎしつ</span><span class=\"k-wz\">会议室</span></li><li><span class=\"k-w\" lang=\"ja\">議員</span><span class=\"kana\" lang=\"ja\">ぎいん</span><span class=\"k-wz\">议员；议会成员；国会议员</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">民</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>人民；国民；臣民</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ミン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たみ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">市民</span><span class=\"kana\" lang=\"ja\">しみん</span><span class=\"k-wz\">国民；公民；市民；城市居民；镇民；资产阶级；中产阶级</span></li><li><span class=\"k-w\" lang=\"ja\">国民</span><span class=\"kana\" lang=\"ja\">こくみん</span><span class=\"k-wz\">国民；人民；公民；国民民主党</span></li><li><span class=\"k-w\" lang=\"ja\">住民</span><span class=\"kana\" lang=\"ja\">じゅうみん</span><span class=\"k-wz\">居民；住户；市民；人口</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">対</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>相对；对立；对比；对方；相等</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">タイ・ツイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あいて・こた.える・そろ.い・つれあ.い・なら.ぶ・むか.う</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">反対</span><span class=\"kana\" lang=\"ja\">はんたい</span><span class=\"k-wz\">反对；抵抗；对抗；敌意；异议；反对意见；反面；相反；反向；相对</span></li><li><span class=\"k-w\" lang=\"ja\">対</span><span class=\"kana\" lang=\"ja\">たい</span><span class=\"k-wz\">对；对阵；对抗；对；比（如4比2的比分、3比1的比率）；向…；对…；与…；针对…；反；平等地位；对等立场；对面；相反；对立面</span></li><li><span class=\"k-w\" lang=\"ja\">絶対</span><span class=\"kana\" lang=\"ja\">ぜったい</span><span class=\"k-wz\">绝对地；一定；无条件地；绝对的；无条件的；确定无疑的；绝对性</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">部</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>部分；部门；份（报刊计数单位）；副本；类别</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ブ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">-べ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">全部</span><span class=\"kana\" lang=\"ja\">ぜんぶ</span><span class=\"k-wz\">全部；全；整个；总共</span></li><li><span class=\"k-w\" lang=\"ja\">部屋</span><span class=\"kana\" lang=\"ja\">へや</span><span class=\"k-wz\">房间；室；公寓；寓所；单间公寓；（相扑）部屋；相扑训练团体</span></li><li><span class=\"k-w\" lang=\"ja\">部長</span><span class=\"kana\" lang=\"ja\">ぶちょう</span><span class=\"k-wz\">部门主管；科长；课长；（学校社团）负责人；队长</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">合</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>符合；适合；结合；一致；合算</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ゴウ・ガッ・カッ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あ.う・-あ.う・あ.い・あい-・-あ.い・-あい・あ.わす・あ.わせる・-あ.わせる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">合う</span><span class=\"kana\" lang=\"ja\">あう</span><span class=\"k-wz\">聚合；汇合；联合；相遇；相符；匹配；适合；一致；正确；合算；公平合理；互相……；一起……</span></li><li><span class=\"k-w\" lang=\"ja\">具合</span><span class=\"kana\" lang=\"ja\">ぐあい</span><span class=\"k-wz\">状况；状态；健康；健康状况；方式；方法；样子；情况；运气；际遇；面子；体面；得体；礼仪</span></li><li><span class=\"k-w\" lang=\"ja\">試合</span><span class=\"kana\" lang=\"ja\">しあい</span><span class=\"k-wz\">比赛；竞赛；对局</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">市</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>市场；城市；城镇</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いち</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">市</span><span class=\"kana\" lang=\"ja\">し</span><span class=\"k-wz\">市；城市</span></li><li><span class=\"k-w\" lang=\"ja\">市民</span><span class=\"kana\" lang=\"ja\">しみん</span><span class=\"k-wz\">国民；公民；市民；城市居民；镇民；资产阶级；中产阶级</span></li><li><span class=\"k-w\" lang=\"ja\">市場</span><span class=\"kana\" lang=\"ja\">いちば</span><span class=\"k-wz\">(城镇)市场；街市；集市</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">内</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>内部；之间；家里；当中；内</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ナイ・ダイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">うち</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">案内</span><span class=\"kana\" lang=\"ja\">あんない</span><span class=\"k-wz\">引导；带路；指引；信息；通知；告知；来访通报；通报访客到来；邀请；邀约；相识；了解；知晓</span></li><li><span class=\"k-w\" lang=\"ja\">以内</span><span class=\"kana\" lang=\"ja\">いない</span><span class=\"k-wz\">以内；范围内；少于</span></li><li><span class=\"k-w\" lang=\"ja\">家内</span><span class=\"kana\" lang=\"ja\">かない</span><span class=\"k-wz\">（我的）妻子；太太；家里；家庭；家人</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">相</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>相互；共同；大臣；相貌；相位</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソウ・ショウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あい-</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">相談</span><span class=\"kana\" lang=\"ja\">そうだん</span><span class=\"k-wz\">商议；协商；咨询；请教</span></li><li><span class=\"k-w\" lang=\"ja\">相手</span><span class=\"kana\" lang=\"ja\">あいて</span><span class=\"k-wz\">同伴；伙伴；搭档；对方；对手方；收信人；对手；竞争对手</span></li><li><span class=\"k-w\" lang=\"ja\">首相</span><span class=\"kana\" lang=\"ja\">しゅしょう</span><span class=\"k-wz\">首相；总理；（德国、奥地利等国的）总理</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">定</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>决定；确定；规定；安定；稳定</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">テイ・ジョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さだ.める・さだ.まる・さだ.か</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">予定</span><span class=\"kana\" lang=\"ja\">よてい</span><span class=\"k-wz\">预定；安排</span></li><li><span class=\"k-w\" lang=\"ja\">安定</span><span class=\"kana\" lang=\"ja\">あんてい</span><span class=\"k-wz\">稳定；稳固；一致；平衡；均衡；镇定；（物理、化学）稳定的；处于稳态的</span></li><li><span class=\"k-w\" lang=\"ja\">勘定</span><span class=\"kana\" lang=\"ja\">かんじょう</span><span class=\"k-wz\">计算；计数；核算；账单；账目；结账；付款；体谅；照顾；考虑</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">回</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>旋转；次（次数单位）；圈（环绕一周）；回合（比赛等）；环绕</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カイ・エ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">まわ.る・-まわ.る・-まわ.り・まわ.す・-まわ.す・まわ.し-・-まわ.し・もとお.る・か.える</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">回る</span><span class=\"kana\" lang=\"ja\">まわる</span><span class=\"k-wz\">转动；旋转；自转；环绕；绕行；公转；围绕轨道运行；巡回；串门；周游；巡视；巡逻；经由；顺路去；顺便到；绕道；绕远路；转到（别处、另一位置）；绕到；倒向（对方）；轮到；依次传递；运转；正常工作；蔓延；扩展到；波及；达到；（酒精、毒物等）发生作用；过（某时刻）；（时针）过了（五点等）；产生利息；赚取利息；（接动词连用形）到处……；四处……；来回……</span></li><li><span class=\"k-w\" lang=\"ja\">回</span><span class=\"kana\" lang=\"ja\">かい</span><span class=\"k-wz\">次；回；次；一次；一回；局；轮；场；集；章；回；回族；伊斯兰教</span></li><li><span class=\"k-w\" lang=\"ja\">回復</span><span class=\"kana\" lang=\"ja\">かいふく</span><span class=\"k-wz\">恢复；复原；康复；回复；改善；（病后）恢复；痊愈；康复</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">選</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>选择；挑选；选举；选取；偏好</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">えら.ぶ・え.る・よ.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">選ぶ</span><span class=\"kana\" lang=\"ja\">