["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">優</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>优秀；温柔；胜过；演员；卓越</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ユウ・ウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">やさ.しい・すぐ.れる・まさ.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">優しい</span><span class=\"kana\" lang=\"ja\">やさしい</span><span class=\"k-wz\">温柔；温和；温情；柔和；体贴</span></li><li><span class=\"k-w\" lang=\"ja\">女優</span><span class=\"kana\" lang=\"ja\">じょゆう</span><span class=\"k-wz\">女演员</span></li><li><span class=\"k-w\" lang=\"ja\">俳優</span><span class=\"kana\" lang=\"ja\">はいゆう</span><span class=\"k-wz\">演员；表演者</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">夫</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>丈夫；男人</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">フ・フウ・ブ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おっと・それ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">丈夫</span><span class=\"kana\" lang=\"ja\">じょうふ</span><span class=\"k-wz\">英雄；男子汉；勇士</span></li><li><span class=\"k-w\" lang=\"ja\">大丈夫</span><span class=\"kana\" lang=\"ja\">だいじょうぶ</span><span class=\"k-wz\">安全；牢靠；稳妥；无虑；没问题；没关系；确实；必然；无疑；不用了；谢了；算了；大丈夫；堂堂正正的男子汉</span></li><li><span class=\"k-w\" lang=\"ja\">夫</span><span class=\"kana\" lang=\"ja\">おっと</span><span class=\"k-wz\">丈夫</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">収</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>收入；收纳；获得；收获；回收</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おさ.める・おさ.まる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">吸収</span><span class=\"kana\" lang=\"ja\">きゅうしゅう</span><span class=\"k-wz\">吸收；吸取；吸引</span></li><li><span class=\"k-w\" lang=\"ja\">収穫</span><span class=\"kana\" lang=\"ja\">しゅうかく</span><span class=\"k-wz\">收获；庄稼；收成；劳动成果；收益；结果；回报；捕获量；猎获量；渔获物</span></li><li><span class=\"k-w\" lang=\"ja\">収入</span><span class=\"kana\" lang=\"ja\">しゅうにゅう</span><span class=\"k-wz\">收入；所得；收益；进款</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">断</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>切断；拒绝；决定；禁止；道歉</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ダン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">た.つ・ことわ.る・さだ.める</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">横断</span><span class=\"kana\" lang=\"ja\">おうだん</span><span class=\"k-wz\">横穿；穿过；横贯；相交；横断；横越；横渡；飞越；航越；横截；横切；横向切断</span></li><li><span class=\"k-w\" lang=\"ja\">断る</span><span class=\"kana\" lang=\"ja\">ことわる</span><span class=\"k-wz\">拒绝</span></li><li><span class=\"k-w\" lang=\"ja\">判断</span><span class=\"kana\" lang=\"ja\">はんだん</span><span class=\"k-wz\">判断</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">石</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>石头；宝石；岩石；矿石；石制</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セキ・シャク・コク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いし</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">石</span><span class=\"kana\" lang=\"ja\">いし</span><span class=\"k-wz\">石头；岩石；卵石；宝石；珠宝；打火石；棋子；围棋子；黑白棋子；结石；（膀胱、肾脏等的）结石</span></li><li><span class=\"k-w\" lang=\"ja\">石炭</span><span class=\"kana\" lang=\"ja\">せきたん</span><span class=\"k-wz\">煤炭</span></li><li><span class=\"k-w\" lang=\"ja\">石油</span><span class=\"kana\" lang=\"ja\">せきゆ</span><span class=\"k-wz\">石油；原油；（口语）煤油；火油</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">違</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>差异；不同；不一致；违背；弄错</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">イ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ちが.う・ちが.い・ちが.える・-ちが.える・たが.う・たが.える</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">違う</span><span class=\"kana\" lang=\"ja\">ちがう</span><span class=\"k-wz\">不同；有区别；有差异；不一致；错误；不对；搞错了；异常；出问题；不是吗；不对吗</span></li><li><span class=\"k-w\" lang=\"ja\">間違える</span><span class=\"kana\" lang=\"ja\">まちがえる</span><span class=\"k-wz\">犯错；出错；弄错；做错；搞混；误认；混淆</span></li><li><span class=\"k-w\" lang=\"ja\">違反</span><span class=\"kana\" lang=\"ja\">いはん</span><span class=\"k-wz\">违反；违背；违规；违犯；侵犯；违抗</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">消</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>熄灭；消失；消除；取消；消费</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">き.える・け.す</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">消す</span><span class=\"kana\" lang=\"ja\">けす</span><span class=\"k-wz\">擦掉；划掉；删除；关闭；熄灭（灯、电视、暖气等）；扑灭；吹灭（火焰、蜡烛等）；除去；消除；解除（气味、疼痛等）；中和（毒素）；淹没；减弱；吸收；压低（声音）；杀死；谋杀；除掉</span></li><li><span class=\"k-w\" lang=\"ja\">消える</span><span class=\"kana\" lang=\"ja\">きえる</span><span class=\"k-wz\">消失；消散；不见；消失无踪；熄灭；（灯火等）灭掉；（电视屏幕等）关闭；（感情、印象等）褪去；消散；（如希望）消失；（气味、痒感、睡意等）消散；消失；（脚步声等）淡去；（铭文等）磨损；磨灭；（文字）擦去；（墨迹等）褪色；（传统等）失传；消亡；消失</span></li><li><span class=\"k-w\" lang=\"ja\">消しゴム</span><span class=\"kana\" lang=\"ja\">けしゴム</span><span class=\"k-wz\">橡皮擦；橡皮</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">神</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>神；灵魂；精神</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シン・ジン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かみ・かん-・こう-</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">神社</span><span class=\"kana\" lang=\"ja\">じんじゃ</span><span class=\"k-wz\">神社；神道神社</span></li><li><span class=\"k-w\" lang=\"ja\">神</span><span class=\"kana\" lang=\"ja\">かみ</span><span class=\"k-wz\">神；神灵；神明；精灵；神级；超凡；了不起；惊人；天皇；雷</span></li><li><span class=\"k-w\" lang=\"ja\">神経</span><span class=\"kana\" lang=\"ja\">しんけい</span><span class=\"k-wz\">神经；神经；敏感性</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">番</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>顺序；轮次；编号</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">バン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つが.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">交番</span><span class=\"kana\" lang=\"ja\">こうばん</span><span class=\"k-wz\">派出所；交替；轮换；交替的；交变的</span></li><li><span class=\"k-w\" lang=\"ja\">番号</span><span class=\"kana\" lang=\"ja\">ばんごう</span><span class=\"k-wz\">号码；数字序列</span></li><li><span class=\"k-w\" lang=\"ja\">番組</span><span class=\"kana\" lang=\"ja\">ばんぐみ</