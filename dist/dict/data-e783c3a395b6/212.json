"<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">判</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../n2/kanji/\">N2</a>判</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ハン・バン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">—</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">判断</span><span class=\"kana\" lang=\"ja\">はんだん</span><span class=\"k-wz\">判断</span></li><li><span class=\"k-w\" lang=\"ja\">評判</span><span class=\"kana\" lang=\"ja\">ひょうばん</span><span class=\"k-wz\">评价；名声</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">削</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../n2/kanji/\">N2</a>削</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">サク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">けず（る）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">削減</span><span class=\"kana\" lang=\"ja\">さくげん</span><span class=\"k-wz\">削减</span></li><li><span class=\"k-w\" lang=\"ja\">削る</span><span class=\"kana\" lang=\"ja\">けずる</span><span class=\"k-wz\">削；削减</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">柔</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../n2/kanji/\">N2</a>柔</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジュウ・ニュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">やわ（らかい）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">柔軟</span><span class=\"kana\" lang=\"ja\">じゅうなん</span><span class=\"k-wz\">灵活；柔软</span></li><li><span class=\"k-w\" lang=\"ja\">柔らかい</span><span class=\"kana\" lang=\"ja\">やわらかい</span><span class=\"k-wz\">柔软的</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">抱</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../n2/kanji/\">N2</a>抱</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ホウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">だ（く）・かか（える）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">抱える</span><span class=\"kana\" lang=\"ja\">かかえる</span><span class=\"k-wz\">抱着；承担（问题）</span></li><li><span class=\"k-w\" lang=\"ja\">抱く</span><span class=\"kana\" lang=\"ja\">だく</span><span class=\"k-wz\">抱</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">即</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../n2/kanji/\">N2</a>即</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">すなわ（ち）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">即座に</span><span class=\"kana\" lang=\"ja\">そくざに</span><span class=\"k-wz\">立刻</span></li><li><span class=\"k-w\" lang=\"ja\">即日</span><span class=\"kana\" lang=\"ja\">そくじつ</span><span class=\"k-wz\">当天</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">徹</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../n2/kanji/\">N2</a>彻</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">テツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">—</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">徹底</span><span class=\"kana\" lang=\"ja\">てってい</span><span class=\"k-wz\">彻底</span></li><li><span class=\"k-w\" lang=\"ja\">徹夜</span><span class=\"kana\" lang=\"ja\">てつや</span><span class=\"k-wz\">通宵</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">党</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../n2/kanji/\">N2</a>党派；派系；集团</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">なかま・むら</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">党</span><span class=\"kana\" lang=\"ja\">とう</span><span class=\"k-wz\">政党；党派；爱好者；迷</span></li><li><span class=\"k-w\" lang=\"ja\">政党</span><span class=\"kana\" lang=\"ja\">せいとう</span><span class=\"k-wz\">政党</span></li><li><span class=\"k-w\" lang=\"ja\">野党</span><span class=\"kana\" lang=\"ja\">やとう</span><span class=\"k-wz\">反对党；在野党</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">協</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../n2/kanji/\">N2</a>共同；协作</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">協力</span><span class=\"kana\" lang=\"ja\">きょうりょく</span><span class=\"k-wz\">合作；协力；帮助；支持</span></li><li><span class=\"k-w\" lang=\"ja\">協会</span><span class=\"kana\" lang=\"ja\">きょうかい</span><span class=\"k-wz\">协会；社团；组织</span></li><li><span class=\"k-w\" lang=\"ja\">協議</span><span class=\"kana\" lang=\"ja\">きょうぎ</span><span class=\"k-wz\">协商；会议；讨论；谈判</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">総</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../n2/kanji/\">N2</a>全部；总计；总括；总领</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">す.べて・すべ.て・ふさ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">総理大臣</span><span class=\"kana\" lang=\"ja\">そうりだいじん</span><span class=\"k-wz\">总理大臣；首相；总理</span></li><li><span class=\"k-w\" lang=\"ja\">総</span><span class=\"kana\" lang=\"ja\">そう</span><span class=\"k-wz\">全；总；总计；整体；全面（如总选举、总经理）</span></li><li><span class=\"k-w\" lang=\"ja\">総会</span><span class=\"kana\" lang=\"ja\">そうかい</span><span class=\"k-wz\">总会；大会</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">区</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../n2/kanji/\">N2</a>区；地区</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ク・オウ・コウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">区別</span><span class=\"kana\" lang=\"ja\">くべつ</span><span class=\"k-wz\">区别；区分；辨别；差异</span></li><li><span class=\"k-w\" lang=\"ja\">地区</span><span class=\"kana\" lang=\"ja\">ちく</span><span class=\"k-wz\">地区；地带；地域；区域</span></li><li><span class=\"k-w\" lang=\"ja\">区域</span><span class=\"kana\" lang=\"ja\">くいき</span><span class=\"k-wz\">区域；地带；地区；范围；界限；边界</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">領</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../n2/kanji/\">N2</a>领土；领地；管辖；支配；衣领</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">リョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">えり</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">大統領</span><span class=\"kana\" lang=\"ja\">だいとうりょう</span><span class=\"k-wz\">（国家的）总统；大人物；老大；老兄</span></li><li><span class=\"k-w\" lang=\"ja\">要領</span><span class=\"kana\" lang=\"ja\">ようりょう</span><span class=\"k-wz\">要点；要旨；要领；纲要；诀窍；技巧；门道</span></li><li><span class=\"k-w\" lang=\"ja\">領事</span><span class=\"kana\" lang=\"ja\">りょうじ</span><span class=\"k-wz\">领事</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">県</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../n2/kanji/\">N2</a>县（行政区划）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">か.ける</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">県</span><span class=\"kana\" lang=\"ja\">けん</span><span class=\"k-wz\">（日本的）县；（中国大陆、台湾、挪威等的）县；（法国的）省；（意大利、西班牙等的）省</span></li><li><span class=\"k-w\" lang=\"ja\">県庁</span><span class=\"kana\" lang=\"ja\">けんちょう</span><span class=\"k-wz\">县政府；县厅</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">設</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../n2/kanji/\">N2</a>设立；设置；准备；提供</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">もう.ける</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">建設</span><span class=\"kana\" lang=\"ja\">けんせつ</span><span class=\"k-wz\">建设；建立</span></li><li><span class=\"k-w\" lang=\"ja\">設計</span><span class=\"kana\" lang=\"ja\">せっけい</span><span class=\"k-wz\">计划；设计；布局</span></li><li><span class=\"k-w\" lang=\"ja\">設備</span><span class=\"kana\" lang=\"ja\">せつび</span><span class=\"k-wz\">设备；设施；装置；配套设施；便利设施</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">改</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../n2/kanji/\">N2</a>修改；改正；革新；检查；更新</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あらた.める・あらた.まる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">改善</span><span class=\"kana\" lang=\"ja\">かいぜん</span><span class=\"k-wz\">改善；改进；改良；改善（日本企业持续改进的经营理念）</span></li><li><span class=\"k-w\" lang=\"ja\">改札</span><span class=\"kana\" lang=\"ja\">かいさつ</span><span class=\"k-wz\">检票；查票；检票口；检票闸口</span></li><li><span class=\"k-w\" lang=\"ja\">改正</span><span class=\"kana\" lang=\"ja\">かいせい</span><span class=\"k-wz\">修订；修正；修改</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">府</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../n2/kanji/\">N2</a>都市府（日本行政区划）；政府机关；代表机构；仓库</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">フ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">政府</span><span class=\"kana\" lang=\"ja\">せいふ</span><span class=\"k-wz\">政府；行政；内阁</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">査</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../n2/kanji/\">N2</a>调查；检查；审查</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">サ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">検査</span><span class=\"kana\" lang=\"ja\">けんさ</span><span class=\"k-wz\">检查；检验；考查；扫描；审计</span></li><li><span class=\"k-w\" lang=\"ja\">調査</span><span class=\"kana\" lang=\"ja\">ちょうさ</span><span class=\"k-wz\">调查；审查；询问；调查</span></li><li><span class=\"k-w\" lang=\"ja\">巡査</span><span class=\"kana\" lang=\"ja\">じゅんさ</span><span class=\"k-wz\">警察；警察官；巡警</span></li></ul></div></li>"]