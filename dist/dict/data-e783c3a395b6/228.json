["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">浦</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>海湾；海岸；水滨；小湾；入海口</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ホ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">うら</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">析</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>分析；分割；劈开；分解</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セキ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">分析</span><span class=\"kana\" lang=\"ja\">ぶんせき</span><span class=\"k-wz\">分析</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">譲</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>转让；让步；让出；谦让</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ゆず.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">譲る</span><span class=\"kana\" lang=\"ja\">ゆずる</span><span class=\"k-wz\">移交；转让；让与；过户；遗赠；让出（座位等）；让路；让步；退让；屈服；妥协；出售；售出；推迟；延期；延后</span></li><li><span class=\"k-w\" lang=\"ja\">譲歩</span><span class=\"kana\" lang=\"ja\">じょうほ</span><span class=\"k-wz\">让步；妥协；调和</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">称</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>称赞；称颂；名称；称号；称量</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たた.える・とな.える・あ.げる・かな.う・はか.り・はか.る・ほめ.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">名称</span><span class=\"kana\" lang=\"ja\">めいしょう</span><span class=\"k-wz\">名称；名字；标题</span></li><li><span class=\"k-w\" lang=\"ja\">称する</span><span class=\"kana\" lang=\"ja\">しょうする</span><span class=\"k-wz\">称呼；命名；自称；号称；声称；自称；假称；装作；称赞；赞美</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">納</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>收纳；支付；收获；供应；结算</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ノウ・ナッ・ナ・ナン・トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おさ.める・-おさ.める・おさ.まる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">納得</span><span class=\"kana\" lang=\"ja\">なっとく</span><span class=\"k-wz\">同意；赞成；接受；理解；信服；满意</span></li><li><span class=\"k-w\" lang=\"ja\">納める</span><span class=\"kana\" lang=\"ja\">おさめる</span><span class=\"k-wz\">放入；收藏；放回；保存；存放；恢复原位；收入；包含；刊登；收录；拍摄；取得；获得；获利；成功；赢得；获胜；缴纳；交付；供应；支付；接受；收下；保持在一定范围内；控制；供奉；奉献（给神社、神灵等）；献纳；制压；抑制；平定；镇压；结束；完成；终止；告一段落</span></li><li><span class=\"k-w\" lang=\"ja\">滞納</span><span class=\"kana\" lang=\"ja\">たいのう</span><span class=\"k-wz\">逾期未付；拖欠；欠缴；违约；滞纳</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">樹</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>树木；木材；建立；设置</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジュ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">き</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">樹木</span><span class=\"kana\" lang=\"ja\">じゅもく</span><span class=\"k-wz\">树木；树和灌木</span></li><li><span class=\"k-w\" lang=\"ja\">樹立</span><span class=\"kana\" lang=\"ja\">じゅりつ</span><span class=\"k-wz\">建立；创立；设立；创造（纪录）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">挑</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>挑战；竞争；调情</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">チョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いど.む</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">挑む</span><span class=\"kana\" lang=\"ja\">いどむ</span><span class=\"k-wz\">向……挑战；与……较量；争夺；应对（问题等）；尝试；争取（奖项、纪录等）；向（某人）求欢；对……施压要求性行为</span></li><li><span class=\"k-w\" lang=\"ja\">挑戦</span><span class=\"kana\" lang=\"ja\">ちょうせん</span><span class=\"k-wz\">挑战；对抗；尝试</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">誘</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>引诱；邀请；诱惑；招致；劝诱</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ユウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さそ.う・いざな.う</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">誘う</span><span class=\"kana\" lang=\"ja\">さそう</span><span class=\"k-wz\">邀请；招待；召集；带领；诱惑；引诱；勾引；吸引；引起；激发；唤起</span></li><li><span class=\"k-w\" lang=\"ja\">勧誘</span><span class=\"kana\" lang=\"ja\">かんゆう</span><span class=\"k-wz\">邀请；劝诱；游说；诱导；劝说；鼓励</span></li><li><span class=\"k-w\" lang=\"ja\">誘導</span><span class=\"kana\" lang=\"ja\">ゆうどう</span><span class=\"k-wz\">引导；诱导；导向；引入；煽动；劝诱</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">紛</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>纠纷；混乱；混淆；丢失；排遣</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">フン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">まぎ.れる・-まぎ.れ・まぎ.らす・まぎ.らわす・まぎ.らわしい</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">紛失</span><span class=\"kana\" lang=\"ja\">ふんしつ</span><span class=\"k-wz\">丢失；遗失；失踪</span></li><li><span class=\"k-w\" lang=\"ja\">紛争</span><span class=\"kana\" lang=\"ja\">ふんそう</span><span class=\"k-wz\">纠纷；冲突；争端；骚乱；不和</span></li><li><span class=\"k-w\" lang=\"ja\">紛れる</span><span class=\"kana\" lang=\"ja\">まぎれる</span><span class=\"k-wz\">消失在；混入；隐没于；趁乱进行；利用混乱；极为相似；难以分辨；容易混淆；转移；忘却；被吸引；沉溺于；专注于</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">至</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>到达；达到；导致；极至；来临</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いた.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">至る</span><span class=\"kana\" lang=\"ja\">いたる</span><span class=\"k-wz\">到达；达到；获得；通往；导向；抵达；（～に至っては）至于；说到；甚至（举极端情况）；来临；到来；导致</span></li><li><span class=\"k-w\" lang=\"ja\">至急</span><span class=\"kana\" lang=\"ja\">しきゅう</span><span class=\"k-wz\">紧急；急迫；即刻；迅速；特急；紧急地；迅速地；立即；马上；毫不延迟；尽快</span></li><li><span class=\"k-w\" lang=\"ja\">乃至</span><span class=\"kana\" lang=\"ja\">ないし</span><span class=\"k-wz\">从…到；…与…之间；或者；或</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">宗</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>宗教；宗派；宗旨；起源；本质</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シュウ・ソウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">むね</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">宗教</span><span class=\"kana\" lang=\"ja\">しゅうきょう</span><span class=\"k-wz\">宗教；宗教信仰；信仰；信念；教义；宗教活动</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">慎</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>谨慎；节制；谦逊；慎重</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つつし.む・つつ.ましい・つつし・つつし.み</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">慎重</span><span class=\"kana\" lang=\"ja\">しんちょう</span><span class=\"k-wz\">谨慎；小心谨慎；慎重；审慎</span></li><li><span class=\"k-w\" lang=\"ja\">慎む</span><span class=\"kana\" lang=\"ja\">つつしむ</span><span class=\"k-wz\">谨慎；小心；慎重；适度；节制；戒除；恭敬；虔诚；纯洁；清廉；贞洁</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">控</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>节制；克制；扣除；上诉；记录</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">コウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ひか.える・ひか.え</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">控除</span><span class=\"kana\" lang=\"ja\">こうじょ</span><span class=\"k-wz\">扣除；减除（如税款等）</span></li><li><span class=\"k-w\" lang=\"ja\">控室</span><span class=\"kana\" lang=\"ja\">ひかえしつ</span><span class=\"k-wz\">等候室；前厅；接待室；化妆间</span></li><li><span class=\"k-w\" lang=\"ja\">控える</span><span class=\"kana\" lang=\"ja\">ひかえる</span><span class=\"k-wz\">节制；克制；忍耐；自我约束；记下；抄录；记录（电话号码等）；做准备；等候；待机；即将来临；在即；近在咫尺；保持密切关系；充当幕后支持者</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">智</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>智慧；智力；理性</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">チ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">握</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>握；捏；攥；抓；握（制作寿司）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">アク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">にぎ.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">握手</span><span class=\"kana\" lang=\"ja\">あくしゅ</span><span class=\"k-wz\">握手；和解；携手合作；协力</span></li><li><span class=\"k-w\" lang=\"ja\">握る</span><span class=\"kana\" lang=\"ja\">にぎる</span><span class=\"k-wz\">握住；抓住；紧握；紧抓；掌握（答案）；握有（解决方案等）；是关键；是原因；夺取（权力）；掌握（缰绳）；支配；控制；捏制（握り寿司、饭团等）；用手塑形；按压成形；捏成</span></li><li><span class=\"k-w\" lang=\"ja\">把握</span><span class=\"kana\" lang=\"ja\">はあく</span><span class=\"k-wz\">掌握；把握</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">宙</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>空中；空间；天空；时间；记忆</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">チュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">宇宙</span><span class=\"kana\" lang=\"ja\">うちゅう</span><span class=\"k-wz\">宇宙；宇宙空间；太空</span></li><li><span class=\"k-w\" lang=\"ja\">宙返り</span><span class=\"kana\" lang=\"ja\">ちゅうがえり</span><span class=\"k-wz\">翻跟斗；空翻</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">俊</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>卓越；聪慧；杰出</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シュン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">銭</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>钱；硬币；货币；分（日元百分之一）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セン・ゼン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ぜに・すき</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">金銭</span><span class=\"kana\" lang=\"ja\">きんせん</span><span class=\"k-wz\">金钱；现金</span></li><li><span class=\"k-w\" lang=\"ja\">小銭</span><span class=\"kana\" lang=\"ja\">こぜに</span><span class=\"k-wz\">零钱；硬币；小额金钱；小笔钱款</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">渋</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>涩味；犹豫；不情愿；腹泻</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジュウ・シュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">しぶ・しぶ.い・しぶ.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">渋滞</span><span class=\"kana\" lang=\"ja\">じゅうたい</span><span class=\"k-wz\">（交通）堵塞；塞车；交通拥堵；延误；停滞；滞缓</span></li><li><span class=\"k-w\" lang=\"ja\">渋い</span><span class=\"kana\" lang=\"ja\">しぶい</span><span class=\"k-wz\">涩；苦涩；涩口；粗涩；酸；朴素；淡雅；素雅；沉静；低调；有品味；愁眉苦脸；不悦；阴沉；闷闷不乐；吝啬；小气</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">銃</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>枪；火器</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つつ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">銃</span><span class=\"kana\" lang=\"ja\">じゅう</span><span class=\"k-wz\">枪；枪支；小型武器</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">操</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>操纵；操作；操守；贞操；驾驶</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソウ・サン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">みさお・あやつ.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">操作</span><span class=\"kana\" lang=\"ja\">そうさ</span><span class=\"k-wz\">操作；管理；处理；操纵；幕后操控；影响</span></li><li><span class=\"k-w\" lang=\"ja\">体操</span><span class=\"kana\" lang=\"ja\">たいそう</span><span class=\"k-wz\">体操；体育锻炼；竞技体操；体育课；体育教育课</span></li><li><span class=\"k-w\" lang=\"ja\">操る</span><span class=\"kana\" lang=\"ja\">あやつる</span><span class=\"k-wz\">操作（机器等）；操纵；管理；控制；驾驶；熟练掌握（语言）；熟练演奏（乐器）；操纵木偶；牵动木偶的绳子；操纵（人、舆论等）；幕后操纵；暗中主导</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">診</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>诊察；诊断；检查；看病；观察</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">み.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">診察</span><span class=\"kana\" lang=\"ja\">しんさつ</span><span class=\"k-wz\">医学检查；体检；就诊</span></li><li><span class=\"k-w\" lang=\"ja\">診断</span><span class=\"kana\" lang=\"ja\">しんだん</span><span class=\"k-wz\">诊断；体检</span></li><li><span class=\"k-w\" lang=\"ja\">診る</span><span class=\"kana\" lang=\"ja\">みる</span><span class=\"k-wz\">（医学上）检查；诊察；把脉</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">託</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>委托；托付；借口；暗示</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">タク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かこつ.ける・かこ.つ・かこ.つける</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">委託</span><span class=\"kana\" lang=\"ja\">いたく</span><span class=\"k-wz\">委托；寄售；托付；信任；委任</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">撮</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>拍照；拍摄</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">サツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">と.る・つま.む・-ど.り</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">撮る</span><span class=\"kana\" lang=\"ja\">とる</span><span class=\"k-wz\">拍摄；拍照；录制；录音；录像；拍摄</span></li><li><span class=\"k-w\" lang=\"ja\">撮影</span><span class=\"kana\" lang=\"ja\">さつえい</span><span class=\"k-wz\">摄影；拍摄；摄制；录像</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">誕</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>诞生；虚妄（古义）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">タン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">誕生日</span><span class=\"kana\" lang=\"ja\">たんじょうび</span><span class=\"k-wz\">生日</span></li><li><span class=\"k-w\" lang=\"ja\">誕生</span><span class=\"kana\" lang=\"ja\">たんじょう</span><span class=\"k-wz\">出生；诞生；产生；形成；创造；起源；周岁；一周岁</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">侵</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>侵犯；侵占；侵入；侵害；冒犯</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おか.す</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">侵入</span><span class=\"kana\" lang=\"ja\">しんにゅう</span><span class=\"k-wz\">入侵；侵略；突袭；侵犯；闯入；越界；渗透；黑客攻击</span></li><li><span class=\"k-w\" lang=\"ja\">侵す</span><span class=\"kana\" lang=\"ja\">おかす</span><span class=\"k-wz\">侵犯；侵略；侵入；闯入；擅入；侵害；侵犯；蚕食；伤害；危害；侵袭</span></li><li><span class=\"k-w\" lang=\"ja\">侵略</span><span class=\"kana\" lang=\"ja\">しんりゃく</span><span class=\"k-wz\">侵略；侵犯；掠夺</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">括</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>捆扎；包括；概括；汇总</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">くく.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">括弧</span><span class=\"kana\" lang=\"ja\">かっこ</span><span class=\"k-wz\">括号；圆括号；方括号</span></li><li><span class=\"k-w\" lang=\"ja\">一括</span><span class=\"kana\" lang=\"ja\">いっかつ</span><span class=\"k-wz\">一并；汇总；打包；整批</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">謝</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>道歉；感谢；拒绝</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シャ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あやま.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">謝る</span><span class=\"kana\" lang=\"ja\">あやまる</span><span class=\"k-wz\">道歉；认错；拒绝；推辞；承受不住；不敌；无可奈何；认输</span></li><li><span class=\"k-w\" lang=\"ja\">感謝</span><span class=\"kana\" lang=\"ja\">かんしゃ</span><span class=\"k-wz\">感谢；感恩；谢意</span></li><li><span class=\"k-w\" lang=\"ja\">月謝</span><span class=\"kana\" lang=\"ja\">げっしゃ</span><span class=\"k-wz\">月学费；每月学费</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">駆</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>驱赶；奔跑；疾驰；推动；激励</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">か.ける・か.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">駆け足</span><span class=\"kana\" lang=\"ja\">かけあし</span><span class=\"k-wz\">快跑；奔跑；（军）跑步行进；（马术）慢跑；跑步（马的步法）；匆匆忙忙；仓促行事</span></li><li><span class=\"k-w\" lang=\"ja\">駆ける</span><span class=\"kana\" lang=\"ja\">かける</span><span class=\"k-wz\">奔跑；冲刺；疾驰；骑马奔驰；骑马慢跑；向敌军进攻；骑马冲锋</span></li><li><span class=\"k-w\" lang=\"ja\">駆けっこ</span><span class=\"kana\" lang=\"ja\">かけっこ</span><span class=\"k-wz\">赛跑；短跑</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">透</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>透明；渗透；过滤；穿透</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">す.く・す.かす・す.ける・とう.る・とう.す</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">透明</span><span class=\"kana\" lang=\"ja\">とうめい</span><span class=\"k-wz\">透明；清澈</span></li><li><span class=\"k-w\" lang=\"ja\">透き通る</span><span class=\"kana\" lang=\"ja\">すきとおる</span><span class=\"k-wz\">透明；清澈；明晰；清亮；清晰</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">津</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>港口；渡口；码头</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">天津</span><span class=\"kana\" lang=\"ja\">あまつ</span><span class=\"k-wz\">天的；帝王的</span></li><li><span class=\"k-w\" lang=\"ja\">津波</span><span class=\"kana\" lang=\"ja\">つなみ</span><span class=\"k-wz\">海啸；地震海浪</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">壁</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>墙壁；（胃）内膜；屏障</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヘキ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かべ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">壁</span><span class=\"kana\" lang=\"ja\">かべ</span><span class=\"k-wz\">墙；隔墙；障碍；阻碍；困难；壁宿（二十八宿之一）；（围棋）厚壁；棋墙（连成墙状的棋子）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">稲</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>水稻；稻子</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">トウ・テ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いね・いな-</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">稲</span><span class=\"kana\" lang=\"ja\">いね</span><span class=\"k-wz\">水稻；稻（学名：Oryza sativa）</span></li><li><span class=\"k-w\" lang=\"ja\">稲光</span><span class=\"kana\" lang=\"ja\">いなびかり</span><span class=\"k-wz\">闪电；(闪电的)闪光</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">仮</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>临时；暂定；假设；虚假；非正式</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カ・ケ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かり・かり-</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">仮定</span><span class=\"kana\" lang=\"ja\">かてい</span><span class=\"k-wz\">假定；假设；假想；（语法）假定；假设条件</span></li><li><span class=\"k-w\" lang=\"ja\">仮名</span><span class=\"kana\" lang=\"ja\">かな</span><span class=\"k-wz\">假名；日语音节文字（平假名和片假名）</span></li><li><span class=\"k-w\" lang=\"ja\">片仮名</span><span class=\"kana\" lang=\"ja\">かたかな</span><span class=\"k-wz\">片假名；日语音节文字，主要用于外来词</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">裂</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>撕裂；裂开；破裂</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">レツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さ.く・さ.ける・-ぎ.れ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">裂く</span><span class=\"kana\" lang=\"ja\">さく</span><span class=\"k-wz\">撕裂；撕开；割开；剖开；切开（尤指腹部）；强行拆散（如情侣等）；腾出；匀出（时间、金钱等）；在眼角纹身</span></li><li><span class=\"k-w\" lang=\"ja\">破裂</span><span class=\"kana\" lang=\"ja\">はれつ</span><span class=\"k-wz\">破裂；爆裂；爆炸；破裂；中断</span></li><li><span class=\"k-w\" lang=\"ja\">分裂</span><span class=\"kana\" lang=\"ja\">ぶんれつ</span><span class=\"k-wz\">分裂；分割；破裂</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">敏</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>灵敏；机敏；敏捷；聪慧</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ビン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さとい</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">敏感</span><span class=\"kana\" lang=\"ja\">びんかん</span><span class=\"k-wz\">敏感；警觉；觉察；易感</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">是</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>是（正确）；此；这；这个；这里</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ゼ・シ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">これ・この・ここ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">是正</span><span class=\"kana\" lang=\"ja\">ぜせい</span><span class=\"k-wz\">纠正；修正；改正；矫正</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">排</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>排除；排斥；排出；排列</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ハイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">排除</span><span class=\"kana\" lang=\"ja\">はいじょ</span><span class=\"k-wz\">排除；移除；消除；清除；去除</span></li><li><span class=\"k-w\" lang=\"ja\">排水</span><span class=\"kana\" lang=\"ja\">はいすい</span><span class=\"k-wz\">排水；抽水；污水处理；排水量；排量</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">裕</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>富裕；丰富；肥沃</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ユウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">余裕</span><span class=\"kana\" lang=\"ja\">よゆう</span><span class=\"k-wz\">盈余；余地；余量；空间；富余；灵活；范围；从容；镇定；沉着；泰然自若；自满</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">堅</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>坚硬；严格；可靠；坚固；紧密</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かた.い・-がた.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">堅い</span><span class=\"kana\" lang=\"ja\">かたい</span><span class=\"k-wz\">硬；坚硬；结实；僵硬；生硬；不流畅；不自然（如文章）；强；稳固；不易动摇；安全；稳妥；诚实；可靠；固执；顽固；书面化；正式；古板；拘谨</span></li></ul></div></li>"]