iv class=\"v-mid\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/vocab/\">N3</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">河流；溪流；河（用于河流名称）</span></div><div class=\"v-ex\"></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">皮</span><span class=\"v-r\" lang=\"ja\">かわ</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/vocab/\">N3</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">皮肤；兽皮；毛皮；果皮；外壳；树皮；壳；鞘；包装；面具；伪装；外表</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"123757\"><ruby>動物<rp>(</rp><rt>どうぶつ</rt><rp>)</rp></ruby>の<ruby>皮<rp>(</rp><rt>かわ</rt><rp>)</rp></ruby>は<ruby>毛<rp>(</rp><rt>け</rt><rp>)</rp></ruby>でおおわれている。</span><span class=\"ex-zh\" lang=\"zh-Hans\">动物的皮肤在头发上。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">革</span><span class=\"v-r\" lang=\"ja\">かわ</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/vocab/\">N3</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">皮革；皮</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"225653\">くつは<ruby>革<rp>(</rp><rt>かわ</rt><rp>)</rp></ruby>でつくられている。</span><span class=\"ex-zh\" lang=\"zh-Hans\">这靴是用皮革做的。 <a class=\"ex-attribution\" href=\"https://tatoeba.org/sentences/show/339300\" title=\"Tatoeba · nickyeow\" aria-label=\"Tatoeba · nickyeow\" target=\"_blank\" rel=\"noopener\">↗</a></span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">かわいい</span><span class=\"v-r\" lang=\"ja\"></span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">い形容词</span><span class=\"t-ja\" lang=\"ja\">い形容詞</span></span><span class=\"v-m\">可爱；讨人