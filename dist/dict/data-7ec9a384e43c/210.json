["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">恐</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>恐惧；害怕；敬畏</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おそ.れる・おそ.る・おそ.ろしい・こわ.い・こわ.がる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">恐怖</span><span class=\"kana\" lang=\"ja\">きょうふ</span><span class=\"k-wz\">恐惧；害怕；惊恐；恐怖；惊吓；惶恐</span></li><li><span class=\"k-w\" lang=\"ja\">恐れる</span><span class=\"kana\" lang=\"ja\">おそれる</span><span class=\"k-wz\">害怕；恐惧</span></li><li><span class=\"k-w\" lang=\"ja\">恐ろしい</span><span class=\"kana\" lang=\"ja\">おそろしい</span><span class=\"k-wz\">可怕的；令人恐惧的；使人害怕的；令人惊讶的；惊人的；了不起的</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">息</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>呼吸；休息；利息；儿子；停止</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いき</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">息子</span><span class=\"kana\" lang=\"ja\">むすこ</span><span class=\"k-wz\">儿子；阴茎；男性生殖器</span></li><li><span class=\"k-w\" lang=\"ja\">息</span><span class=\"kana\" lang=\"ja\">いき</span><span class=\"k-wz\">呼吸；协调；和谐；默契；水汽；蒸气</span></li><li><span class=\"k-w\" lang=\"ja\">休息</span><span class=\"kana\" lang=\"ja\">きゅうそく</span><span class=\"k-wz\">休息；解乏；放松</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">遠</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>远；遥远</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">エン・オン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">とお.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">遠い</span><span class=\"kana\" lang=\"ja\">とおい</span><span class=\"k-wz\">远的；遥远的；在远方的；久远的；遥远的（时间）；关系疏远；亲缘关系远；相差悬殊；差异很大；相去甚远；听力不好；耳背；近视</span></li><li><span class=\"k-w\" lang=\"ja\">遠慮</span><span class=\"kana\" lang=\"ja\">えんりょ</span><span class=\"k-wz\">保留；克制；谦逊；矜持；顾虑；迟疑；审慎；体贴；推辞；谢绝；克制不做；避免（做某事）；深谋远虑；预见</span></li><li><span class=\"k-w\" lang=\"ja\">遠く</span><span class=\"kana\" lang=\"ja\">とおく</span><span class=\"k-wz\">远处；远方；远地；遥远的地方；很久以前；很久以后；遥远的过去；遥远的未来；远远地；远比</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">戻</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>返回；恢复；倒退；重新开始；归还</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">レイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">もど.す・もど.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">戻る</span><span class=\"kana\" lang=\"ja\">もどる</span><span class=\"k-wz\">折返；中途返回；返回；回去；恢复；被归还；反弹；弹回</span></li><li><span class=\"k-w\" lang=\"ja\">戻す</span><span class=\"kana\" lang=\"ja\">もどす</span><span class=\"k-wz\">放回；退还；恢复（到之前的状态，如解冻、复原、和解）；回拨（如时针）；呕吐；吐出；（市场价格）恢复；回升</span></li><li><span class=\"k-w\" lang=\"ja\">払い戻す</span><span class=\"kana\" lang=\"ja\">はらいもどす</span><span class=\"k-wz\">偿还；退还；退款；报销</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">願</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>愿望；请求；祈祷；誓言；希望</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ガン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ねが.う・-ねがい</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">お願いします</span><span class=\"kana\" lang=\"ja\">おねがいします</span><span class=\"k-wz\">请；拜托了；麻烦了</span></li><li><span class=\"k-w\" lang=\"ja\">願い</span><span class=\"kana\" lang=\"ja\">ねがい</span><span class=\"k-wz\">愿望；希望；心愿；请求；恳求；祈求；呼吁；祈祷；祈念；（书面）申请；申请书</span></li><li><span class=\"k-w\" lang=\"ja\">願う</span><span class=\"kana\" lang=\"ja\">ねがう</span><span class=\"k-wz\">渴望；希望；想要；央求；请求；恳求；祈求；请人代为做某事；有劳……</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">絵</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>画；图画；绘画；素描</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カイ・エ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">絵</span><span class=\"kana\" lang=\"ja\">え</span><span class=\"k-wz\">图画；绘画；素描；画面；镜头；影像</span></li><li><span class=\"k-w\" lang=\"ja\">絵画</span><span class=\"kana\" lang=\"ja\">かいが</span><span class=\"k-wz\">绘画；图画</span></li><li><span class=\"k-w\" lang=\"ja\">絵の具</span><span class=\"kana\" lang=\"ja\">えのぐ</span><span class=\"k-wz\">绘画颜料；色彩材料；颜色</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">越</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>超过；跨越；移动；超出；越南</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">エツ・オツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">こ.す・-こ.す・-ご.し・こ.える・-ご.え</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">引っ越す</span><span class=\"kana\" lang=\"ja\">ひっこす</span><span class=\"k-wz\">搬家；迁居；改变住所</span></li><li><span class=\"k-w\" lang=\"ja\">越す</span><span class=\"kana\" lang=\"ja\">こす</span><span class=\"k-wz\">越过；跨越；穿过；克服；渡过；度过；熬过；超过；胜过；超越；搬家；迁居；（尊敬语）去；来；光临</span></li><li><span class=\"k-w\" lang=\"ja\">越える</span><span class=\"kana\" lang=\"ja\">こえる</span><span class=\"k-wz\">越过；跨越；穿过；经过；超越；超出；超过；超越；胜过；多于</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">欲</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>欲望；渴望；贪婪；贪欲；渴求</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヨク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ほっ.する・ほ.しい</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">欲しい</span><span class=\"kana\" lang=\"ja\">ほしい</span><span class=\"k-wz\">想要；希望拥有；想让（某人）做；希望（某人）</span></li><li><span class=\"k-w\" lang=\"ja\">食欲</span><span class=\"kana\" lang=\"ja\">しょくよく</span><span class=\"k-wz\">食欲</span></li><li><span class=\"k-w\" lang=\"ja\">欲張り</span><span class=\"kana\" lang=\"ja\">よくばり</span><span class=\"k-wz\">贪心；贪婪；贪欲；贪心的人</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">痛</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>疼痛；伤害；损伤；悲痛</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ツウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いた.い・いた.む・いた.ましい・いた.める</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">痛い</span><span class=\"kana\" lang=\"ja\">いたい</span><span class=\"k-wz\">疼痛；酸痛；令人尴尬的；难为情的</span></li><li><span class=\"k-w\" lang=\"ja\">痛み</span><span class=\"kana\" lang=\"ja\">いたみ</span><span class=\"k-wz\">疼痛；酸痛；悲伤；痛苦；损伤；破损；磨损；瘀伤；破裂</span></li><li><span class=\"k-w\" lang=\"ja\">苦痛</span><span class=\"kana\" lang=\"ja\">くつう</span><span class=\"k-wz\">痛苦；苦楚；折磨；痛楚</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">笑</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>笑；微笑；嗤笑</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">わら.う・え.む</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">笑う</span><span class=\"kana\" lang=\"ja\">わらう</span><span class=\"k-wz\">笑；发笑；微笑；含笑；嘲笑；讥笑；嘲讽；目瞪口呆；瞠目结舌</span></li><li><span class=\"k-w\" lang=\"ja\">笑顔</span><span class=\"kana\" lang=\"ja\">えがお</span><span class=\"k-wz\">笑脸；微笑</span></li><li><span class=\"k-w\" lang=\"ja\">笑い</span><span class=\"kana\" lang=\"ja\">わらい</span><span class=\"k-wz\">笑；笑声；微笑；笑容；冷笑；嘲笑；情趣用品；春宫图</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">互</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>互相；交互；共同</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ゴ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たが.い・かたみ.に</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">互い</span><span class=\"kana\" lang=\"ja\">たがい</span><span class=\"k-wz\">互相；彼此</span></li><li><span class=\"k-w\" lang=\"ja\">お互い</span><span class=\"kana\" lang=\"ja\">おたがい</span><span class=\"k-wz\">彼此；互相；相互</span></li><li><span class=\"k-w\" lang=\"ja\">相互</span><span class=\"kana\" lang=\"ja\">そうご</span><span class=\"k-wz\">相互的；互相的；互惠的</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">束</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>捆束；束（量词）；管理；控制</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たば・たば.ねる・つか・つか.ねる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">約束</span><span class=\"kana\" lang=\"ja\">やくそく</span><span class=\"k-wz\">约定</span></li><li><span class=\"k-w\" lang=\"ja\">束</span><span class=\"kana\" lang=\"ja\">たば</span><span class=\"k-wz\">束；捆；把（量词）</span></li><li><span class=\"k-w\" lang=\"ja\">結束</span><span class=\"kana\" lang=\"ja\">けっそく</span><span class=\"k-wz\">团结；联合；齐心协力；捆绑；捆扎；系束；穿戴；着装；披甲</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">似</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>相似；模仿；适合；伪造</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">に.る・ひ.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">似る</span><span class=\"kana\" lang=\"ja\">にる</span><span class=\"k-wz\">相似；相像；像；相近；酷似</span></li><li><span class=\"k-w\" lang=\"ja\">真似</span><span class=\"kana\" lang=\"ja\">まね</span><span class=\"k-wz\">模仿；仿效；学样；行为；举动；行为举止</span></li><li><span class=\"k-w\" lang=\"ja\">似合う</span><span class=\"kana\" lang=\"ja\">にあう</span><span class=\"k-wz\">适合；相配；相称</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">列</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>列；排；行；等级；纵队</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">レツ・レ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">列</span><span class=\"kana\" lang=\"ja\">れつ</span><span class=\"k-wz\">行；列；排；队伍；横排；行列；同类；伙伴；（某类人的）行列；…之列；（数学）数列；序列；系（分类学等级）；（量词）列；排；行</span></li><li><span class=\"k-w\" lang=\"ja\">列車</span><span class=\"kana\" lang=\"ja\">れっしゃ</span><span class=\"k-wz\">列车；火车</span></li><li><span class=\"k-w\" lang=\"ja\">行列</span><span class=\"kana\" lang=\"ja\">ぎょうれつ</span><span class=\"k-wz\">队列；行列；队伍；游行；矩阵</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">探</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>寻找；搜索；探查</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">タン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さぐ.る・さが.す</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">探す</span><span class=\"kana\" lang=\"ja\">さがす</span><span class=\"k-wz\">寻找；查找；搜索；搜查；翻找；搜寻</span></li><li><span class=\"k-w\" lang=\"ja\">探る</span><span class=\"kana\" lang=\"ja\">さぐる</span><span class=\"k-wz\">摸索；探摸；寻找；搜寻；调查；探查；侦察；打探；刺探；探索（未知之地）；欣赏（自然风光）</span></li><li><span class=\"k-w\" lang=\"ja\">探検</span><span class=\"kana\" lang=\"ja\">たんけん</span><span class=\"k-wz\">探险；探索；远征</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">逃</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>逃跑；逃避；错过；放跑；推卸</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">に.げる・に.がす・のが.す・のが.れる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">逃げる</span><span class=\"kana\" lang=\"ja\">にげる</span><span class=\"k-wz\">逃跑；逃离；逃脱；躲避；冲出；躲藏；回避；逃避；躲闪；推卸；退缩；领先获胜；坚持领先到终点；保持领先；逸出；泄漏；散发；消失（指热、气体、香气等）；姿势不稳；身体失去平衡</span></li><li><span class=\"k-w\" lang=\"ja\">逃がす</span><span class=\"kana\" lang=\"ja\">にがす</span><span class=\"k-wz\">释放；放走；让……逃脱；错过；遗漏；失去；未能抓住</span></li><li><span class=\"k-w\" lang=\"ja\">逃走</span><span class=\"kana\" lang=\"ja\">とうそう</span><span class=\"k-wz\">逃走；逃亡；脱逃</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">遊</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>游玩；玩耍；游戏；游乐；嬉戏</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ユウ・ユ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あそ.ぶ・あそ.ばす</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">遊ぶ</span><span class=\"kana\" lang=\"ja\">あそぶ</span><span class=\"k-wz\">玩耍；游戏；娱乐；消遣；鬼混；胡闹；寻欢作乐（指酒色、赌博等）；闲着；无所事事；闲置；未被使用；（和朋友）一起玩；出去玩；聚会；沉溺；放纵（赌博、饮酒等）；前往；去（为了娱乐或学习）；逗弄；戏弄；调侃；（棒球）故意投坏球以扰乱打者注意力</span></li><li><span class=\"k-w\" lang=\"ja\">遊び</span><span class=\"kana\" lang=\"ja\">あそび</span><span class=\"k-wz\">玩耍；游戏；娱乐；消遣；游乐；休闲；机械间隙；活动间隙；表现自由度；艺术表现的灵活性；空白页；衬页</span></li><li><span class=\"k-w\" lang=\"ja\">遊園地</span><span class=\"kana\" lang=\"ja\">ゆうえんち</span><span class=\"k-wz\">游乐园；游园地</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">迷</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>迷惑；迷失；困惑；迷惘；幻觉</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">メイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">まよ.う</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">迷子</span><span class=\"kana\" lang=\"ja\">まいご</span><span class=\"k-wz\">迷路的孩子；走失的孩子；走失的人；失踪儿童</span></li><li><span class=\"k-w\" lang=\"ja\">迷惑</span><span class=\"kana\" lang=\"ja\">めいわく</span><span class=\"k-wz\">麻烦；烦扰；困扰；不便；感到困扰；被烦扰；感到不便</span></li><li><span class=\"k-w\" lang=\"ja\">迷信</span><span class=\"kana\" lang=\"ja\">めいしん</span><span class=\"k-wz\">迷信；迷信的信念</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">夢</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>梦；梦想；幻影；幻觉</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ム・ボウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ゆめ・ゆめ.みる・くら.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">夢</span><span class=\"kana\" lang=\"ja\">ゆめ</span><span class=\"k-wz\">梦；梦境；梦；希望；愿望；志向；抱负；不切实际的幻想；白日梦；空想；妄想；幻觉；错觉；转瞬即逝的事物；昙花一现的东西</span></li><li><span class=\"k-w\" lang=\"ja\">夢中</span><span class=\"kana\" lang=\"ja\">むちゅう</span><span class=\"k-wz\">专心致志；沉迷；痴迷；全神贯注；忘我；恍惚；出神；入迷；梦中；睡梦里</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">君</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>你；男性名字后缀；君主；先生</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">クン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">きみ・-ぎみ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">君</span><span class=\"kana\" lang=\"ja\">きみ</span><span class=\"k-wz\">你；老兄；哥们；君主；统治者；主君；他；她</span></li><li><span class=\"k-w\" lang=\"ja\">君主</span><span class=\"kana\" lang=\"ja\">くんしゅ</span><span class=\"k-wz\">君主；主权者；统治者；领主</span></li><li><span class=\"k-w\" lang=\"ja\">諸君</span><span class=\"kana\" lang=\"ja\">しょくん</span><span class=\"k-wz\">你们；诸位；诸君；各位；女士们先生们；大家</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">閉</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>关闭；合上；封闭；关着；关紧</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヘイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">と.じる・と.ざす・し.める・し.まる・た.てる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">閉まる</span><span class=\"kana\" lang=\"ja\">しまる</span><span class=\"k-wz\">关闭；闭合；紧实；结实；被锁上；锁定；拧紧；绷紧；清醒；变得紧张</span></li><li><span class=\"k-w\" lang=\"ja\">閉める</span><span class=\"kana\" lang=\"ja\">しめる</span><span class=\"k-wz\">关闭；闭合</span></li><li><span class=\"k-w\" lang=\"ja\">閉じる</span><span class=\"kana\" lang=\"ja\">とじる</span><span class=\"k-wz\">关闭；合上；结束</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">緒</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>开端；线头；绳带；情绪</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショ・チョ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">お・いとぐち</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">一緒</span><span class=\"kana\" lang=\"ja\">いっしょ</span><span class=\"k-wz\">一起；共同；一团；混在一起；同一类；相同；一样；同时；一并</span></li><li><span class=\"k-w\" lang=\"ja\">情緒</span><span class=\"kana\" lang=\"ja\">じょうしょ</span><span class=\"k-wz\">情感；感情；气氛；情调；意境</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">折</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>折叠；折断；弯曲；屈服；时机</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セツ・シャク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">お.る・おり・お.り・-お.り・お.れる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">折る</span><span class=\"kana\" lang=\"ja\">おる</span><span class=\"k-wz\">折断；折裂；掰断；摘取（花等）；折叠；弯曲；折（折纸）；打断；结束</span></li><li><span class=\"k-w\" lang=\"ja\">折れる</span><span class=\"kana\" lang=\"ja\">おれる</span><span class=\"k-wz\">折断；断裂；骨折；被折叠；屈服；退让；让步；妥协；转弯；拐弯</span></li><li><span class=\"k-w\" lang=\"ja\">骨折</span><span class=\"kana\" lang=\"ja\">こっせつ</span><span class=\"k-wz\">骨折</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">草</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>草；杂草；牧草；草本；起草</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">くさ・くさ-・-ぐさ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">草</span><span class=\"kana\" lang=\"ja\">くさ</span><span class=\"k-wz\">草；杂草；药草；茅草；忍者；大麻；非正品的；劣质的；哈哈；大笑</span></li><li><span class=\"k-w\" lang=\"ja\">草履</span><span class=\"kana\" lang=\"ja\">ぞうり</span><span class=\"k-wz\">草履；日式夹趾凉鞋</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">暮</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>傍晚；暮色；季末；生计；度日</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">く.れる・く.らす</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">暮れる</span><span class=\"kana\" lang=\"ja\">くれる</span><span class=\"k-wz\">天黑；日暮；终了；结束；陷入；沉浸于</span></li><li><span class=\"k-w\" lang=\"ja\">暮れ</span><span class=\"kana\" lang=\"ja\">くれ</span><span class=\"k-wz\">日暮；黄昏；傍晚；终了；结束；年终；岁末</span></li><li><span class=\"k-w\" lang=\"ja\">暮らし</span><span class=\"kana\" lang=\"ja\">くらし</span><span class=\"k-wz\">生活方式；生活；生计；日常生活</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">酒</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>酒；酒精</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シュ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さけ・さか-</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">お酒</span><span class=\"kana\" lang=\"ja\">おさけ</span><span class=\"k-wz\">酒；酒精饮料</span></li><li><span class=\"k-w\" lang=\"ja\">酒</span><span class=\"kana\" lang=\"ja\">さけ</span><span class=\"k-wz\">酒；含酒精饮料</span></li><li><span class=\"k-w\" lang=\"ja\">酒場</span><span class=\"kana\" lang=\"ja\">さかば</span><span class=\"k-wz\">酒吧；酒馆；小酒馆</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">悲</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>悲伤；哀悼；惋惜；遗憾</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヒ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かな.しい・かな.しむ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">悲しい</span><span class=\"kana\" lang=\"ja\">かなしい</span><span class=\"k-wz\">悲伤的；悲惨的；不快乐的；哀伤的；令人悲哀的；令人遗憾的；可叹的；令人痛心的</span></li><li><span class=\"k-w\" lang=\"ja\">悲劇</span><span class=\"kana\" lang=\"ja\">ひげき</span><span class=\"k-wz\">悲剧；悲剧戏剧；悲剧；灾难；不幸事件</span></li><li><span class=\"k-w\" lang=\"ja\">悲しむ</span><span class=\"kana\" lang=\"ja\">かなしむ</span><span class=\"k-wz\">感到悲伤；哀悼；后悔</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">晴</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>晴天；放晴；晴朗；消除（疑虑等）；舒畅</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">は.れる・は.れ・は.れ-・-ば.れ・は.らす</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">晴れ</span><span class=\"kana\" lang=\"ja\">はれ</span><span class=\"k-wz\">晴天；晴朗；正式；庄重；公开；洗清嫌疑；证明清白</span></li><li><span class=\"k-w\" lang=\"ja\">晴れる</span><span class=\"kana\" lang=\"ja\">はれる</span><span class=\"k-wz\">晴朗；放晴；天气转晴；雨停；（心情等）舒畅；爽快；开朗；（嫌疑等）消除；洗清；（阴云等）消散；消失</span></li><li><span class=\"k-w\" lang=\"ja\">快晴</span><span class=\"kana\" lang=\"ja\">かいせい</span><span class=\"k-wz\">晴朗；万里无云；好天气</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">掛</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>悬挂；花费；浇洒；依靠；乘法</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カイ・ケイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">か.ける・-か.ける・か.け・-か.け・-が.け・か.かる・-か.かる・-が.かる・か.かり・-が.かり・かかり・-がかり</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">お目に掛かる</span><span class=\"kana\" lang=\"ja\">おめにかかる</span><span class=\"k-wz\">（与身份较高的人）见面；相见；被（身份较高的人等）认可；显眼；被看见；引起注意</span></li><li><span class=\"k-w\" lang=\"ja\">掛け算</span><span class=\"kana\" lang=\"ja\">かけざん</span><span class=\"k-wz\">乘法</span></li><li><span class=\"k-w\" lang=\"ja\">腰掛け</span><span class=\"kana\" lang=\"ja\">こしかけ</span><span class=\"k-wz\">座位；长凳；临时工作；过渡性工作</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">到</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>到达；达到；及；导致；来临</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いた.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">到着</span><span class=\"kana\" lang=\"ja\">とうちゃく</span><span class=\"k-wz\">到达；抵达</span></li><li><span class=\"k-w\" lang=\"ja\">到達</span><span class=\"kana\" lang=\"ja\">とうたつ</span><span class=\"k-wz\">到达</span></li><li><span class=\"k-w\" lang=\"ja\">到底</span><span class=\"kana\" lang=\"ja\">とうてい</span><span class=\"k-wz\">根本；简直；完全</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">寝</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>躺下；睡觉；休息；床；滞销</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ね.る・ね.かす・い.ぬ・みたまや・や.める</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">寝る</span><span class=\"kana\" lang=\"ja\">ねる</span><span class=\"k-wz\">睡觉；躺着睡；上床；躺在床上；躺下；躺平；与…同床；发生性关系；贴平；服帖（如头发）；闲置；未被使用（如资金、股票等）；发酵（如酱油、味噌等）</span></li><li><span class=\"k-w\" lang=\"ja\">寝坊</span><span class=\"kana\" lang=\"ja\">ねぼう</span><span class=\"k-wz\">睡懒觉；睡过头；爱睡懒觉的人；贪睡的人</span></li><li><span class=\"k-w\" lang=\"ja\">寝台</span><span class=\"kana\" lang=\"ja\">しんだい</span><span class=\"k-wz\">床；卧铺</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">暗</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>黑暗；昏暗；秘密；默记；目眩</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">アン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">くら.い・くら.む・くれ.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">暗い</span><span class=\"kana\" lang=\"ja\">くらい</span><span class=\"k-wz\">黑暗的；昏暗的；阴暗的；沮丧的；消沉的；心情阴郁的；（颜色）深暗的；暗淡的；不祥的；可疑的；（来历）不明的；无望的；没有希望的；前景暗淡的；不熟悉的；不了解的；无知的</span></li><li><span class=\"k-w\" lang=\"ja\">暗記</span><span class=\"kana\" lang=\"ja\">あんき</span><span class=\"k-wz\">记忆；背诵；记诵</span></li><li><span class=\"k-w\" lang=\"ja\">薄暗い</span><span class=\"kana\" lang=\"ja\">うすぐらい</span><span class=\"k-wz\">昏暗；阴暗</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">盗</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>偷盗；抢劫；盗窃</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ぬす.む・ぬす.み</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">盗む</span><span class=\"kana\" lang=\"ja\">ぬすむ</span><span class=\"k-wz\">偷；盗取；抄袭；窃取（技巧、想法等）；暗中学习；偷偷地做；悄悄地进行；在匆忙中抽时间做；利用片刻时间做；盗垒</span></li><li><span class=\"k-w\" lang=\"ja\">強盗</span><span class=\"kana\" lang=\"ja\">ごうとう</span><span class=\"k-wz\">抢劫犯；强盗；劫匪；抢劫；入室盗窃</span></li><li><span class=\"k-w\" lang=\"ja\">盗難</span><span class=\"kana\" lang=\"ja\">とうなん</span><span class=\"k-wz\">盗窃；失窃</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">吸</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>吸；吸入；喝；抽；吸食</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">す.う</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">吸う</span><span class=\"kana\" lang=\"ja\">すう</span><span class=\"k-wz\">吸入；吸气；吸烟；吸吮；啜饮；吮吸；吸收；吸附；亲吻</span></li><li><span class=\"k-w\" lang=\"ja\">吸収</span><span class=\"kana\" lang=\"ja\">きゅうしゅう</span><span class=\"k-wz\">吸收；吸取；吸引</span></li><li><span class=\"k-w\" lang=\"ja\">呼吸</span><span class=\"kana\" lang=\"ja\">こきゅう</span><span class=\"k-wz\">呼吸；呼吸作用；窍门；诀窍；秘诀；和谐；协调；同步；配合；短暂间隔；短暂停顿</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">陽</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>太阳；阳光；阳性；白天；男性</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヨウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ひ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">太陽</span><span class=\"kana\" lang=\"ja\">たいよう</span><span class=\"k-wz\">太阳</span></li><li><span class=\"k-w\" lang=\"ja\">陽気</span><span class=\"kana\" lang=\"ja\">ようき</span><span class=\"k-wz\">开朗的；愉快的；活泼的；天气；季节；时令；阳气</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">御</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>尊敬；统治；驾驭</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ギョ・ゴ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おん-・お-・み-</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">御飯</span><span class=\"kana\" lang=\"ja\">ごはん</span><span class=\"k-wz\">米饭；煮好的饭；餐；饭食</span></li><li><span class=\"k-w\" lang=\"ja\">晩御飯</span><span class=\"kana\" lang=\"ja\">ばんごはん</span><span class=\"k-wz\">晚餐；晚饭</span></li><li><span class=\"k-w\" lang=\"ja\">昼御飯</span><span class=\"kana\" lang=\"ja\">ひるごはん</span><span class=\"k-wz\">午餐；中餐；午饭</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">歯</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>牙齿；齿（机械的齿状物）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">よわい・は・よわ.い・よわい.する</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">歯</span><span class=\"kana\" lang=\"ja\">は</span><span class=\"k-wz\">牙齿；牙；齿；齿（梳子、锯子等的）；木屐的齿（支撑底部的突起）</span></li><li><span class=\"k-w\" lang=\"ja\">歯医者</span><span class=\"kana\" lang=\"ja\">はいしゃ</span><span class=\"k-wz\">牙医；牙科医生</span></li><li><span class=\"k-w\" lang=\"ja\">虫歯</span><span class=\"kana\" lang=\"ja\">むしば</span><span class=\"k-wz\">蛀牙；龋齿；牙洞；龋病</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">忘</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>忘记</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">わす.れる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">忘れる</span><span class=\"kana\" lang=\"ja\">わすれる</span><span class=\"k-wz\">遗忘；忘记；忘却；遗漏</span></li><li><span class=\"k-w\" lang=\"ja\">忘れ物</span><span class=\"kana\" lang=\"ja\">わすれもの</span><span class=\"k-wz\">遗失物；遗落的东西；忘带东西；落下东西；遗落物品</span></li><li><span class=\"k-w\" lang=\"ja\">度忘れ</span><span class=\"kana\" lang=\"ja\">どわすれ</span><span class=\"k-wz\">一时遗忘；一时想不起来；突然忘记</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">雪</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>雪</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ゆき</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">雪</span><span class=\"kana\" lang=\"ja\">ゆき</span><span class=\"k-wz\">雪；降雪</span></li><li><span class=\"k-w\" lang=\"ja\">吹雪</span><span class=\"kana\" lang=\"ja\">ふぶき</span><span class=\"k-wz\">暴风雪；风雪</span></li><li><span class=\"k-w\" lang=\"ja\">雪崩</span><span class=\"kana\" lang=\"ja\">なだれ</span><span class=\"k-wz\">雪崩；雪滑；雪崩；雪崩定石</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">吹</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>吹；喷出；呼吸；冒烟</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">スイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ふ.く</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">吹く</span><span class=\"kana\" lang=\"ja\">ふく</span><span class=\"k-wz\">吹；刮（风）；吹气；呼气；吹（热茶、蜡烛等）；吹气；吹奏（管乐器）；吹（哨子、喇叭等）；吹口哨；喷出（烟、火等）；冒出；喷吐；抽芽；萌芽；发芽；浮现（于表面）；生成；附着（粉末、锈迹等）；突然大笑；爆笑；吹牛；说大话；冶炼；铸造</span></li><li><span class=\"k-w\" lang=\"ja\">吹雪</span><span class=\"kana\" lang=\"ja\">ふぶき</span><span class=\"k-wz\">暴风雪；风雪</span></li><li><span class=\"k-w\" lang=\"ja\">吹奏</span><span class=\"kana\" lang=\"ja\">すいそう</span><span class=\"k-wz\">吹奏（管乐器）；吹奏</span></li></ul></div></li>"]