["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">媒</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>中介；媒人</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">バイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">なこうど</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">鶏</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>鸡</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">にわとり・とり</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">鶏肉</span><span class=\"kana\" lang=\"ja\">とりにく</span><span class=\"k-wz\">鸡肉；家禽肉；禽肉</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">禅</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>禅（佛教修行）；静思</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ゼン・セン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">しずか・ゆず.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">禅</span><span class=\"kana\" lang=\"ja\">ぜん</span><span class=\"k-wz\">禅定；深度冥想；禅宗；禅</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">嘱</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>委托；请求；传话</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">しょく.する・たの.む</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">胴</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>躯干；船体；轮毂</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ドウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">胴</span><span class=\"kana\" lang=\"ja\">どう</span><span class=\"k-wz\">躯干；躯体；身体；腹部；腰部；剑道胸甲；击中胸甲；鼓框；音箱；船体；庄家</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">迭</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>转移；交替</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">テツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">挿</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>插入；放入；嫁接；佩戴（刀剑）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さ.す・はさ.む</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">挿す</span><span class=\"kana\" lang=\"ja\">さす</span><span class=\"k-wz\">插入；放入；扦插；插枝；插花；插；摆花；佩（刀）；将（刀）插于腰带；关闭；上锁；闩上；扣紧</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">嵐</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>暴风雨；风暴</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ラン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あらし</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">嵐</span><span class=\"kana\" lang=\"ja\">あらし</span><span class=\"k-wz\">风暴；暴风雨；骚动；喧嚣；（如抗议的）浪潮；（如变革的）风潮；（纸牌游戏「おいちょかぶ」）三张同点数牌的组合</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">椎</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>椎（栲树）；槌（木槌）；脊柱</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ツイ・スイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つち・う.つ</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">絹</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>丝绸</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">きぬ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">絹</span><span class=\"kana\" lang=\"ja\">きぬ</span><span class=\"k-wz\">丝绸；丝</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">陪</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>陪同；跟随；侍奉；服从</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">バイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">剖</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>分割；剖开</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">解剖</span><span class=\"kana\" lang=\"ja\">かいぼう</span><span class=\"k-wz\">解剖；尸检；验尸；分析；事后检讨</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">譜</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>乐谱；系谱；谱表；图表</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">フ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">楽譜</span><span class=\"kana\" lang=\"ja\">がくふ</span><span class=\"k-wz\">乐谱；乐曲谱</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">郁</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>文化进步；香气</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">イク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">悠</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>永久；遥远；长久；悠闲</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ユウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">悠々</span><span class=\"kana\" lang=\"ja\">ゆうゆう</span><span class=\"k-wz\">悠闲；从容；安详；镇定；轻松；舒适；毫不费力；遥远；辽阔；无边；无尽；永恒</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">淑</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>优雅；温和；纯洁</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シュク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">しと.やか</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">帆</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>帆</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ハン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ほ</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">暁</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>拂晓；黎明；（事件发生的）当口</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ギョウ・キョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あかつき・さと.る</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">傑</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>卓越；杰出；优秀</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">すぐ.れる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">傑作</span><span class=\"kana\" lang=\"ja\">けっさく</span><span class=\"k-wz\">杰作；佳作；名作；（无意中）滑稽可笑的；荒诞的；离谱的；疯狂的</span></li><li><span class=\"k-w\" lang=\"ja\">傑</span><span class=\"kana\" lang=\"ja\">けつ</span><span class=\"k-wz\">（数词）最...的；前...名的</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">楠</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>樟树</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ナン・ダン・ゼン・ネン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">くす・くすのき</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">笛</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>笛子；哨子；管乐器；风笛；短笛</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">テキ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ふえ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">笛</span><span class=\"kana\" lang=\"ja\">ふえ</span><span class=\"k-wz\">笛；长笛；竖笛；尺八；黑管；口哨；哨子</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">玲</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>玉声；珠玉相击之声</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">レイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">奴</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>家伙；奴隶；仆人；小子</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ド</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">やつ・やっこ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">奴</span><span class=\"kana\" lang=\"ja\">やっこ</span><span class=\"k-wz\">仆人；武士的侍从；侠客；见义勇为的人（江户时代）；豆腐块；冷豆腐；奴风筝（画成江户时代武家仆从模样的风筝）；奴发型（江户时代武士侍从所梳的发型）；没为奴婢（江户时代刑罚，女子因本人或丈夫犯罪而受罚）；（古，贬）那家伙；那小子；他；她</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">錠</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>锁；药片；镣铐</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">手錠</span><span class=\"kana\" lang=\"ja\">てじょう</span><span class=\"k-wz\">手铐；镣铐；锁链拘禁（江户时代司法体罚）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">拳</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>拳头</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケン・ゲン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">こぶし</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">翔</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>飞翔；翱翔</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かけ.る・と.ぶ</dd></dl><ul class=\"k-ws\"></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">遷</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n1\" href=\"../n1/kanji/\">N1</a>迁移；移动；改变；迁都</p><dl class=\"k-yomi\"><dt><span 