["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">何</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/kanji/\">N5</a>什么；何（疑问代词）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">なに・なん・なに-・なん-</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">何</span><span class=\"kana\" lang=\"ja\">なに</span><span class=\"k-wz\">什么；那个东西；你懂的；那玩意儿；那什么东西；那谁；阴茎；那话儿；（一点也）不；（毫）不；什么？；嗯？；喂！；搞什么！；什么嘛（表示恼怒）；没事；没关系；哪里</span></li><li><span class=\"k-w\" lang=\"ja\">何か</span><span class=\"kana\" lang=\"ja\">なにか</span><span class=\"k-wz\">某事；某物；什么东西；不知为何；莫名其妙；你想说什么？；你是什么意思？</span></li><li><span class=\"k-w\" lang=\"ja\">何で</span><span class=\"kana\" lang=\"ja\">なんで</span><span class=\"k-wz\">为什么；为了什么；怎样；用什么方法；如何</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">南</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/kanji/\">N5</a>南</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ナン・ナ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">みなみ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">南</span><span class=\"kana\" lang=\"ja\">なん</span><span class=\"k-wz\">南风牌；南风刻子和牌</span></li><li><span class=\"k-w\" lang=\"ja\">南極</span><span class=\"kana\" lang=\"ja\">なんきょく</span><span class=\"k-wz\">南极；南极地区；南极洲</span></li><li><span class=\"k-w\" lang=\"ja\">南米</span><span class=\"kana\" lang=\"ja\">なんべい</span><span class=\"k-wz\">南美</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">万</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/kanji/\">N5</a>一万；众多；全部</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">マン・バン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">よろず</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">万</span><span class=\"kana\" lang=\"ja\">まん</span><span class=\"k-wz\">一万；万；无数；众多；一切；所有；万物；各种；多种</span></li><li><span class=\"k-w\" lang=\"ja\">万年筆</span><span class=\"kana\" lang=\"ja\">まんねんひつ</span><span class=\"k-wz\">万年笔；钢笔</span></li><li><span class=\"k-w\" lang=\"ja\">万一</span><span class=\"kana\" lang=\"ja\">まんいち</span><span class=\"k-wz\">万一；万分之一的可能；最坏的情况；万一；如果万一；万一要是；倘若</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">毎</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/kanji/\">N5</a>每</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">マイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ごと・-ごと.に</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">毎朝</span><span class=\"kana\" lang=\"ja\">まいあさ</span><span class=\"k-wz\">每天早晨；每天早上</span></li><li><span class=\"k-w\" lang=\"ja\">毎月</span><span class=\"kana\" lang=\"ja\">まいげつ</span><span class=\"k-wz\">每月；每个月；按月</span></li><li><span class=\"k-w\" lang=\"ja\">毎週</span><span class=\"kana\" lang=\"ja\">まいしゅう</span><span class=\"k-wz\">每周；每个星期</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">白</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/kanji/\">N5</a>白色；空白；清白；明白；坦白</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ハク・ビャク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">しろ・しら-・しろ.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">白</span><span class=\"kana\" lang=\"ja\">しろ</span><span class=\"k-wz\">白色；清白；无辜；空白；空白处；白子；白棋；（麻将）白板；烤猪小肠串</span></li><li><span class=\"k-w\" lang=\"ja\">白い</span><span class=\"kana\" lang=\"ja\">しろい</span><span class=\"k-wz\">白色的；空白的；未着色的；无标记的；洁净的；纯净的；无辜的；清白的；纯洁的；明亮的；鲜艳的；缺乏经验的；天真的；未经训练的</span></li><li><span class=\"k-w\" lang=\"ja\">白髪</span><span class=\"kana\" lang=\"ja\">しらが</span><span class=\"k-wz\">白发；灰白的头发</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">天</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/kanji/\">N5</a>天空；天；皇室</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">テン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あまつ・あめ・あま-</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">天気</span><span class=\"kana\" lang=\"ja\">てんき</span><span class=\"k-wz\">天气</span></li><li><span class=\"k-w\" lang=\"ja\">天気予報</span><span class=\"kana\" lang=\"ja\">てんきよほう</span><span class=\"k-wz\">天气预报；气象预报</span></li><li><span class=\"k-w\" lang=\"ja\">天候</span><span class=\"kana\" lang=\"ja\">てんこう</span><span class=\"k-wz\">天气；天候</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">母</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/kanji/\">N5</a>母亲</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はは・も</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">お母さん</span><span class=\"kana\" lang=\"ja\">おかあさん</span><span class=\"k-wz\">母亲；妈妈；妈；母亲大人；妻子；老婆；您（对年长于说话者的老年人的称呼）；她</span></li><li><span class=\"k-w\" lang=\"ja\">伯母さん</span><span class=\"kana\" lang=\"ja\">おばさん</span><span class=\"k-wz\">姑妈；姨妈；婶婶；舅妈；伯母（对父母的姐妹或叔伯舅之妻的亲切称呼）</span></li><li><span class=\"k-w\" lang=\"ja\">祖母</span><span class=\"kana\" lang=\"ja\">そぼ</span><span class=\"k-wz\">祖母；外婆；奶奶</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">右</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/kanji/\">N5</a>右</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ウ・ユウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">みぎ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">右</span><span class=\"kana\" lang=\"ja\">みぎ</span><span class=\"k-wz\">右；右侧；右边；右手；（竖写文中）上文；上述；右翼；右派；（两者中）较优者</span></li><li><span class=\"k-w\" lang=\"ja\">左右</span><span class=\"kana\" lang=\"ja\">さゆう</span><span class=\"k-wz\">左右；左边和右边；控制；影响；支配；侍从；随从；（侍奉于某人的）身边；侧近；含糊其辞；模棱两可</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">読</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/kanji/\">N5</a>阅读</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ドク・トク・トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">よ.む・-よ.み</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">読む</span><span class=\"kana\" lang=\"ja\">よむ</span><span class=\"k-wz\">读</span></li><li><span class=\"k-w\" lang=\"ja\">読書</span><span class=\"kana\" lang=\"ja\">どくしょ</span><span class=\"k-wz\">读书</span></li><li><span class=\"k-w\" lang=\"ja\">読み</span><span class=\"kana\" lang=\"ja\">よみ</span><span class=\"k-wz\">阅读；诵读；读音；训读；解读；理解；判断；推断；预测</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">友</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/kanji/\">N5</a>朋友</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ユウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">とも</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">友達</span><span class=\"kana\" lang=\"ja\">ともだち</span><span class=\"k-wz\">朋友</span></li><li><span class=\"k-w\" lang=\"ja\">友</span><span class=\"kana\" lang=\"ja\">とも</span><span class=\"k-wz\">朋友；伙伴；同伴；（书籍等）相伴之物；良伴；补充；附属品</span></li><li><span class=\"k-w\" lang=\"ja\">親友</span><span class=\"kana\" lang=\"ja\">しんゆう</span><span class=\"k-wz\">知心朋友；密友；挚友</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">左</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/kanji/\">N5</a>左</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">サ・シャ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ひだり</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">左</span><span class=\"kana\" lang=\"ja\">ひだり</span><span class=\"k-wz\">左；左侧；左方；左手；左翼；左派；嗜酒；好酒之人</span></li><li><span class=\"k-w\" lang=\"ja\">左右</span><span class=\"kana\" lang=\"ja\">さゆう</span><span class=\"k-wz\">左右；左边和右边；控制；影响；支配；侍从；随从；（侍奉于某人的）身边；侧近；含糊其辞；模棱两可</span></li><li><span class=\"k-w\" lang=\"ja\">左利き</span><span class=\"kana\" lang=\"ja\">ひだりきき</span><span class=\"k-wz\">左撇子；左手人；左利的人；嗜酒；好酒者；饮酒爱好者</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">休</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/kanji/\">N5</a>休息；休假；退休；睡觉</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">やす.む・やす.まる・やす.める</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">休み</span><span class=\"kana\" lang=\"ja\">やすみ</span><span class=\"k-wz\">休息；休憩；喘息；假期；假日；缺席；暂停；（蚕在蜕皮前的）休眠状态</span></li><li><span class=\"k-w\" lang=\"ja\">休む</span><span class=\"kana\" lang=\"ja\">やすむ</span><span class=\"k-wz\">缺席；请假；休息；小憩；就寝；睡觉；上床休息；暂时停止；停业</span></li><li><span class=\"k-w\" lang=\"ja\">夏休み</span><span class=\"kana\" lang=\"ja\">なつやすみ</span><span class=\"k-wz\">暑假；暑期</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">父</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/kanji/\">N5</a>父亲</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">フ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ちち</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">お父さん</span><span class=\"kana\" lang=\"ja\">おとうさん</span><span class=\"k-wz\">父亲；爸爸；爹爹；老爸；丈夫；您；你；他（对年长者的称呼）</span></li><li><span class=\"k-w\" lang=\"ja\">お祖父さん</span><span class=\"kana\" lang=\"ja\">おじいさん</span><span class=\"k-wz\">祖父；爷爷；老年男性；老头儿</span></li><li><span class=\"k-w\" lang=\"ja\">祖父</span><span class=\"kana\" lang=\"ja\">そふ</span><span class=\"k-wz\">祖父；爷爷；老人；老汉；狂言老人面具</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">雨</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/kanji/\">N5</a>雨</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あめ・あま-・-さめ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">雨</span><span class=\"kana\" lang=\"ja\">あめ</span><span class=\"k-wz\">雨；雨天；阴雨天气；花札十一月组</span></li><li><span class=\"k-w\" lang=\"ja\">梅雨</span><span class=\"kana\" lang=\"ja\">つゆ</span><span class=\"k-wz\">梅雨季节；雨季（东亚地区，在日本通常从6月初到7月中旬）；梅雨</span></li><li><span class=\"k-w\" lang=\"ja\">雨戸</span><span class=\"kana\" lang=\"ja\">あまど</span><span class=\"k-wz\">滑动式防风雨窗板；推拉式防暴风雨隔板</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">丈</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/kanji/\">N5</a>长度；身高；仅；十尺；丈</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たけ・だけ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">丈夫</span><span class=\"kana\" lang=\"ja\">じょうふ</span><span class=\"k-wz\">英雄；男子汉；勇士</span></li><li><span class=\"k-w\" lang=\"ja\">大丈夫</span><span class=\"kana\" lang=\"ja\">だいじょうぶ</span><span class=\"k-wz\">安全；牢靠；稳妥；无虑；没问题；没关系；确实；必然；无疑；不用了；谢了；算了；大丈夫；堂堂正正的男子汉</span></li><li><span class=\"k-w\" lang=\"ja\">丈</span><span class=\"kana\" lang=\"ja\">たけ</span><span class=\"k-wz\">身高；身材；（衣物的）长度；全部；所有；（和歌等的）雄浑；壮美</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">誰</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/kanji/\">N5</a>谁；某人</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">スイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">だれ・たれ・た</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">誰</span><span class=\"kana\" lang=\"ja\">だれ</span><span class=\"k-wz\">谁</span></li><li><span class=\"k-w\" lang=\"ja\">誰か</span><span class=\"kana\" lang=\"ja\">だれか</span><span class=\"k-wz\">某人；某个人</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">貼</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../n5/kanji/\">N5</a>粘贴；附着；贴附</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">テン・チョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">は.る・つ.く</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">貼る</span><span class=\"kana\" lang=\"ja\">はる</span><span class=\"k-wz\">粘贴；贴上；粘附；拉伸；展开；绷紧；张开；搭建；形成（如池塘结冰）；充盈；肿胀；伸出；突出；发布；张贴（链接等）；昂贵；价高；监视；留意；守望；拍打；扇打；听牌；（数学）张成；生成</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">会</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>会；见面</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あ（う）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">会社</span><span class=\"kana\" lang=\"ja\">かいしゃ</span><span class=\"k-wz\">公司</span></li><li><span class=\"k-w\" lang=\"ja\">会う</span><span class=\"kana\" lang=\"ja\">あう</span><span class=\"k-wz\">见面</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">社</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>社</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シャ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">やしろ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">社長</span><span class=\"kana\" lang=\"ja\">しゃちょう</span><span class=\"k-wz\">总经理；社长</span></li><li><span class=\"k-w\" lang=\"ja\">社会</span><span class=\"kana\" lang=\"ja\">しゃかい</span><span class=\"k-wz\">社会</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">仕</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>做事；侍奉</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つか（える）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">仕事</span><span class=\"kana\" lang=\"ja\">しごと</span><span class=\"k-wz\">工作</span></li><li><span class=\"k-w\" lang=\"ja\">仕方</span><span class=\"kana\" lang=\"ja\">しかた</span><span class=\"k-wz\">方法；办法</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">事</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>事</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">こと</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">食事</span><span class=\"kana\" lang=\"ja\">しょくじ</span><span class=\"k-wz\">用餐</span></li><li><span class=\"k-w\" lang=\"ja\">大事</span><span class=\"kana\" lang=\"ja\">だいじ</span><span class=\"k-wz\">重要</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">家</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>家</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カ・ケ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いえ・や</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">家庭</span><span class=\"kana\" lang=\"ja\">かてい</span><span class=\"k-wz\">家庭</span></li><li><span class=\"k-w\" lang=\"ja\">家</span><span class=\"kana\" lang=\"ja\">いえ</span><span class=\"k-wz\">家；房子</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">族</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>族</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ゾク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">—</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">家族</span><span class=\"kana\" lang=\"ja\">かぞく</span><span class=\"k-wz\">家人</span></li><li><span class=\"k-w\" lang=\"ja\">民族</span><span class=\"kana\" lang=\"ja\">みんぞく</span><span class=\"k-wz\">民族</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">親</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>父母；亲</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おや・した（しい）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">両親</span><span class=\"kana\" lang=\"ja\">りょうしん</span><span class=\"k-wz\">父母</span></li><li><span class=\"k-w\" lang=\"ja\">親切</span><span class=\"kana\" lang=\"ja\">しんせつ</span><span class=\"k-wz\">热心；亲切</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">切</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>切</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">き（る）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">大切</span><span class=\"kana\" lang=\"ja\">たいせつ</span><span class=\"k-wz\">重要；珍惜</span></li><li><span class=\"k-w\" lang=\"ja\">切手</span><span class=\"kana\" lang=\"ja\">きって</span><span class=\"k-wz\">邮票</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">急</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>急</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いそ（ぐ）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">急行</span><span class=\"kana\" lang=\"ja\">きゅうこう</span><span class=\"k-wz\">快车</span></li><li><span class=\"k-w\" lang=\"ja\">急ぐ</span><span class=\"kana\" lang=\"ja\">いそぐ</span><span class=\"k-wz\">赶紧</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">始</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>开始</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はじ（める）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">始める</span><span class=\"kana\" lang=\"ja\">はじめる</span><span class=\"k-wz\">开始（他动）</span></li><li><span class=\"k-w\" lang=\"ja\">開始</span><span class=\"kana\" lang=\"ja\">かいし</span><span class=\"k-wz\">开始（名词）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">終</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>结束</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">お（わる）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">終わる</span><span class=\"kana\" lang=\"ja\">おわる</span><span class=\"k-wz\">结束</span></li><li><span class=\"k-w\" lang=\"ja\">最終</span><span class=\"kana\" lang=\"ja\">さいしゅう</span><span class=\"k-wz\">最后；末班</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">教</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>教</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おし（える）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">教育</span><span class=\"kana\" lang=\"ja\">きょういく</span><span class=\"k-wz\">教育</span></li><li><span class=\"k-w\" lang=\"ja\">教える</span><span class=\"kana\" lang=\"ja\">おしえる</span><span class=\"k-wz\">教；告诉</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">室</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>室</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">—</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">教室</span><span class=\"kana\" lang=\"ja\">きょうしつ</span><span class=\"k-wz\">教室</span></li><li><span class=\"k-w\" lang=\"ja\">会議室</span><span class=\"kana\" lang=\"ja\">かいぎしつ</span><span class=\"k-wz\">会议室</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">旅</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>旅行</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">リョ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たび</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">旅行</span><span class=\"kana\" lang=\"ja\">りょこう</span><span class=\"k-wz\">旅行</span></li><li><span class=\"k-w\" lang=\"ja\">旅館</span><span class=\"kana\" lang=\"ja\">りょかん</span><span class=\"k-wz\">日式旅馆</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">写</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>抄；拍</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シャ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">うつ（す）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">写真</span><span class=\"kana\" lang=\"ja\">しゃしん</span><span class=\"k-wz\">照片</span></li><li><span class=\"k-w\" lang=\"ja\">写す</span><span class=\"kana\" lang=\"ja\">うつす</span><span class=\"k-wz\">抄写；拍摄</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">真</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>真</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ま</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">真ん中</span><span class=\"kana\" lang=\"ja\">まんなか</span><span class=\"k-wz\">正中间</span></li><li><span class=\"k-w\" lang=\"ja\">真面目</span><span class=\"kana\" lang=\"ja\">まじめ</span><span class=\"k-wz\">认真</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">映</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>映</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">エイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">うつ（る）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">映画</span><span class=\"kana\" lang=\"ja\">えいが</span><span class=\"k-wz\">电影</span></li><li><span class=\"k-w\" lang=\"ja\">映る</span><span class=\"kana\" lang=\"ja\">うつる</span><span class=\"k-wz\">映出</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">画</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>画</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ガ・カク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">—</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">計画</span><span class=\"kana\" lang=\"ja\">けいかく</span><span class=\"k-wz\">计划</span></li><li><span class=\"k-w\" lang=\"ja\">画家</span><span class=\"kana\" lang=\"ja\">がか</span><span class=\"k-wz\">画家</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">病</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>病</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ビョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">やまい</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">病気</span><span class=\"kana\" lang=\"ja\">びょうき</span><span class=\"k-wz\">生病；疾病</span></li><li><span class=\"k-w\" lang=\"ja\">病院</span><span class=\"kana\" lang=\"ja\">びょういん</span><span class=\"k-wz\">医院</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">院</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>院</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">イン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">—</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">入院</span><span class=\"kana\" lang=\"ja\">にゅういん</span><span class=\"k-wz\">住院</span></li><li><span class=\"k-w\" lang=\"ja\">退院</span><span class=\"kana\" lang=\"ja\">たいいん</span><span class=\"k-wz\">出院</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">同</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>相同；一致；平等</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ドウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おな.じ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">同じ</span><span class=\"kana\" lang=\"ja\">おなじ</span><span class=\"k-wz\">相同；一样；相等；相似；等同；无论如何；总之；如果一定要；既然</span></li><li><span class=\"k-w\" lang=\"ja\">共同</span><span class=\"kana\" lang=\"ja\">きょうどう</span><span class=\"k-wz\">合作；协作；联合；伙伴关系；一致行动；共同体；公共使用；共同拥有；共用</span></li><li><span class=\"k-w\" lang=\"ja\">同一</span><span class=\"kana\" lang=\"ja\">どういつ</span><span class=\"k-wz\">相同；一致；同一；相等；平等；公平对待；无差别</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">自</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>自身；自己；自然；自发</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジ・シ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">みずか.ら・おの.ずから・おの.ずと</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">自分</span><span class=\"kana\" lang=\"ja\">じぶん</span><span class=\"k-wz\">自己；自身；本人；我；本人；你；您</span></li><li><span class=\"k-w\" lang=\"ja\">自転車</span><span class=\"kana\" lang=\"ja\">じてんしゃ</span><span class=\"k-wz\">自行车；脚踏车</span></li><li><span class=\"k-w\" lang=\"ja\">自動車</span><span class=\"kana\" lang=\"ja\">じどうしゃ</span><span class=\"k-wz\">汽车；轿车；机动车</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">発</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>发射；出发；揭发；发表；（枪炮）发</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ハツ・ホツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">た.つ・あば.く・おこ.る・つか.わす・はな.つ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">出発</span><span class=\"kana\" lang=\"ja\">しゅっぱつ</span><span class=\"k-wz\">出发；离开；启程</span></li><li><span class=\"k-w\" lang=\"ja\">発音</span><span class=\"kana\" lang=\"ja\">はつおん</span><span class=\"k-wz\">发音；声音产生；发声</span></li><li><span class=\"k-w\" lang=\"ja\">爆発</span><span class=\"kana\" lang=\"ja\">ばくはつ</span><span class=\"k-wz\">爆炸；爆发；（情绪的）爆发；（愤怒的）爆发；（不满的）爆发</span></li></ul></div></li>"]