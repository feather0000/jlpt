["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">娘</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>女儿；少女</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">むすめ・こ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">娘</span><span class=\"kana\" lang=\"ja\">むすめ</span><span class=\"k-wz\">女儿；女孩；少女；未婚女性</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">誤</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>错误；失误；过错；误导</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ゴ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あやま.る・-あやま.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">誤り</span><span class=\"kana\" lang=\"ja\">あやまり</span><span class=\"k-wz\">错误；失误；过失；漏洞</span></li><li><span class=\"k-w\" lang=\"ja\">誤解</span><span class=\"kana\" lang=\"ja\">ごかい</span><span class=\"k-wz\">误解；误会</span></li><li><span class=\"k-w\" lang=\"ja\">誤る</span><span class=\"kana\" lang=\"ja\">あやまる</span><span class=\"k-wz\">犯错；出错；做错；弄错；错误；不对；不正确；有误；误导；引入歧途；带坏</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">洗</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>洗；调查；探究</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あら.う</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">洗う</span><span class=\"kana\" lang=\"ja\">あらう</span><span class=\"k-wz\">洗；冲洗；漂洗；追查；调查；追究；净化（心灵）；洗涤（心灵）；冲刷；拍打；席卷</span></li><li><span class=\"k-w\" lang=\"ja\">洗濯</span><span class=\"kana\" lang=\"ja\">せんたく</span><span class=\"k-wz\">洗衣；洗涤；放松；消除（忧虑、疲劳等）</span></li><li><span class=\"k-w\" lang=\"ja\">お手洗い</span><span class=\"kana\" lang=\"ja\">おてあらい</span><span class=\"k-wz\">厕所；盥洗室；洗手间</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">畑</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>田地；旱田；农田；菜园；专长</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\"></dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はた・はたけ・-ばたけ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">畑</span><span class=\"kana\" lang=\"ja\">はたけ</span><span class=\"k-wz\">田地；菜地；果园；种植地；领域；范围；专业；行业；子宫；出生地；出身</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">慣</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>习惯；适应；熟练</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">な.れる・な.らす</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">習慣</span><span class=\"kana\" lang=\"ja\">しゅうかん</span><span class=\"k-wz\">习惯</span></li><li><span class=\"k-w\" lang=\"ja\">慣れる</span><span class=\"kana\" lang=\"ja\">なれる</span><span class=\"k-wz\">习惯</span></li><li><span class=\"k-w\" lang=\"ja\">見慣れる</span><span class=\"kana\" lang=\"ja\">みなれる</span><span class=\"k-wz\">习惯看到；习惯于见到；对...很熟悉</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">礼</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>敬礼；鞠躬；仪式；感谢；报酬</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">レイ・ライ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">お礼</span><span class=\"kana\" lang=\"ja\">おれい</span><span class=\"k-wz\">感谢；谢意；礼仪；礼节；鞠躬；报酬；礼物；仪式；礼仪</span></li><li><span class=\"k-w\" lang=\"ja\">礼</span><span class=\"kana\" lang=\"ja\">れい</span><span class=\"k-wz\">感谢；谢意；礼仪；礼节；礼貌；鞠躬；酬金；礼物；仪式；典礼；祭礼；礼金</span></li><li><span class=\"k-w\" lang=\"ja\">礼儀</span><span class=\"kana\" lang=\"ja\">れいぎ</span><span class=\"k-wz\">礼仪；礼节；礼貌</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">窓</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>窗户；窗格</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソウ・ス</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">まど・てんまど・けむだし</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">窓</span><span class=\"kana\" lang=\"ja\">まど</span><span class=\"k-wz\">窗；窗户</span></li><li><span class=\"k-w\" lang=\"ja\">窓口</span><span class=\"kana\" lang=\"ja\">まどぐち</span><span class=\"k-wz\">窗口；柜台；售票窗口；联系人；联络窗口</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">昔</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>往昔；古代；从前</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セキ・シャク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">むかし</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">昔</span><span class=\"kana\" lang=\"ja\">むかし</span><span class=\"k-wz\">往昔；过去；昔日；从前；过去十年；近十年</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">貧</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>贫穷；贫乏</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヒン・ビン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">まず.しい</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">貧しい</span><span class=\"kana\" lang=\"ja\">まずしい</span><span class=\"k-wz\">贫穷；贫困；贫乏；缺乏；不足；稀少；微薄；不足</span></li><li><span class=\"k-w\" lang=\"ja\">貧困</span><span class=\"kana\" lang=\"ja\">ひんこん</span><span class=\"k-wz\">贫困；赤贫；贫乏；穷困；短缺；缺乏；不足</span></li><li><span class=\"k-w\" lang=\"ja\">貧弱</span><span class=\"kana\" lang=\"ja\">ひんじゃく</span><span class=\"k-wz\">贫弱；瘦弱；微薄；简陋；不充实</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">怒</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>愤怒；生气；发怒</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ド・ヌ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いか.る・おこ.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">怒る</span><span class=\"kana\" lang=\"ja\">いかる</span><span class=\"k-wz\">生气；发怒；棱角分明；方正</span></li><li><span class=\"k-w\" lang=\"ja\">怒り</span><span class=\"kana\" lang=\"ja\">いかり</span><span class=\"k-wz\">愤怒；怒气；狂怒；愤慨</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">泳</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>游泳</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">エイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">およ.ぐ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">泳ぐ</span><span class=\"kana\" lang=\"ja\">およぐ</span><span class=\"k-wz\">游泳；挤过；穿过（人群）；在世上立足；谋生；混世；蹒跚；踉跄；失去平衡</span></li><li><span class=\"k-w\" lang=\"ja\">水泳</span><span class=\"kana\" lang=\"ja\">すいえい</span><span class=\"k-wz\">游泳</span></li><li><span class=\"k-w\" lang=\"ja\">泳ぎ方</span><span class=\"kana\" lang=\"ja\">およぎかた</span><span class=\"k-wz\">游泳方式；泳姿</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">祖</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>祖先；先驱；创始人</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">お祖父さん</span><span class=\"kana\" lang=\"ja\">おじいさん</span><span class=\"k-wz\">祖父；爷爷；老年男性；老头儿</span></li><li><span class=\"k-w\" lang=\"ja\">祖父</span><span class=\"kana\" lang=\"ja\">そふ</span><span class=\"k-wz\">祖父；爷爷；老人；老汉；狂言老人面具</span></li><li><span class=\"k-w\" lang=\"ja\">祖母</span><span class=\"kana\" lang=\"ja\">そぼ</span><span class=\"k-wz\">祖母；外婆；奶奶</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">杯</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>酒杯；杯（计量单位）；干杯</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ハイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さかずき</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">乾杯</span><span class=\"kana\" lang=\"ja\">かんぱい</span><span class=\"k-wz\">干杯；敬酒；为某人或某事祝酒；干杯；一饮而尽；喝干杯中酒</span></li><li><span class=\"k-w\" lang=\"ja\">杯</span><span class=\"kana\" lang=\"ja\">さかずき</span><span class=\"k-wz\">酒杯；盛酒的杯子；交杯；以杯酒交换来确认盟约或誓言</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">疲</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>疲劳；疲倦；累</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヒ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つか.れる・-づか.れ・つか.らす</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">疲れる</span><span class=\"kana\" lang=\"ja\">つかれる</span><span class=\"k-wz\">疲劳；疲倦；劳累；疲惫；磨损；磨旧；挨饿；饥饿</span></li><li><span class=\"k-w\" lang=\"ja\">疲れ</span><span class=\"kana\" lang=\"ja\">つかれ</span><span class=\"k-wz\">疲劳；疲倦；倦怠</span></li><li><span class=\"k-w\" lang=\"ja\">疲労</span><span class=\"kana\" lang=\"ja\">ひろう</span><span class=\"k-wz\">疲劳；疲倦；劳累；倦怠；（金属等的）疲劳；材料疲劳</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">皆</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>全部；大家；所有</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">みな・みんな</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">皆さん</span><span class=\"kana\" lang=\"ja\">みなさん</span><span class=\"k-wz\">大家；各位；诸位</span></li><li><span class=\"k-w\" lang=\"ja\">皆</span><span class=\"kana\" lang=\"ja\">みな</span><span class=\"k-wz\">所有人；大家；人人；所有东西；一切</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">鳴</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>鸣叫；发声；响；使响；啼叫</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">メイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">な.く・な.る・な.らす</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">鳴く</span><span class=\"kana\" lang=\"ja\">なく</span><span class=\"k-wz\">（动物）发出声音；叫；鸣；呜；唱；啁啾；（麻将）鸣牌；吃、碰、杠</span></li><li><span class=\"k-w\" lang=\"ja\">鳴る</span><span class=\"kana\" lang=\"ja\">なる</span><span class=\"k-wz\">发出声音；鸣响；回响；呼啸；隆隆作响</span></li><li><span class=\"k-w\" lang=\"ja\">鳴らす</span><span class=\"kana\" lang=\"ja\">ならす</span><span class=\"k-wz\">鸣响；敲；打；喷（鼻）；弹（手指）；崩（关节）；出名；受尊敬；有名望；述说；坚持；抱怨；放屁（大声地）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">腹</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>腹部；肚子；胃</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">フク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はら</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">腹</span><span class=\"kana\" lang=\"ja\">はら</span><span class=\"k-wz\">腹部；肚子；胃；子宫；胎内；心意；真实意图；真实动机；勇气；胆量；意志力；慷慨；宽宏大量；感情；情感；宽阔的中间部分；凸起的部分；内部；内里；里面；波腹；鱼子计数；鼓腹容器（罐、瓶等）计数</span></li><li><span class=\"k-w\" lang=\"ja\">空腹</span><span class=\"kana\" lang=\"ja\">くうふく</span><span class=\"k-wz\">空腹；饥饿</span></li><li><span class=\"k-w\" lang=\"ja\">山腹</span><span class=\"kana\" lang=\"ja\">さんぷく</span><span class=\"k-wz\">山腰；山坡</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">煙</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>烟；冒烟；烟草</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">エン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">けむ.る・けむり・けむ.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">煙</span><span class=\"kana\" lang=\"ja\">けむり</span><span class=\"k-wz\">烟；烟雾</span></li><li><span class=\"k-w\" lang=\"ja\">禁煙</span><span class=\"kana\" lang=\"ja\">きんえん</span><span class=\"k-wz\">戒烟；禁止吸烟；禁烟；（告示牌用语）禁止吸烟；请勿吸烟</span></li><li><span class=\"k-w\" lang=\"ja\">煙突</span><span class=\"kana\" lang=\"ja\">えんとつ</span><span class=\"k-wz\">烟囱；烟筒；（船的）烟囱；炉管；不打表载客</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">眠</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>睡觉；困倦；死亡</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ミン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ねむ.る・ねむ.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">眠い</span><span class=\"kana\" lang=\"ja\">ねむい</span><span class=\"k-wz\">困倦的；打瞌睡的；昏昏欲睡的</span></li><li><span class=\"k-w\" lang=\"ja\">眠る</span><span class=\"kana\" lang=\"ja\">ねむる</span><span class=\"k-wz\">睡眠；入睡；死亡；长眠；安息；闲置；未被利用；未被开发；闭眼；合眼</span></li><li><span class=\"k-w\" lang=\"ja\">睡眠</span><span class=\"kana\" lang=\"ja\">すいみん</span><span class=\"k-wz\">睡眠</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">怖</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>可怕；恐惧；害怕；畏惧</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">フ・ホ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">こわ.い・こわ.がる・お.じる・おそ.れる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">怖い</span><span class=\"kana\" lang=\"ja\">こわい</span><span class=\"k-wz\">可怕；令人恐惧；诡异；令人害怕</span></li><li><span class=\"k-w\" lang=\"ja\">恐怖</span><span class=\"kana\" lang=\"ja\">きょうふ</span><span class=\"k-wz\">恐惧；害怕；惊恐；恐怖；惊吓；惶恐</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">耳</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>耳朵</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">みみ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">耳</span><span class=\"kana\" lang=\"ja\">みみ</span><span class=\"k-wz\">耳；听觉；听力；音感；乐感；边缘；面包皮；奶酪皮；织边；壶耳；罐耳；把手</span></li><li><span class=\"k-w\" lang=\"ja\">初耳</span><span class=\"kana\" lang=\"ja\">はつみみ</span><span class=\"k-wz\">初次听到；头一次听说</span></li><li><span class=\"k-w\" lang=\"ja\">耳鼻科</span><span class=\"kana\" lang=\"ja\">じびか</span><span class=\"k-wz\">耳鼻科；耳鼻喉科</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">頂</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>顶；戴（在头上）；接受；山顶；顶峰</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">チョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いただ.く・いただき</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">頂上</span><span class=\"kana\" lang=\"ja\">ちょうじょう</span><span class=\"k-wz\">顶端；顶点；峰顶</span></li><li><span class=\"k-w\" lang=\"ja\">頂点</span><span class=\"kana\" lang=\"ja\">ちょうてん</span><span class=\"k-wz\">顶点；尖端；山顶；峰顶；最高点；业界最高层；领域顶峰；高峰；巅峰；极点；鼎盛</span></li><li><span class=\"k-w\" lang=\"ja\">頂</span><span class=\"kana\" lang=\"ja\">いただき</span><span class=\"k-wz\">头顶；山顶；尖顶；轻松取胜；所得之物；收获</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">箱</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>箱子；盒子；匣子；容器；车厢</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はこ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">箱</span><span class=\"kana\" lang=\"ja\">はこ</span><span class=\"k-wz\">箱子；盒子；柜子；包裹；包装；板条箱；（火车等的）车厢；三味线套；三味线；公共建筑；社区建筑；为艺妓携带三味线的男性；人类排泄物容器；粪便；箱（或盒装物品的计数单位）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">晩</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>夜晚；傍晚</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">バン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">晩</span><span class=\"kana\" lang=\"ja\">ばん</span><span class=\"k-wz\">晚上；夜晚；晚餐；晚饭；夜（计数单位）</span></li><li><span class=\"k-w\" lang=\"ja\">今晩</span><span class=\"kana\" lang=\"ja\">こんばん</span><span class=\"k-wz\">今晚；今天晚上</span></li><li><span class=\"k-w\" lang=\"ja\">毎晩</span><span class=\"kana\" lang=\"ja\">まいばん</span><span class=\"k-wz\">每晚；每天晚上</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">寒</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>寒冷；冷</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さむ.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">寒い</span><span class=\"kana\" lang=\"ja\">さむい</span><span class=\"k-wz\">寒冷；冷；无聊；冷；乏味；老套</span></li><li><span class=\"k-w\" lang=\"ja\">寒帯</span><span class=\"kana\" lang=\"ja\">かんたい</span><span class=\"k-wz\">寒带</span></li><li><span class=\"k-w\" lang=\"ja\">寒気</span><span class=\"kana\" lang=\"ja\">かんき</span><span class=\"k-wz\">寒冷；冷气；寒气</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">髪</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>头发</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ハツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かみ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">髪</span><span class=\"kana\" lang=\"ja\">かみ</span><span class=\"k-wz\">头发</span></li><li><span class=\"k-w\" lang=\"ja\">髪の毛</span><span class=\"kana\" lang=\"ja\">かみのけ</span><span class=\"k-wz\">头发；（一根）头发</span></li><li><span class=\"k-w\" lang=\"ja\">白髪</span><span class=\"kana\" lang=\"ja\">しらが</span><span class=\"k-wz\">白发；灰白的头发</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">忙</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>忙碌；繁忙；不安；忧虑</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボウ・モウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いそが.しい・せわ.しい・おそ.れる・うれえるさま</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">忙しい</span><span class=\"kana\" lang=\"ja\">いそがしい</span><span class=\"k-wz\">忙碌；繁忙；忙乱；坐立不安；匆忙；慌张；静不下来</span></li><li><span class=\"k-w\" lang=\"ja\">多忙</span><span class=\"kana\" lang=\"ja\">たぼう</span><span class=\"k-wz\">非常繁忙；忙碌</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">才</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>天才；年龄；才（体积单位，1立方尺约0.0278立方米）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">サイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">才能</span><span class=\"kana\" lang=\"ja\">さいのう</span><span class=\"k-wz\">才能；才华；能力</span></li><li><span class=\"k-w\" lang=\"ja\">天才</span><span class=\"kana\" lang=\"ja\">てんさい</span><span class=\"k-wz\">天才；天赋异禀；奇才</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">粧</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>化妆；装饰</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">化粧</span><span class=\"kana\" lang=\"ja\">けしょう</span><span class=\"k-wz\">化妆；化妆品；彩妆；装饰；修饰；掩饰；虚饰</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">靴</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>鞋</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">くつ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">靴</span><span class=\"kana\" lang=\"ja\">くつ</span><span class=\"k-wz\">鞋；靴子；鞋类；鞋靴</span></li><li><span class=\"k-w\" lang=\"ja\">靴下</span><span class=\"kana\" lang=\"ja\">くつした</span><span class=\"k-wz\">袜子；短袜；长袜</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">恥</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>羞耻；耻辱；羞愧；丢脸</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">チ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lan