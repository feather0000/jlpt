["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">服</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>衣服；服从；承担；服用（药物）；使（某人）服从</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">フク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">服</span><span class=\"kana\" lang=\"ja\">ふく</span><span class=\"k-wz\">衣服；衣着；服装；套装；穿着；服；剂；口（计量药剂、饮茶、吸烟次数的量词）</span></li><li><span class=\"k-w\" lang=\"ja\">洋服</span><span class=\"kana\" lang=\"ja\">ようふく</span><span class=\"k-wz\">西服；洋装；西式服装</span></li><li><span class=\"k-w\" lang=\"ja\">衣服</span><span class=\"kana\" lang=\"ja\">いふく</span><span class=\"k-wz\">衣服；衣着；服装</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">夕</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>傍晚</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セキ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ゆう</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">夕方</span><span class=\"kana\" lang=\"ja\">ゆうがた</span><span class=\"k-wz\">傍晚；黄昏（通常指下午三点至六点）</span></li><li><span class=\"k-w\" lang=\"ja\">夕飯</span><span class=\"kana\" lang=\"ja\">ゆうはん</span><span class=\"k-wz\">晚餐；晚饭；夜饭</span></li><li><span class=\"k-w\" lang=\"ja\">夕べ</span><span class=\"kana\" lang=\"ja\">ゆうべ</span><span class=\"k-wz\">傍晚；黄昏；（特殊活动的）夜晚；昨晚；昨天傍晚</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">借</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>借入；租借</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シャク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">か.りる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">借りる</span><span class=\"kana\" lang=\"ja\">かりる</span><span class=\"k-wz\">借用；租借；租用；雇用；借助；利用（他人的帮助、智慧等）；挪作他用；改作他用</span></li><li><span class=\"k-w\" lang=\"ja\">借金</span><span class=\"kana\" lang=\"ja\">しゃっきん</span><span class=\"k-wz\">债务；贷款；负债；借款；（棒球）负场多于胜场的场数差；负胜差</span></li><li><span class=\"k-w\" lang=\"ja\">借り</span><span class=\"kana\" lang=\"ja\">かり</span><span class=\"k-wz\">借款；债务；贷款</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">曜</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>星期</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヨウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">火曜日</span><span class=\"kana\" lang=\"ja\">かようび</span><span class=\"k-wz\">星期二</span></li><li><span class=\"k-w\" lang=\"ja\">金曜日</span><span class=\"kana\" lang=\"ja\">きんようび</span><span class=\"k-wz\">星期五</span></li><li><span class=\"k-w\" lang=\"ja\">月曜日</span><span class=\"kana\" lang=\"ja\">げつようび</span><span class=\"k-wz\">星期一</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">飲</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>喝；吸（烟）；服用</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">イン・オン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">の.む・-の.み</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">飲む</span><span class=\"kana\" lang=\"ja\">のむ</span><span class=\"k-wz\">喝</span></li><li><span class=\"k-w\" lang=\"ja\">飲み物</span><span class=\"kana\" lang=\"ja\">のみもの</span><span class=\"k-wz\">饮料；饮品</span></li><li><span class=\"k-w\" lang=\"ja\">湯飲み</span><span class=\"kana\" lang=\"ja\">ゆのみ</span><span class=\"k-wz\">茶杯；茶盏</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">肉</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>肉；肉类</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ニク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">しし</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">肉</span><span class=\"kana\" lang=\"ja\">にく</span><span class=\"k-wz\">肉；肉；荤；果肉；果实的肉质部分；肉体；血肉之躯（相对于精神）；厚度；厚实的程度；内容；实质；内在的东西；印泥</span></li><li><span class=\"k-w\" lang=\"ja\">牛肉</span><span class=\"kana\" lang=\"ja\">ぎゅうにく</span><span class=\"k-wz\">牛肉</span></li><li><span class=\"k-w\" lang=\"ja\">鶏肉</span><span class=\"kana\" lang=\"ja\">とりにく</span><span class=\"k-wz\">鸡肉；家禽肉；禽肉</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">貸</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>借出；出借</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">タイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">か.す・か.し-・かし-</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">貸す</span><span class=\"kana\" lang=\"ja\">かす</span><span class=\"k-wz\">出借；借出；出租；租出；交给；递给</span></li><li><span class=\"k-w\" lang=\"ja\">貸し</span><span class=\"kana\" lang=\"ja\">かし</span><span class=\"k-wz\">借贷；出租；租赁；人情；恩惠；债务；义务；债权人；借贷方式；贷方</span></li><li><span class=\"k-w\" lang=\"ja\">貸間</span><span class=\"kana\" lang=\"ja\">かしま</span><span class=\"k-wz\">出租房间；可出租的房间</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">堂</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>厅堂；殿堂</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ドウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">食堂</span><span class=\"kana\" lang=\"ja\">しょくどう</span><span class=\"k-wz\">食堂；餐厅；饭厅；餐馆；餐厅；小吃店</span></li><li><span class=\"k-w\" lang=\"ja\">講堂</span><span class=\"kana\" lang=\"ja\">こうどう</span><span class=\"k-wz\">礼堂；讲堂</span></li><li><span class=\"k-w\" lang=\"ja\">堂々</span><span class=\"kana\" lang=\"ja\">どうどう</span><span class=\"k-wz\">堂皇；宏大；气派；庄严；雄伟；威严；肃穆；光明正大；坦荡；公开；理直气壮；厚颜无耻；堂堂正正地；大胆地；自信地；光明正大地；坦率地；毫无保留地；厚颜无耻地</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">鳥</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>鸟；鸡</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">チョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">とり</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">鳥</span><span class=\"kana\" lang=\"ja\">とり</span><span class=\"k-wz\">鸟；鸡肉；禽肉；家禽</span></li><li><span class=\"k-w\" lang=\"ja\">小鳥</span><span class=\"kana\" lang=\"ja\">ことり</span><span class=\"k-wz\">小鸟；小鸟儿</span></li><li><span class=\"k-w\" lang=\"ja\">鳥居</span><span class=\"kana\" lang=\"ja\">とりい</span><span class=\"k-wz\">鸟居（神社的牌坊门）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">飯</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>米饭；饭食</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ハン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">めし</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">御飯</span><span class=\"kana\" lang=\"ja\">ごはん</span><span class=\"k-wz\">米饭；煮好的饭；餐；饭食</span></li><li><span class=\"k-w\" lang=\"ja\">夕飯</span><span class=\"kana\" lang=\"ja\">ゆうはん</span><span class=\"k-wz\">晚餐；晚饭；夜饭</span></li><li><span class=\"k-w\" lang=\"ja\">晩御飯</span><span class=\"kana\" lang=\"ja\">ばんごはん</span><span class=\"k-wz\">晚餐；晚饭</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">勉</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>努力；勤奋；尽力；鼓励；勉励</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ベン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つと.める</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">勉強</span><span class=\"kana\" lang=\"ja\">べんきょう</span><span class=\"k-wz\">学习；研究；勤奋；刻苦；经验；教训；折扣；优惠；降价</span></li><li><span class=\"k-w\" lang=\"ja\">勤勉</span><span class=\"kana\" lang=\"ja\">きんべん</span><span class=\"k-wz\">勤勉；勤奋；刻苦</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">冬</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>冬季</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ふゆ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">冬</span><span class=\"kana\" lang=\"ja\">ふゆ</span><span class=\"k-wz\">冬季；冬天</span></li><li><span class=\"k-w\" lang=\"ja\">冬眠</span><span class=\"kana\" lang=\"ja\">とうみん</span><span class=\"k-wz\">冬眠；冬季休眠；蛰伏</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">昼</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>白天；中午</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">チュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ひる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">昼</span><span class=\"kana\" lang=\"ja\">ひる</span><span class=\"k-wz\">正午；中午；白天；日间；午餐；午饭</span></li><li><span class=\"k-w\" lang=\"ja\">昼御飯</span><span class=\"kana\" lang=\"ja\">ひるごはん</span><span class=\"k-wz\">午餐；中餐；午饭</span></li><li><span class=\"k-w\" lang=\"ja\">昼間</span><span class=\"kana\" lang=\"ja\">ひるま</span><span class=\"k-wz\">白天；日间；白昼；从日出到日落的时间</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">茶</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>茶</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">チャ・サ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">お茶</span><span class=\"kana\" lang=\"ja\">おちゃ</span><span class=\"k-wz\">茶（尤指绿茶或麦茶）；茶歇；茶点时间；茶道</span></li><li><span class=\"k-w\" lang=\"ja\">紅茶</span><span class=\"kana\" lang=\"ja\">こうちゃ</span><span class=\"k-wz\">红茶</span></li><li><span class=\"k-w\" lang=\"ja\">茶色</span><span class=\"kana\" lang=\"ja\">ちゃいろ</span><span class=\"k-wz\">褐色；浅褐色；棕色</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">弟</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>弟弟；弟子</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">テイ・ダイ・デ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おとうと</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">弟</span><span class=\"kana\" lang=\"ja\">おと</span><span class=\"k-wz\">（古）（哥哥的）弟弟；（姐姐的）妹妹；最小的孩子；老幺；年轻的；较年轻的；最年轻的；年轻貌美；娇俏可爱</span></li><li><span class=\"k-w\" lang=\"ja\">兄弟</span><span class=\"kana\" lang=\"ja\">きょうだい</span><span class=\"k-wz\">兄弟姐妹；手足；同父异母（或同母异父）的兄弟姐妹；继兄弟姐妹；养兄弟姐妹；伙伴；朋友</span></li><li><span class=\"k-w\" lang=\"ja\">従兄弟</span><span class=\"kana\" lang=\"ja\">いとこ</span><span class=\"k-wz\">男表亲；男堂兄弟</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">牛</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>牛</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ギュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">うし</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">牛肉</span><span class=\"kana\" lang=\"ja\">ぎゅうにく</span><span class=\"k-wz\">牛肉</span></li><li><span class=\"k-w\" lang=\"ja\">牛乳</span><span class=\"kana\" lang=\"ja\">ぎゅうにゅう</span><span class=\"k-wz\">牛奶</span></li><li><span class=\"k-w\" lang=\"ja\">牛</span><span class=\"kana\" lang=\"ja\">うし</span><span class=\"k-wz\">牛；黄牛；牝牛；公牛；阉牛；犊牛；牛肉；牛宿（二十八宿之一）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">魚</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>鱼</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ギョ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">うお・さかな・-ざかな</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">魚</span><span class=\"kana\" lang=\"ja\">さかな</span><span class=\"k-wz\">鱼</span></li><li><span class=\"k-w\" lang=\"ja\">金魚</span><span class=\"kana\" lang=\"ja\">きんぎょ</span><span class=\"k-wz\">金鱼</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">兄</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>兄长；哥哥</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケイ・キョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あに</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">兄</span><span class=\"kana\" lang=\"ja\">あに</span><span class=\"k-wz\">哥哥；兄长；大伯子；姐夫（配偶的兄长或姐姐的丈夫）</span></li><li><span class=\"k-w\" lang=\"ja\">兄弟</span><span class=\"kana\" lang=\"ja\">きょうだい</span><span class=\"k-wz\">兄弟姐妹；手足；同父异母（或同母异父）的兄弟姐妹；继兄弟姐妹；养兄弟姐妹；伙伴；朋友</span></li><li><span class=\"k-w\" lang=\"ja\">お兄さん</span><span class=\"kana\" lang=\"ja\">おにいさん</span><span class=\"k-wz\">哥哥；大哥；小伙子；哥们；老兄</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">犬</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>狗</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いぬ・いぬ-</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">犬</span><span class=\"kana\" lang=\"ja\">いぬ</span><span class=\"k-wz\">犬；狗；告密者；线人；奸细；内奸；失败者；混蛋；假的；劣质的；无用的；徒劳的</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">妹</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>妹妹</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">マイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いもうと</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">妹</span><span class=\"kana\" lang=\"ja\">いもうと</span><span class=\"k-wz\">妹妹</span></li><li><span class=\"k-w\" lang=\"ja\">従姉妹</span><span class=\"kana\" lang=\"ja\">いとこ</span><span class=\"k-wz\">女表亲；女堂姐妹</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">姉</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>姐姐</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あね・はは</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">姉</span><span class=\"kana\" lang=\"ja\">あね</span><span class=\"k-wz\">姐姐；姊姊</span></li><li><span class=\"k-w\" lang=\"ja\">お姉さん</span><span class=\"kana\" lang=\"ja\">おねえさん</span><span class=\"k-wz\">姐姐；大姐；年轻女性；小姐；（称呼女服务员等）小姐；服务员；姐姐（艺伎对前辈的敬称）；大姐姐；年长的女孩</span></li><li><span class=\"k-w\" lang=\"ja\">従姉妹</span><span class=\"kana\" lang=\"ja\">いとこ</span><span class=\"k-wz\">女表亲；女堂姐妹</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">漢</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>中国；汉族</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">漢字</span><span class=\"kana\" lang=\"ja\">かんじ</span><span class=\"k-wz\">汉字</span></li><li><span class=\"k-w\" lang=\"ja\">漢和</span><span class=\"kana\" lang=\"ja\">かんわ</span><span class=\"k-wz\">中国和日本；汉语和日语；汉和词典；汉字词典</span></li><li><span class=\"k-w\" lang=\"ja\">漢語</span><span class=\"kana\" lang=\"ja\">かんご</span><span class=\"k-wz\">汉语词；汉语借词；汉语；汉族语言</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">坊</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>男孩；僧侣住所；僧侣</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボウ・ボッ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">寝坊</span><span class=\"kana\" lang=\"ja\">ねぼう</span><span class=\"k-wz\">睡懒觉；睡过头；爱睡懒觉的人；贪睡的人</span></li><li><span class=\"k-w\" lang=\"ja\">赤ん坊</span><span class=\"kana\" lang=\"ja\">あかんぼう</span><span class=\"k-wz\">婴儿；婴幼儿</span></li><li><span class=\"k-w\" lang=\"ja\">坊や</span><span class=\"kana\" lang=\"ja\">ぼうや</span><span class=\"k-wz\">男孩；儿子；孩子；小男孩；毛头小伙；初出茅庐的人</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">凄</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>可怕；惊人；厉害；寒冷；荒凉</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セイ・サイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さむ.い・すご.い・すさ.まじい</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">凄い</span><span class=\"kana\" lang=\"ja\">すごい</span><span class=\"k-wz\">可怕的；令人惊恐的；惊人的；了不起的；非常棒的；极好的；数量庞大的；极其广大的；极其；非常；十分</span></li><li><span class=\"k-w\" lang=\"ja\">物凄い</span><span class=\"kana\" lang=\"ja\">ものすごい</span><span class=\"k-wz\">惊人的；巨大的；极端的；可怕的；恐怖的；令人毛骨悚然的</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">痩</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n4\" href=\"../n4/kanji/\">N4</a>变瘦；消瘦</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソウ・チュウ・シュウ・シュ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">や.せる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">痩せる</span><span class=\"kana\" lang=\"ja\">やせる</span><span class=\"k-wz\">变瘦；减肥；消瘦；（土壤）变贫瘠；变不毛；变荒芜</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">関</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>关</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">せき・かか（わる）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">関係</span><span class=\"kana\" lang=\"ja\">かんけい</span><span class=\"k-wz\">关系</span></li><li><span class=\"k-w\" lang=\"ja\">関心</span><span class=\"kana\" lang=\"ja\">かんしん</span><span class=\"k-wz\">关心；兴趣</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">係</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>系；负责人</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かかり</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">係員</span><span class=\"kana\" lang=\"ja\">かかりいん</span><span class=\"k-wz\">工作人员</span></li><li><span class=\"k-w\" lang=\"ja\">関係者</span><span class=\"kana\" lang=\"ja\">かんけいしゃ</span><span class=\"k-wz\">相关人员</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">原</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>原</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ゲン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はら</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">原因</span><span class=\"kana\" lang=\"ja\">げんいん</span><span class=\"k-wz\">原因</span></li><li><span class=\"k-w\" lang=\"ja\">原料</span><span class=\"kana\" lang=\"ja\">げんりょう</span><span class=\"k-wz\">原料</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">因</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>因</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">イン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">よ（る）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">要因</span><span class=\"kana\" lang=\"ja\">よういん</span><span class=\"k-wz\">因素；主要原因</span></li><li><span class=\"k-w\" lang=\"ja\">死因</span><span class=\"kana\" lang=\"ja\">しいん</span><span class=\"k-wz\">死因</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">結</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>结</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">むす（ぶ）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">結果</span><span class=\"kana\" lang=\"ja\">けっか</span><span class=\"k-wz\">结果</span></li><li><span class=\"k-w\" lang=\"ja\">結ぶ</span><span class=\"kana\" lang=\"ja\">むすぶ</span><span class=\"k-wz\">系；连结</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">果</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>果</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">は（たす）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">効果</span><span class=\"kana\" lang=\"ja\">こうか</span><span class=\"k-wz\">效果</span></li><li><span class=\"k-w\" lang=\"ja\">果物</span><span class=\"kana\" lang=\"ja\">くだもの</span><span class=\"k-wz\">水果</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">残</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>残；留</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ザン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">のこ（る）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">残念</span><span class=\"kana\" lang=\"ja\">ざんねん</span><span class=\"k-wz\">遗憾</span></li><li><span class=\"k-w\" lang=\"ja\">残る</span><span class=\"kana\" lang=\"ja\">のこる</span><span class=\"k-wz\">留下；剩下</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">念</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../n3/kanji/\">N3</a>念</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ネン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">—</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">記念</span><span class=\"kana\" lang=\"ja\">きねん</span><span class=\"k-wz\">纪念</span></li><li><span class=\"k-w\" lang=\"ja\">念のため</span><span class=\"kana\" lang=\"ja\">ねんのため</span><span class=\"k-wz\">以防万一</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">必</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\"