["<li class=\"kcard\" data-id=\"n3:k:関\"><div class=\"k-ch\" lang=\"ja\">関</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>关</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">せき・かか（わる）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">関係</span><span class=\"kana\" lang=\"ja\">かんけい</span><span class=\"k-wz\">关系</span></li><li><span class=\"k-w\" lang=\"ja\">関心</span><span class=\"kana\" lang=\"ja\">かんしん</span><span class=\"k-wz\">关心；兴趣</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:係\"><div class=\"k-ch\" lang=\"ja\">係</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>系；负责人</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かかり</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">係員</span><span class=\"kana\" lang=\"ja\">かかりいん</span><span class=\"k-wz\">工作人员</span></li><li><span class=\"k-w\" lang=\"ja\">関係者</span><span class=\"kana\" lang=\"ja\">かんけいしゃ</span><span class=\"k-wz\">相关人员</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:原\"><div class=\"k-ch\" lang=\"ja\">原</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>原</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ゲン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はら</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">原因</span><span class=\"kana\" lang=\"ja\">げんいん</span><span class=\"k-wz\">原因</span></li><li><span class=\"k-w\" lang=\"ja\">原料</span><span class=\"kana\" lang=\"ja\">げんりょう</span><span class=\"k-wz\">原料</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:因\"><div class=\"k-ch\" lang=\"ja\">因</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>因</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">イン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">よ（る）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">要因</span><span class=\"kana\" lang=\"ja\">よういん</span><span class=\"k-wz\">因素；主要原因</span></li><li><span class=\"k-w\" lang=\"ja\">死因</span><span class=\"kana\" lang=\"ja\">しいん</span><span class=\"k-wz\">死因</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:結\"><div class=\"k-ch\" lang=\"ja\">結</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>结</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">むす（ぶ）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">結果</span><span class=\"kana\" lang=\"ja\">けっか</span><span class=\"k-wz\">结果</span></li><li><span class=\"k-w\" lang=\"ja\">結ぶ</span><span class=\"kana\" lang=\"ja\">むすぶ</span><span class=\"k-wz\">系；连结</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:果\"><div class=\"k-ch\" lang=\"ja\">果</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>果</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">は（たす）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">効果</span><span class=\"kana\" lang=\"ja\">こうか</span><span class=\"k-wz\">效果</span></li><li><span class=\"k-w\" lang=\"ja\">果物</span><span class=\"kana\" lang=\"ja\">くだもの</span><span class=\"k-wz\">水果</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:残\"><div class=\"k-ch\" lang=\"ja\">残</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>残；留</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ザン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">のこ（る）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">残念</span><span class=\"kana\" lang=\"ja\">ざんねん</span><span class=\"k-wz\">遗憾</span></li><li><span class=\"k-w\" lang=\"ja\">残る</span><span class=\"kana\" lang=\"ja\">のこる</span><span class=\"k-wz\">留下；剩下</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:念\"><div class=\"k-ch\" lang=\"ja\">念</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>念</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ネン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">—</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">記念</span><span class=\"kana\" lang=\"ja\">きねん</span><span class=\"k-wz\">纪念</span></li><li><span class=\"k-w\" lang=\"ja\">念のため</span><span class=\"kana\" lang=\"ja\">ねんのため</span><span class=\"k-wz\">以防万一</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:必\"><div class=\"k-ch\" lang=\"ja\">必</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>必</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヒツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かなら（ず）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">必要</span><span class=\"kana\" lang=\"ja\">ひつよう</span><span class=\"k-wz\">必要</span></li><li><span class=\"k-w\" lang=\"ja\">必ず</span><span class=\"kana\" lang=\"ja\">かならず</span><span class=\"k-wz\">一定</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:要\"><div class=\"k-ch\" lang=\"ja\">要</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>要</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヨウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">い（る）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">重要</span><span class=\"kana\" lang=\"ja\">じゅうよう</span><span class=\"k-wz\">重要</span></li><li><span class=\"k-w\" lang=\"ja\">要る</span><span class=\"kana\" lang=\"ja\">いる</span><span class=\"k-wz\">需要</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:経\"><div class=\"k-ch\" lang=\"ja\">経</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>经</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">へ（る）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">経験</span><span class=\"kana\" lang=\"ja\">けいけん</span><span class=\"k-wz\">经验</span></li><li><span class=\"k-w\" lang=\"ja\">経済</span><span class=\"kana\" lang=\"ja\">けいざい</span><span class=\"k-wz\">经济</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:験\"><div class=\"k-ch\" lang=\"ja\">験</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>验</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">—</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">試験</span><span class=\"kana\" lang=\"ja\">しけん</span><span class=\"k-wz\">考试</span></li><li><span class=\"k-w\" lang=\"ja\">実験</span><span class=\"kana\" lang=\"ja\">じっけん</span><span class=\"k-wz\">实验</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:情\"><div class=\"k-ch\" lang=\"ja\">情</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>情</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">なさ（け）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">情報</span><span class=\"kana\" lang=\"ja\">じょうほう</span><span class=\"k-wz\">信息</span></li><li><span class=\"k-w\" lang=\"ja\">感情</span><span class=\"kana\" lang=\"ja\">かんじょう</span><span class=\"k-wz\">感情</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:報\"><div class=\"k-ch\" lang=\"ja\">報</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>报</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ホウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">むく（いる）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">報告</span><span class=\"kana\" lang=\"ja\">ほうこく</span><span class=\"k-wz\">报告</span></li><li><span class=\"k-w\" lang=\"ja\">予報</span><span class=\"kana\" lang=\"ja\">よほう</span><span class=\"k-wz\">预报</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:最\"><div class=\"k-ch\" lang=\"ja\">最</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>最</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">サイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">もっと（も）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">最近</span><span class=\"kana\" lang=\"ja\">さいきん</span><span class=\"k-wz\">最近</span></li><li><span class=\"k-w\" lang=\"ja\">最も</span><span class=\"kana\" lang=\"ja\">もっとも</span><span class=\"k-wz\">最</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:初\"><div class=\"k-ch\" lang=\"ja\">初</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>初</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はじ（め）・はつ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">最初</span><span class=\"kana\" lang=\"ja\">さいしょ</span><span class=\"k-wz\">最初</span></li><li><span class=\"k-w\" lang=\"ja\">初めて</span><span class=\"kana\" lang=\"ja\">はじめて</span><span class=\"k-wz\">第一次</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:伝\"><div class=\"k-ch\" lang=\"ja\">伝</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>传</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">デン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つた（える）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">伝言</span><span class=\"kana\" lang=\"ja\">でんごん</span><span class=\"k-wz\">留言；口信</span></li><li><span class=\"k-w\" lang=\"ja\">手伝う</span><span class=\"kana\" lang=\"ja\">てつだう</span><span class=\"k-wz\">帮忙</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:連\"><div class=\"k-ch\" lang=\"ja\">連</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>连</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">レン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つ（れる）・つら（なる）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">連絡</span><span class=\"kana\" lang=\"ja\">れんらく</span><span class=\"k-wz\">联系</span></li><li><span class=\"k-w\" lang=\"ja\">連れる</span><span class=\"kana\" lang=\"ja\">つれる</span><span class=\"k-wz\">带（人）</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:確\"><div class=\"k-ch\" lang=\"ja\">確</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>确</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たし（か）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">確認</span><span class=\"kana\" lang=\"ja\">かくにん</span><span class=\"k-wz\">确认</span></li><li><span class=\"k-w\" lang=\"ja\">確か</span><span class=\"kana\" lang=\"ja\">たしか</span><span class=\"k-wz\">确实；大概</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\" data-id=\"n3:k:認\"><div class=\"k-ch\" lang=\"ja\">認</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>认</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ニン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">みと（める）</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">認める</span><span class=\"kana\" lang=\"ja\">みとめる</span><span class=\"k-wz\">承认；认可</span></li><li><span class=\"k-w\" lang=\"ja\">承認</span><span class=\"kana\" lang=\"ja\">しょうにん</span><span class=\"k-wz\">批准</span></li></ul></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">政</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>政治；政务；政事</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セイ・ショウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">まつりごと・まん</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">政治</span><span class=\"kana\" lang=\"ja\">せいじ</span><span class=\"k-wz\">政治；政务</span></li><li><span class=\"k-w\" lang=\"ja\">政府</span><span class=\"kana\" lang=\"ja\">せいふ</span><span class=\"k-wz\">政府；行政；内阁</span></li><li><span class=\"k-w\" lang=\"ja\">政党</span><span class=\"kana\" lang=\"ja\">せいとう</span><span class=\"k-wz\">政党</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">議</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>审议；协商；讨论；考虑</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ギ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">会議</span><span class=\"kana\" lang=\"ja\">かいぎ</span><span class=\"k-wz\">会议；集会；大会；理事会；代表大会；国会</span></li><li><span class=\"k-w\" lang=\"ja\">会議室</span><span class=\"kana\" lang=\"ja\">かいぎしつ</span><span class=\"k-wz\">会议室</span></li><li><span class=\"k-w\" lang=\"ja\">議員</span><span class=\"kana\" lang=\"ja\">ぎいん</span><span class=\"k-wz\">议员；议会成员；国会议员</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">民</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>人民；国民；臣民</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ミン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たみ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">市民</span><span class=\"kana\" lang=\"ja\">しみん</span><span class=\"k-wz\">国民；公民；市民；城市居民；镇民；资产阶级；中产阶级</span></li><li><span class=\"k-w\" lang=\"ja\">国民</span><span class=\"kana\" lang=\"ja\">こくみん</span><span class=\"k-wz\">国民；人民；公民；国民民主党</span></li><li><span class=\"k-w\" lang=\"ja\">住民</span><span class=\"kana\" lang=\"ja\">じゅうみん</span><span class=\"k-wz\">居民；住户；市民；人口</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">対</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>相对；对立；对比；对方；相等</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">タイ・ツイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あいて・こた.える・そろ.い・つれあ.い・なら.ぶ・むか.う</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">反対</span><span class=\"kana\" lang=\"ja\">はんたい</span><span class=\"k-wz\">反对；抵抗；对抗；敌意；异议；反对意见；反面；相反；反向；相对</span></li><li><span class=\"k-w\" lang=\"ja\">対</span><span class=\"kana\" lang=\"ja\">たい</span><span class=\"k-wz\">对；对阵；对抗；对；比（如4比2的比分、3比1的比率）；向…；对…；与…；针对…；反；平等地位；对等立场；对面；相反；对立面</span></li><li><span class=\"k-w\" lang=\"ja\">絶対</span><span class=\"kana\" lang=\"ja\">ぜったい</span><span class=\"k-wz\">绝对地；一定；无条件地；绝对的；无条件的；确定无疑的；绝对性</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">部</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>部分；部门；份（报刊计数单位）；副本；类别</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ブ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">-べ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">全部</span><span class=\"kana\" lang=\"ja\">ぜんぶ</span><span class=\"k-wz\">全部；全；整个；总共</span></li><li><span class=\"k-w\" lang=\"ja\">部屋</span><span class=\"kana\" lang=\"ja\">へや</span><span class=\"k-wz\">房间；室；公寓；寓所；单间公寓；（相扑）部屋；相扑训练团体</span></li><li><span class=\"k-w\" lang=\"ja\">部長</span><span class=\"kana\" lang=\"ja\">ぶちょう</span><span class=\"k-wz\">部门主管；科长；课长；（学校社团）负责人；队长</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">合</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>符合；适合；结合；一致；合算</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ゴウ・ガッ・カッ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あ.う・-あ.う・あ.い・あい-・-あ.い・-あい・あ.わす・あ.わせる・-あ.わせる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">合う</span><span class=\"kana\" lang=\"ja\">あう</span><span class=\"k-wz\">聚合；汇合；联合；相遇；相符；匹配；适合；一致；正确；合算；公平合理；互相……；一起……</span></li><li><span class=\"k-w\" lang=\"ja\">具合</span><span class=\"kana\" lang=\"ja\">ぐあい</span><span class=\"k-wz\">状况；状态；健康；健康状况；方式；方法；样子；情况；运气；际遇；面子；体面；得体；礼仪</span></li><li><span class=\"k-w\" lang=\"ja\">試合</span><span class=\"kana\" lang=\"ja\">しあい</span><span class=\"k-wz\">比赛；竞赛；对局</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">市</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>市场；城市；城镇</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いち</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">市</span><span class=\"kana\" lang=\"ja\">し</span><span class=\"k-wz\">市；城市</span></li><li><span class=\"k-w\" lang=\"ja\">市民</span><span class=\"kana\" lang=\"ja\">しみん</span><span class=\"k-wz\">国民；公民；市民；城市居民；镇民；资产阶级；中产阶级</span></li><li><span class=\"k-w\" lang=\"ja\">市場</span><span class=\"kana\" lang=\"ja\">いちば</span><span class=\"k-wz\">(城镇)市场；街市；集市</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">内</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>内部；之间；家里；当中；内</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ナイ・ダイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">うち</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">案内</span><span class=\"kana\" lang=\"ja\">あんない</span