["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">酒</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>酒；酒精</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シュ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さけ・さか-</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">お酒</span><span class=\"kana\" lang=\"ja\">おさけ</span><span class=\"k-wz\">酒；酒精饮料</span></li><li><span class=\"k-w\" lang=\"ja\">酒</span><span class=\"kana\" lang=\"ja\">さけ</span><span class=\"k-wz\">酒；含酒精饮料</span></li><li><span class=\"k-w\" lang=\"ja\">酒場</span><span class=\"kana\" lang=\"ja\">さかば</span><span class=\"k-wz\">酒吧；酒馆；小酒馆</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">悲</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>悲伤；哀悼；惋惜；遗憾</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヒ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かな.しい・かな.しむ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">悲しい</span><span class=\"kana\" lang=\"ja\">かなしい</span><span class=\"k-wz\">悲伤的；悲惨的；不快乐的；哀伤的；令人悲哀的；令人遗憾的；可叹的；令人痛心的</span></li><li><span class=\"k-w\" lang=\"ja\">悲劇</span><span class=\"kana\" lang=\"ja\">ひげき</span><span class=\"k-wz\">悲剧；悲剧戏剧；悲剧；灾难；不幸事件</span></li><li><span class=\"k-w\" lang=\"ja\">悲しむ</span><span class=\"kana\" lang=\"ja\">かなしむ</span><span class=\"k-wz\">感到悲伤；哀悼；后悔</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">晴</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>晴天；放晴；晴朗；消除（疑虑等）；舒畅</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">は.れる・は.れ・は.れ-・-ば.れ・は.らす</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">晴れ</span><span class=\"kana\" lang=\"ja\">はれ</span><span class=\"k-wz\">晴天；晴朗；正式；庄重；公开；洗清嫌疑；证明清白</span></li><li><span class=\"k-w\" lang=\"ja\">晴れる</span><span class=\"kana\" lang=\"ja\">はれる</span><span class=\"k-wz\">晴朗；放晴；天气转晴；雨停；（心情等）舒畅；爽快；开朗；（嫌疑等）消除；洗清；（阴云等）消散；消失</span></li><li><span class=\"k-w\" lang=\"ja\">快晴</span><span class=\"kana\" lang=\"ja\">かいせい</span><span class=\"k-wz\">晴朗；万里无云；好天气</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">掛</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>悬挂；花费；浇洒；依靠；乘法</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カイ・ケイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">か.ける・-か.ける・か.け・-か.け・-が.け・か.かる・-か.かる・-が.かる・か.かり・-が.かり・かかり・-がかり</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">お目に掛かる</span><span class=\"kana\" lang=\"ja\">おめにかかる</span><span class=\"k-wz\">（与身份较高的人）见面；相见；被（身份较高的人等）认可；显眼；被看见；引起注意</span></li><li><span class=\"k-w\" lang=\"ja\">掛け算</span><span class=\"kana\" lang=\"ja\">かけざん</span><span class=\"k-wz\">乘法</span></li><li><span class=\"k-w\" lang=\"ja\">腰掛け</span><span class=\"kana\" lang=\"ja\">こしかけ</span><span class=\"k-wz\">座位；长凳；临时工作；过渡性工作</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">到</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>到达；达到；及；导致；来临</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いた.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">到着</span><span class=\"kana\" lang=\"ja\">とうちゃく</span><span class=\"k-wz\">到达；抵达</span></li><li><span class=\"k-w\" lang=\"ja\">到達</span><span class=\"kana\" lang=\"ja\">とうたつ</span><span class=\"k-wz\">到达</span></li><li><span class=\"k-w\" lang=\"ja\">到底</span><span class=\"kana\" lang=\"ja\">とうてい</span><span class=\"k-wz\">根本；简直；完全</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">寝</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>躺下；睡觉；休息；床；滞销</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ね.る・ね.かす・い.ぬ・みたまや・や.める</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">寝る</span><span class=\"kana\" lang=\"ja\">ねる</span><span class=\"k-wz\">睡觉；躺着睡；上床；躺在床上；躺下；躺平；与…同床；发生性关系；贴平；服帖（如头发）；闲置；未被使用（如资金、股票等）；发酵（如酱油、味噌等）</span></li><li><span class=\"k-w\" lang=\"ja\">寝坊</span><span class=\"kana\" lang=\"ja\">ねぼう</span><span class=\"k-wz\">睡懒觉；睡过头；爱睡懒觉的人；贪睡的人</span></li><li><span class=\"k-w\" lang=\"ja\">寝台</span><span class=\"kana\" lang=\"ja\">しんだい</span><span class=\"k-wz\">床；卧铺</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">暗</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>黑暗；昏暗；秘密；默记；目眩</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">アン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">くら.い・くら.む・くれ.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">暗い</span><span class=\"kana\" lang=\"ja\">くらい</span><span class=\"k-wz\">黑暗的；昏暗的；阴暗的；沮丧的；消沉的；心情阴郁的；（颜色）深暗的；暗淡的；不祥的；可疑的；（来历）不明的；无望的；没有希望的；前景暗淡的；不熟悉的；不了解的；无知的</span></li><li><span class=\"k-w\" lang=\"ja\">暗記</span><span class=\"kana\" lang=\"ja\">あんき</span><span class=\"k-wz\">记忆；背诵；记诵</span></li><li><span class=\"k-w\" lang=\"ja\">薄暗い</span><span class=\"kana\" lang=\"ja\">うすぐらい</span><span class=\"k-wz\">昏暗；阴暗</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">盗</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>偷盗；抢劫；盗窃</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ぬす.む・ぬす.み</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">盗む</span><span class=\"kana\" lang=\"ja\">ぬすむ</span><span class=\"k-wz\">偷；盗取；抄袭；窃取（技巧、想法等）；暗中学习；偷偷地做；悄悄地进行；在匆忙中抽时间做；利用片刻时间做；盗垒</span></li><li><span class=\"k-w\" lang=\"ja\">強盗</span><span class=\"kana\" lang=\"ja\">ごうとう</span><span class=\"k-wz\">抢劫犯；强盗；劫匪；抢劫；入室盗窃</span></li><li><span class=\"k-w\" lang=\"ja\">盗難</span><span class=\"kana\" lang=\"ja\">とうなん</span><span class=\"k-wz\">盗窃；失窃</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">吸</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>吸；吸入；喝；抽；吸食</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">す.う</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">吸う</span><span class=\"kana\" lang=\"ja\">すう</span><span class=\"k-wz\">吸入；吸气；吸烟；吸吮；啜饮；吮吸；吸收；吸附；亲吻</span></li><li><span class=\"k-w\" lang=\"ja\">吸収</span><span class=\"kana\" lang=\"ja\">きゅうしゅう</span><span class=\"k-wz\">吸收；吸取；吸引</span></li><li><span class=\"k-w\" lang=\"ja\">呼吸</span><span class=\"kana\" lang=\"ja\">こきゅう</span><span class=\"k-wz\">呼吸；呼吸作用；窍门；诀窍；秘诀；和谐；协调；同步；配合；短暂间隔；短暂停顿</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">陽</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>太阳；阳光；阳性；白天；男性</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヨウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ひ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">太陽</span><span class=\"kana\" lang=\"ja\">たいよう</span><span class=\"k-wz\">太阳</span></li><li><span class=\"k-w\" lang=\"ja\">陽気</span><span class=\"kana\" lang=\"ja\">ようき</span><span class=\"k-wz\">开朗的；愉快的；活泼的；天气；季节；时令；阳气</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">御</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>尊敬；统治；驾驭</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ギョ・ゴ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おん-・お-・み-</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">御飯</span><span class=\"kana\" lang=\"ja\">ごはん</span><span class=\"k-wz\">米饭；煮好的饭；餐；饭食</span></li><li><span class=\"k-w\" lang=\"ja\">晩御飯</span><span class=\"kana\" lang=\"ja\">ばんごはん</span><span class=\"k-wz\">晚餐；晚饭</span></li><li><span class=\"k-w\" lang=\"ja\">昼御飯</span><span class=\"kana\" lang=\"ja\">ひるごはん</span><span class=\"k-wz\">午餐；中餐；午饭</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">歯</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>牙齿；齿（机械的齿状物）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">よわい・は・よわ.い・よわい.する</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">歯</span><span class=\"kana\" lang=\"ja\">は</span><span class=\"k-wz\">牙齿；牙；齿；齿（梳子、锯子等的）；木屐的齿（支撑底部的突起）</span></li><li><span class=\"k-w\" lang=\"ja\">歯医者</span><span class=\"kana\" lang=\"ja\">はいしゃ</span><span class=\"k-wz\">牙医；牙科医生</span></li><li><span class=\"k-w\" lang=\"ja\">虫歯</span><span class=\"kana\" lang=\"ja\">むしば</span><span class=\"k-wz\">蛀牙；龋齿；牙洞；龋病</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">忘</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>忘记</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">わす.れる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">忘れる</span><span class=\"kana\" lang=\"ja\">わすれる</span><span class=\"k-wz\">遗忘；忘记；忘却；遗漏</span></li><li><span class=\"k-w\" lang=\"ja\">忘れ物</span><span class=\"kana\" lang=\"ja\">わすれもの</span><span class=\"k-wz\">遗失物；遗落的东西；忘带东西；落下东西；遗落物品</span></li><li><span class=\"k-w\" lang=\"ja\">度忘れ</span><span class=\"kana\" lang=\"ja\">どわすれ</span><span class=\"k-wz\">一时遗忘；一时想不起来；突然忘记</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">雪</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>雪</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ゆき</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">雪</span><span class=\"kana\" lang=\"ja\">ゆき</span><span class=\"k-wz\">雪；降雪</span></li><li><span class=\"k-w\" lang=\"ja\">吹雪</span><span class=\"kana\" lang=\"ja\">ふぶき</span><span class=\"k-wz\">暴风雪；风雪</span></li><li><span class=\"k-w\" lang=\"ja\">雪崩</span><span class=\"kana\" lang=\"ja\">なだれ</span><span class=\"k-wz\">雪崩；雪滑；雪崩；雪崩定石</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">吹</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>吹；喷出；呼吸；冒烟</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">スイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ふ.く</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">吹く</span><span class=\"kana\" lang=\"ja\">ふく</span><span class=\"k-wz\">吹；刮（风）；吹气；呼气；吹（热茶、蜡烛等）；吹气；吹奏（管乐器）；吹（哨子、喇叭等）；吹口哨；喷出（烟、火等）；冒出；喷吐；抽芽；萌芽；发芽；浮现（于表面）；生成；附着（粉末、锈迹等）；突然大笑；爆笑；吹牛；说大话；冶炼；铸造</span></li><li><span class=\"k-w\" lang=\"ja\">吹雪</span><span class=\"kana\" lang=\"ja\">ふぶき</span><span class=\"k-wz\">暴风雪；风雪</span></li><li><span class=\"k-w\" lang=\"ja\">吹奏</span><span class=\"kana\" lang=\"ja\">すいそう</span><span class=\"k-wz\">吹奏（管乐器）；吹奏</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">娘</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>女儿；少女</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">むすめ・こ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">娘</span><span class=\"kana\" lang=\"ja\">むすめ</span><span class=\"k-wz\">女儿；女孩；少女；未婚女性</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">誤</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>错误；失误；过错；误导</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ゴ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あやま.る・-あやま.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">誤り</span><span class=\"kana\" lang=\"ja\">あやまり</span><span class=\"k-wz\">错误；失误；过失；漏洞</span></li><li><span class=\"k-w\" lang=\"ja\">誤解</span><span class=\"kana\" lang=\"ja\">ごかい</span><span class=\"k-wz\">误解；误会</span></li><li><span class=\"k-w\" lang=\"ja\">誤る</span><span class=\"kana\" lang=\"ja\">あやまる</span><span class=\"k-wz\">犯错；出错；做错；弄错；错误；不对；不正确；有误；误导；引入歧途；带坏</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">洗</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>洗；调查；探究</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あら.う</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">洗う</span><span class=\"kana\" lang=\"ja\">あらう</span><span class=\"k-wz\">洗；冲洗；漂洗；追查；调查；追究；净化（心灵）；洗涤（心灵）；冲刷；拍打；席卷</span></li><li><span class=\"k-w\" lang=\"ja\">洗濯</span><span class=\"kana\" lang=\"ja\">せんたく</span><span class=\"k-wz\">洗衣；洗涤；放松；消除（忧虑、疲劳等）</span></li><li><span class=\"k-w\" lang=\"ja\">お手洗い</span><span class=\"kana\" lang=\"ja\">おてあらい</span><span class=\"k-wz\">厕所；盥洗室；洗手间</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">畑</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>田地；旱田；农田；菜园；专长</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\"></dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はた・はたけ・-ばたけ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">畑</span><span class=\"kana\" lang=\"ja\">はたけ</span><span class=\"k-wz\">田地；菜地；果园；种植地；领域；范围；专业；行业；子宫；出生地；出身</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">慣</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>习惯；适应；熟练</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">な.れる・な.らす</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">習慣</span><span class=\"kana\" lang=\"ja\">しゅうかん</span><span class=\"k-wz\">习惯</span></li><li><span class=\"k-w\" lang=\"ja\">慣れる</span><span class=\"kana\" lang=\"ja\">なれる</span><span class=\"k-wz\">习惯</span></li><li><span class=\"k-w\" lang=\"ja\">見慣れる</span><span class=\"kana\" lang=\"ja\">みなれる</span><span class=\"k-wz\">习惯看到；习惯于见到；对...很熟悉</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">礼</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>敬礼；鞠躬；仪式；感谢；报酬</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">レイ・ライ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">お礼</span><span class=\"kana\" lang=\"ja\">おれい</span><span class=\"k-wz\">感谢；谢意；礼仪；礼节；鞠躬；报酬；礼物；仪式；礼仪</span></li><li><span class=\"k-w\" lang=\"ja\">礼</span><span class=\"kana\" lang=\"ja\">れい</span><span class=\"k-wz\">感谢；谢意；礼仪；礼节；礼貌；鞠躬；酬金；礼物；仪式；典礼；祭礼；礼金</span></li><li><span class=\"k-w\" lang=\"ja\">礼儀</span><span class=\"kana\" lang=\"ja\">れいぎ</span><span class=\"k-wz\">礼仪；礼节；礼貌</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">窓</div><div class=\"k-body\"><p class=\"k-m\"><a cl