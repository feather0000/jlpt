["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">曲</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>弯曲；音乐；旋律；作曲；歪曲</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キョク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ま.がる・ま.げる・くま</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">曲る</span><span class=\"kana\" lang=\"ja\">まがる</span><span class=\"k-wz\">弯曲；弯折；翘曲；蜿蜒；扭曲；转向；转弯；歪斜；不正；扭曲不正</span></li><li><span class=\"k-w\" lang=\"ja\">作曲</span><span class=\"kana\" lang=\"ja\">さっきょく</span><span class=\"k-wz\">作曲；谱曲；音乐创作</span></li><li><span class=\"k-w\" lang=\"ja\">曲線</span><span class=\"kana\" lang=\"ja\">きょくせん</span><span class=\"k-wz\">曲线</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">払</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>支付；清除；修剪；驱逐；处理</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">フツ・ヒツ・ホツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はら.う・-はら.い・-ばら.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">払う</span><span class=\"kana\" lang=\"ja\">はらう</span><span class=\"k-wz\">支付（如金钱、账单等）；拂去；擦去；清除；掸去；砍断（如树枝）；赶走；驱逐（如竞争对手）；变卖；卖掉；处理（不需要的东西）；给予；表示（如注意力、尊重、关切）；付出；花费；耗费（如努力、牺牲）；搬出；腾出（自己的住处）；扫（如腿）；挥开；推开；（书法）写出撇、捺等扫笔；（算盘）清盘；复位</span></li><li><span class=\"k-w\" lang=\"ja\">支払</span><span class=\"kana\" lang=\"ja\">しはらい</span><span class=\"k-wz\">支付；付款</span></li><li><span class=\"k-w\" lang=\"ja\">支払う</span><span class=\"kana\" lang=\"ja\">しはらう</span><span class=\"k-wz\">支付；付款</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">庭</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>庭院；院子；花园</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">テイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">にわ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">庭</span><span class=\"kana\" lang=\"ja\">にわ</span><span class=\"k-wz\">花园；院子；庭院；领域；范围；活动范围</span></li><li><span class=\"k-w\" lang=\"ja\">家庭</span><span class=\"kana\" lang=\"ja\">かてい</span><span class=\"k-wz\">家庭</span></li><li><span class=\"k-w\" lang=\"ja\">校庭</span><span class=\"kana\" lang=\"ja\">こうてい</span><span class=\"k-wz\">校园；操场；运动场；学校场地</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">徒</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>门徒；徒步；徒劳；空虚；一伙人</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ト</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いたずら・あだ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">生徒</span><span class=\"kana\" lang=\"ja\">せいと</span><span class=\"k-wz\">学生；生徒；学童</span></li><li><span class=\"k-w\" lang=\"ja\">徒歩</span><span class=\"kana\" lang=\"ja\">とほ</span><span class=\"k-wz\">步行；徒步；走路</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">勤</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>勤奋；任职；服务；勤勉</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キン・ゴン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つと.める・-づと.め・つと.まる・いそ.しむ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">勤める</span><span class=\"kana\" lang=\"ja\">つとめる</span><span class=\"k-wz\">在……工作；受雇于；供职于；担任；充当；出任……职务；扮演……角色；主持宗教仪式；进行宗教活动</span></li><li><span class=\"k-w\" lang=\"ja\">勤め</span><span class=\"kana\" lang=\"ja\">つとめ</span><span class=\"k-wz\">职务；职责；工作；责任；任务；佛教法事；佛事</span></li><li><span class=\"k-w\" lang=\"ja\">出勤</span><span class=\"kana\" lang=\"ja\">しゅっきん</span><span class=\"k-wz\">上班；出勤；到岗；报到</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">遅</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>慢；晚；迟；拖延；落后</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">チ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おく.れる・おく.らす・おそ.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">遅い</span><span class=\"kana\" lang=\"ja\">おそい</span><span class=\"k-wz\">慢；缓慢；晚；迟；太晚；为时已晚</span></li><li><span class=\"k-w\" lang=\"ja\">遅れる</span><span class=\"kana\" lang=\"ja\">おくれる</span><span class=\"k-wz\">迟到；延误；落后于日程；落后；滞后；跟不上时代；（亲人）先逝；失去（亲人）；（钟表）走慢</span></li><li><span class=\"k-w\" lang=\"ja\">遅刻</span><span class=\"kana\" lang=\"ja\">ちこく</span><span class=\"k-wz\">迟到；晚到；来迟</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">居</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>居住；存在；在；处于；生活</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キョ・コ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">い.る・-い・お.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">居間</span><span class=\"kana\" lang=\"ja\">いま</span><span class=\"k-wz\">起居室；客厅</span></li><li><span class=\"k-w\" lang=\"ja\">居る</span><span class=\"kana\" lang=\"ja\">おる</span><span class=\"k-wz\">（谦让语）在；有；存在（指人或动物）；正在……；在……中；（接动词て形）……着；已……（表状态持续）；（接动词连用形，表轻蔑）竟敢……；居然……</span></li><li><span class=\"k-w\" lang=\"ja\">芝居</span><span class=\"kana\" lang=\"ja\">しばい</span><span class=\"k-wz\">戏剧；话剧；剧目</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">雑</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>混杂；混合；杂乱的；杂项</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ザツ・ゾウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">まじ.える・まじ.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">雑誌</span><span class=\"kana\" lang=\"ja\">ざっし</span><span class=\"k-wz\">杂志；期刊；刊物</span></li><li><span class=\"k-w\" lang=\"ja\">複雑</span><span class=\"kana\" lang=\"ja\">ふくざつ</span><span class=\"k-wz\">复杂</span></li><li><span class=\"k-w\" lang=\"ja\">混雑</span><span class=\"kana\" lang=\"ja\">こんざつ</span><span class=\"k-wz\">拥挤；拥堵；拥塞；堵塞；混乱；纷乱；无序</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">招</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>招引；邀请；召唤；聘用</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">まね.く</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">招待</span><span class=\"kana\" lang=\"ja\">しょうたい</span><span class=\"k-wz\">邀请；招待</span></li><li><span class=\"k-w\" lang=\"ja\">招く</span><span class=\"kana\" lang=\"ja\">まねく</span><span class=\"k-wz\">邀请；招待；招手；挥手示意；做手势；召来；传唤；召集；招致；引起；造成；导致；惹来</span></li><li><span class=\"k-w\" lang=\"ja\">招き</span><span class=\"kana\" lang=\"ja\">まねき</span><span class=\"k-wz\">邀请；招待</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">困</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>困扰；为难；苦恼</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">コン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">こま.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">困る</span><span class=\"kana\" lang=\"ja\">こまる</span><span class=\"k-wz\">为难；发愁</span></li><li><span class=\"k-w\" lang=\"ja\">困難</span><span class=\"kana\" lang=\"ja\">こんなん</span><span class=\"k-wz\">困难；艰难；困苦；窘迫；不可行；难以实施；无法执行</span></li><li><span class=\"k-w\" lang=\"ja\">貧困</span><span class=\"kana\" lang=\"ja\">ひんこん</span><span class=\"k-wz\">贫困；赤贫；贫乏；穷困；短缺；缺乏；不足</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">欠</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>缺乏；缺口；失败；欠缺</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケツ・ケン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">か.ける・か.く</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">欠陥</span><span class=\"kana\" lang=\"ja\">けっかん</span><span class=\"k-wz\">缺陷；缺点；瑕疵；畸形；不足；短缺；漏洞</span></li><li><span class=\"k-w\" lang=\"ja\">欠席</span><span class=\"kana\" lang=\"ja\">けっせき</span><span class=\"k-wz\">缺席；不出席</span></li><li><span class=\"k-w\" lang=\"ja\">欠点</span><span class=\"kana\" lang=\"ja\">けってん</span><span class=\"k-wz\">缺点；缺陷；弱点；不足；短处；（考试）不及格；不合格成绩</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">更</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>更（更加）；再（再次）；加深（程度）；更替（更新）；夜深（时间晚）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">コウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さら・さら.に・ふ.ける・ふ.かす</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">更に</span><span class=\"kana\" lang=\"ja\">さらに</span><span class=\"k-wz\">而且；再者；况且；愈加；越来越；更加</span></li><li><span class=\"k-w\" lang=\"ja\">変更</span><span class=\"kana\" lang=\"ja\">へんこう</span><span class=\"k-wz\">变更；修改；变动；更改；修订</span></li><li><span class=\"k-w\" lang=\"ja\">更ける</span><span class=\"kana\" lang=\"ja\">ふける</span><span class=\"k-wz\">天色渐晚；时间推移；夜深</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">刻</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>雕刻；切细；剁碎；时间；刻</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">コク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">きざ.む・きざ.み</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">時刻</span><span class=\"kana\" lang=\"ja\">じこく</span><span class=\"k-wz\">时刻；时间；有利时机；机会；良机</span></li><li><span class=\"k-w\" lang=\"ja\">深刻</span><span class=\"kana\" lang=\"ja\">しんこく</span><span class=\"k-wz\">严重；严肃</span></li><li><span class=\"k-w\" lang=\"ja\">遅刻</span><span class=\"kana\" lang=\"ja\">ちこく</span><span class=\"k-wz\">迟到；晚到；来迟</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">賛</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>赞同；赞美；题赞（画上题词）；协助；同意</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">サン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たす.ける・たた.える</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">賛成</span><span class=\"kana\" lang=\"ja\">さんせい</span><span class=\"k-wz\">赞成；同意；支持；赞许</span></li><li><span class=\"k-w\" lang=\"ja\">賛美</span><span class=\"kana\" lang=\"ja\">さんび</span><span class=\"k-wz\">赞美；颂扬；称颂</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">犯</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>犯罪；冒犯；侵犯</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ハン・ボン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おか.す</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">犯罪</span><span class=\"kana\" lang=\"ja\">はんざい</span><span class=\"k-wz\">犯罪；犯法；违法行为</span></li><li><span class=\"k-w\" lang=\"ja\">犯人</span><span class=\"kana\" lang=\"ja\">はんにん</span><span class=\"k-wz\">犯人；罪犯；作案人</span></li><li><span class=\"k-w\" lang=\"ja\">防犯</span><span class=\"kana\" lang=\"ja\">ぼうはん</span><span class=\"k-wz\">犯罪预防；防止犯罪；安全防护；防盗（设备、摄像头等）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">恐</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>恐惧；害怕；敬畏</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おそ.れる・おそ.る・おそ.ろしい・こわ.い・こわ.がる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">恐怖</span><span class=\"kana\" lang=\"ja\">きょうふ</span><span class=\"k-wz\">恐惧；害怕；惊恐；恐怖；惊吓；惶恐</span></li><li><span class=\"k-w\" lang=\"ja\">恐れる</span><span class=\"kana\" lang=\"ja\">おそれる</span><span class=\"k-wz\">害怕；恐惧</span></li><li><span class=\"k-w\" lang=\"ja\">恐ろしい</span><span class=\"kana\" lang=\"ja\">おそろしい</span><span class=\"k-wz\">可怕的；令人恐惧的；使人害怕的；令人惊讶的；惊人的；了不起的</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">息</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>呼吸；休息；利息；儿子；停止</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いき</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">息子</span><span class=\"kana\" lang=\"ja\">むすこ</span><span class=\"k-wz\">儿子；阴茎；男性生殖器</span></li><li><span class=\"k-w\" lang=\"ja\">息</span><span class=\"kana\" lang=\"ja\">いき</span><span class=\"k-wz\">呼吸；协调；和谐；默契；水汽；蒸气</span></li><li><span class=\"k-w\" lang=\"ja\">休息</span><span class=\"kana\" lang=\"ja\">きゅうそく</span><span class=\"k-wz\">休息；解乏；放松</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">遠</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>远；遥远</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">エン・オン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">とお.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">遠い</span><span class=\"kana\" lang=\"ja\">とおい</span><span class=\"k-wz\">远的；遥远的；在远方的；久远的；遥远的（时间）；关系疏远；亲缘关系远；相差悬殊；差异很大；相去甚远；听力不好；耳背；近视</span></li><li><span class=\"k-w\" lang=\"ja\">遠慮</span><span class=\"kana\" lang=\"ja\">えんりょ</span><span class=\"k-wz\">保留；克制；谦逊；矜持；顾虑；迟疑；审慎；体贴；推辞；谢绝；克制不做；避免（做某事）；深谋远虑；预见</span></li><li><span class=\"k-w\" lang=\"ja\">遠く</span><span class=\"kana\" lang=\"ja\">とおく</span><span class=\"k-wz\">远处；远方；远地；遥远的地方；很久以前；很久以后；遥远的过去；遥远的未来；远远地；远比</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">戻</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>返回；恢复；倒退；重新开始；归还</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">レイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">もど.す・もど.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">戻る</span><span class=\"kana\" lang=\"ja\">もどる</span><span class=\"k-wz\">折返；中途返回；返回；回去；恢复；被归还；反弹；弹回</span></li><li><span class=\"k-w\" lang=\"ja\">戻す</span><span class=\"kana\" lang=\"ja\">もどす</span><span class=\"k-wz\">放回；退还；恢复（到之前的状态，如解冻、复原、和解）；回拨（如时针）；呕吐；吐出；（市场价格）恢复；回升</span></li><li><span class=\"k-w\" lang=\"ja\">払い戻す</span><span class=\"kana\" lang=\"ja\">はらいもどす</span><span class=\"k-wz\">偿还；退还；退款；报销</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">願</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>愿望；请求；祈祷；誓言；希望</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ガン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ねが.う・-ねがい</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">お願いします</span><span class=\"kana\" lang=\"ja\">おねがいします</span><span class=\"k-wz\">请；拜托了；麻烦了</span></li><li><span class=\"k-w\" lang=\"ja\">願い</span><span class=\"kana\" lang=\"ja\">ねがい</span><span class=\"k-wz\">愿望；希望；心愿；请求；恳求；祈求；呼吁；祈祷；祈念；（书面）申请；申请书</span></li><li><span class=\"k-w\" lang=\"ja\">願う</span><span class=\"kana\" lang=\"ja\">ねがう</span><span class=\"k-wz\">渴望；希望；想要；央求；请求；恳求；祈求；请人代为做某事；有劳……</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">絵</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>画；图画；绘画；素描</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カイ・エ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">絵</span><span class=\"kana\" lang=\"ja\">え</span><span class=\"k-wz\">图画；绘画；素描；画面；镜头；影像</span></li><li><span class=\"k-w\" lang=\"ja\">絵画</span><span class=\"kana\" lang=\"ja\">かいが</span><span class=\"k-wz\">绘画；图画</span></li><li><span class=\"k-w\" lang=\"ja\">絵の具</span><span class=\"kana\" lang=\"ja\">えのぐ</span><span class=\"k-wz\">绘画颜料；色彩材料；颜色</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">越</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>超过；跨越；移动；超出；越南</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">エツ・オツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">こ.す・-こ.す・-ご.し・こ.える・-ご.え</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">引っ越す</span><span class=\"kana\" lang=\"ja\">ひっこす</span><span class=\"k-wz\">搬家；迁居；改变住所</span></li><li><span class=\"k-w\" lang=\"ja\">越す</span><span class=\"kana\" lang=\"ja\">こす</span><span class=\"k-wz\">越过；跨越；穿过；克服；渡过；度过；熬过；超过；胜过；超越；搬家；迁居；（尊敬语）去；来；光临</span></li><li><span class=\"k-w\" lang=\"ja\">越える</span><span class=\"kana\" lang=\"ja\">こえる</span><span class=\"k-wz\">越过；跨越；穿过；经过；超越；超出；超过；超越；胜过；多于</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">欲</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>欲望；渴望；贪婪；贪欲；渴求</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヨク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ほっ.する・ほ.しい</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">欲しい</span><span class=\"kana\" lang=\"ja\">ほしい</span><span class=\"k-wz\">想要；希望拥有；想让（某人）做；希望（某人）</span></li><li><span class=\"k-w\" lang=\"ja\">食欲</span><span class=\"kana\" lang=\"ja\">しょくよく</span><span class=\"k-wz\">食欲</span></li><li><span class=\"k-w\" lang=\"ja\">欲張り</span><span class=\"kana\" lang=\"ja\">よくばり</span><span class=\"k-wz\">贪心；贪婪；贪欲；贪心的人</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">痛</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>疼痛；伤害；损伤；悲痛</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ツウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いた.い・いた.む・いた.ましい・いた.める</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">痛い</span><span class=\"kana\" lang=\"ja\">いたい</span><span class=\"k-wz\">疼痛；酸痛；令人尴尬的；难为情的</span></li><li><span class=\"k-w\" lang=\"ja\">痛み</span><span class=\"kana\" lang=\"ja\">いたみ</span><span class=\"k-wz\">疼痛；酸痛；悲伤；痛苦；损伤；破损；磨损；瘀伤；破裂</span></li><li><span class=\"k-w\" lang=\"ja\">苦痛</span><span class=\"kana\" lang=\"ja\">くつう</span><span class=\"k-wz\">痛苦；苦楚；折磨；痛楚</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">笑</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>笑；微笑；嗤笑</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">わら.う・え.む</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">笑う</span><span class=\"kana\" lang=\"ja\">わらう</span><span class=\"k-wz\">笑；发笑；微笑；含笑；嘲笑；讥笑；嘲讽；目瞪口呆；瞠目结舌</span></li><li><span class=\"k-w\" lang=\"ja\">笑顔</span><span class=\"kana\" lang=\"ja\">えがお</span><span class=\"k-wz\">笑脸；微笑</span></li><li><span class=\"k-w\" lang=\"ja\">笑い</span><span class=\"kana\" lang=\"ja\">わらい</span><span class=\"k-wz\">笑；笑声；微笑；笑容；冷笑；嘲笑；情趣用品；春宫图</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">互</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>互相；交互；共同</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ゴ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たが.い・かたみ.に</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">互い</span><span class=\"kana\" lang=\"ja\">たがい</span><span class=\"k-wz\">互相；彼此</span></li><li><span class=\"k-w\" lang=\"ja\">お互い</span><span class=\"kana\" lang=\"ja\">おたがい</span><span class=\"k-wz\">彼此；互相；相互</span></li><li><span class=\"k-w\" lang=\"ja\">相互</span><span class=\"kana\" lang=\"ja\">そうご</span><span class=\"k-wz\">相互的；互相的；互惠的</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">束</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>捆束；束（量词）；管理；控制</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たば・たば.ねる・つか・つか.ねる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">約束</span><span class=\"kana\" lang=\"ja\">やくそく</span><span class=\"k-wz\">约定</span></li><li><span class=\"k-w\" lang=\"ja\">束</span><span class=\"kana\" lang=\"ja\">たば</span><span class=\"k-wz\">束；捆；把（量词）</span></li><li><span class=\"k-w\" lang=\"ja\">結束</span><span class=\"kana\" lang=\"ja\">けっそく</span><span class=\"k-wz\">团结；联合；齐心协力；捆绑；捆扎；系束；穿戴；着装；披甲</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">似</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>相似；模仿；适合；伪造</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">に.る・ひ.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">似る</span><span class=\"kana\" lang=\"ja\">にる</span><span class=\"k-wz\">相似；相像；像；相近；酷似</span></li><li><span class=\"k-w\" lang=\"ja\">真似</span><span class=\"kana\" lang=\"ja\">まね</span><span class=\"k-wz\">模仿；仿效；学样；行为；举动；行为举止</span></li><li><span class=\"k-w\" lang=\"ja\">似合う</span><span class=\"kana\" lang=\"ja\">にあう</span><span class=\"k-wz\">适合；相配；相称</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">列</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>列；排；行；等级；纵队</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">レツ・レ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">列</span><span class=\"kana\" lang=\"ja\">れつ</span><span class=\"k-wz\">行；列；排；队伍；横排；行列；同类；伙伴；（某类人的）行列；…之列；（数学）数列；序列；系（分类学等级）；（量词）列；排；行</span></li><li><span class=\"k-w\" lang=\"ja\">列車</span><span class=\"kana\" lang=\"ja\">れっしゃ</span><span class=\"k-wz\">列车；火车</span></li><li><span class=\"k-w\" lang=\"ja\">行列</span><span class=\"kana\" lang=\"ja\">ぎょうれつ</span><span class=\"k-wz\">队列；行列；队伍；游行；矩阵</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">探</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>寻找；搜索；探查</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">タン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さぐ.る・さが.す</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">探す</span><span class=\"kana\" lang=\"ja\">さがす</span><span class=\"k-wz\">寻找；查找；搜索；搜查；翻找；搜寻</span></li><li><span class=\"k-w\" lang=\"ja\">探る</span><span class=\"kana\" lang=\"ja\">さぐる</span><span class=\"k-wz\">摸索；探摸；寻找；搜寻；调查；探查；侦察；打探；刺探；探索（未知之地）；欣赏（自然风光）</span></li><li><span class=\"k-w\" lang=\"ja\">探検</span><span class=\"kana\" lang=\"ja\">たんけん</span><span class=\"k-wz\">探险；探索；远征</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">逃</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>逃跑；逃避；错过；放跑；推卸</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">に.げる・に.がす・のが.す・のが.れる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">逃げる</span><span class=\"kana\" lang=\"ja\">にげる</span><span class=\"k-wz\">逃跑；逃离；逃脱；躲避；冲出；躲藏；回避；逃避；躲闪；推卸；退缩；领先获胜；坚持领先到终点；保持领先；逸出；泄漏；散发；消失（指热、气体、香气等）；姿势不稳；身体失去平衡</span></li><li><span class=\"k-w\" lang=\"ja\">逃がす</span><span class=\"kana\" lang=\"ja\">にがす</span><span class=\"k-wz\">释放；放走；让……逃脱；错过；遗漏；失去；未能抓住</span></li><li><span class=\"k-w\" lang=\"ja\">逃走</span><span class=\"kana\" lang=\"ja\">とうそう</span><span class=\"k-wz\">逃走；逃亡；脱逃</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">遊</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>游玩；玩耍；游戏；游乐；嬉戏</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ユウ・ユ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あそ.ぶ・あそ.ばす</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">遊ぶ</span><span class=\"kana\" lang=\"ja\">あそぶ</span><span class=\"k-wz\">玩耍；游戏；娱乐；消遣；鬼混；胡闹；寻欢作乐（指酒色、赌博等）；闲着；无所事事；闲置；未被使用；（和朋友）一起玩；出去玩；聚会；沉溺；放纵（赌博、饮酒等）；前往；去（为了娱乐或学习）；逗弄；戏弄；调侃；（棒球）故意投坏球以扰乱打者注意力</span></li><li><span class=\"k-w\" lang=\"ja\">遊び</span><span class=\"kana\" lang=\"ja\">あそび</span><span class=\"k-wz\">玩耍；游戏；娱乐；消遣；游乐；休闲；机械间隙；活动间隙；表现自由度；艺术表现的灵活性；空白页；衬页</span></li><li><span class=\"k-w\" lang=\"ja\">遊園地</span><span class=\"kana\" lang=\"ja\">ゆうえんち</span><span class=\"k-wz\">游乐园；游园地</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">迷</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>迷惑；迷失；困惑；迷惘；幻觉</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">メイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">まよ.う</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">迷子</span><span class=\"kana\" lang=\"ja\">まいご</span><span class=\"k-wz\">迷路的孩子；走失的孩子；走失的人；失踪儿童</span></li><li><span class=\"k-w\" lang=\"ja\">迷惑</span><span class=\"kana\" lang=\"ja\">めいわく</span><span class=\"k-wz\">麻烦；烦扰；困扰；不便；感到困扰；被烦扰；感到不便</span></li><li><span class=\"k-w\" lang=\"ja\">迷信</span><span class=\"kana\" lang=\"ja\">めいしん</span><span class=\"k-wz\">迷信；迷信的信念</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">夢</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>梦；梦想；幻影；幻觉</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ム・ボウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ゆめ・ゆめ.みる・くら.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">夢</span><span class=\"kana\" lang=\"ja\">ゆめ</span><span class=\"k-wz\">梦；梦境；梦；希望；愿望；志向；抱负；不切实际的幻想；白日梦；空想；妄想；幻觉；错觉；转瞬即逝的事物；昙花一现的东西</span></li><li><span class=\"k-w\" lang=\"ja\">夢中</span><span class=\"kana\" lang=\"ja\">むちゅう</span><span class=\"k-wz\">专心致志；沉迷；痴迷；全神贯注；忘我；恍惚；出神；入迷；梦中；睡梦里</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">君</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>你；男性名字后缀；君主；先生</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">クン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">きみ・-ぎみ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">君</span><span class=\"kana\" lang=\"ja\">きみ</span><span class=\"k-wz\">你；老兄；哥们；君主；统治者；主君；他；她</span></li><li><span class=\"k-w\" lang=\"ja\">君主</span><span class=\"kana\" lang=\"ja\">くんしゅ</span><span class=\"k-wz\">君主；主权者；统治者；领主</span></li><li><span class=\"k-w\" lang=\"ja\">諸君</span><span class=\"kana\" lang=\"ja\">しょくん</span><span class=\"k-wz\">你们；诸位；诸君；各位；女士们先生们；大家</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">閉</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>关闭；合上；封闭；关着；关紧</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヘイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">と.じる・と.ざす・し.める・し.まる・た.てる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">閉まる</span><span class=\"kana\" lang=\"ja\">しまる</span><span class=\"k-wz\">关闭；闭合；紧实；结实；被锁上；锁定；拧紧；绷紧；清醒；变得紧张</span></li><li><span class=\"k-w\" lang=\"ja\">閉める</span><span class=\"kana\" lang=\"ja\">しめる</span><span class=\"k-wz\">关闭；闭合</span></li><li><span class=\"k-w\" lang=\"ja\">閉じる</span><span class=\"kana\" lang=\"ja\">とじる</span><span class=\"k-wz\">关闭；合上；结束</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">緒</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>开端；线头；绳带；情绪</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショ・チョ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">お・いとぐち</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">一緒</span><span class=\"kana\" lang=\"ja\">いっしょ</span><span class=\"k-wz\">一起；共同；一团；混在一起；同一类；相同；一样；同时；一并</span></li><li><span class=\"k-w\" lang=\"ja\">情緒</span><span class=\"kana\" lang=\"ja\">じょうしょ</span><span class=\"k-wz\">情感；感情；气氛；情调；意境</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">折</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>折叠；折断；弯曲；屈服；时机</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セツ・シャク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">お.る・おり・お.り・-お.り・お.れる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">折る</span><span class=\"kana\" lang=\"ja\">おる</span><span class=\"k-wz\">折断；折裂；掰断；摘取（花等）；折叠；弯曲；折（折纸）；打断；结束</span></li><li><span class=\"k-w\" lang=\"ja\">折れる</span><span class=\"kana\" lang=\"ja\">おれる</span><span class=\"k-wz\">折断；断裂；骨折；被折叠；屈服；退让；让步；妥协；转弯；拐弯</span></li><li><span class=\"k-w\" lang=\"ja\">骨折</span><span class=\"kana\" lang=\"ja\">こっせつ</span><span class=\"k-wz\">骨折</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">草</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>草；杂草；牧草；草本；起草</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">くさ・くさ-・-ぐさ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">草</span><span class=\"kana\" lang=\"ja\">くさ</span><span class=\"k-wz\">草；杂草；药草；茅草；忍者；大麻；非正品的；劣质的；哈哈；大笑</span></li><li><span class=\"k-w\" lang=\"ja\">草履</span><span class=\"kana\" lang=\"ja\">ぞうり</span><span class=\"k-wz\">草履；日式夹趾凉鞋</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">暮</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n3\" href=\"../../n3/kanji/\">N3</a>傍晚；暮色；季末；生计；度日</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">く.れる・く.らす</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">暮れる</span><span class=\"kana\" lang=\"ja\">くれる</span><span class=\"k-wz\">天黑；日暮；终了；结束；陷入；沉浸于</span></li><li><span class=\"k-w\" lang=\"ja\">暮れ</span><span class=\"kana\" lang=\"ja\">くれ</span><span class=\"k-wz\">日暮；黄昏；傍晚；终了；结束；年终；岁末</span></li><li><span class=\"k-w\" lang=\"ja\">暮らし</span><span class=\"kana\" lang=\"ja\">くらし</span><span class=\"k-wz\">生活方式；生活；生计；日常生活</span></li></ul></div></li>"]