["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">机</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>桌子；书桌</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つくえ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">机</span><span class=\"kana\" lang=\"ja\">つくえ</span><span class=\"k-wz\">桌子；书桌；办公桌</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">膚</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>皮肤；身体；纹理；质地；性情</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">フ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はだ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">皮膚</span><span class=\"kana\" lang=\"ja\">ひふ</span><span class=\"k-wz\">皮肤</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">濯</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>洗涤；冲洗；漂洗；浇淋</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">タク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">すす.ぐ・ゆす.ぐ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">洗濯</span><span class=\"kana\" lang=\"ja\">せんたく</span><span class=\"k-wz\">洗衣；洗涤；放松；消除（忧虑、疲劳等）</span></li><li><span class=\"k-w\" lang=\"ja\">濯ぐ</span><span class=\"kana\" lang=\"ja\">すすぐ</span><span class=\"k-wz\">漂洗；冲洗；报仇；雪耻；消除耻辱</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">塔</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>塔；尖塔；钟楼</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">塔</span><span class=\"kana\" lang=\"ja\">とう</span><span class=\"k-wz\">塔；尖塔；塔楼；佛塔；宝塔；舍利塔</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">沸</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>沸腾；煮沸；发酵；骚动；滋生</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">フツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">わ.く・わ.かす</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">沸く</span><span class=\"kana\" lang=\"ja\">わく</span><span class=\"k-wz\">（水等）变热；沸腾；烧开；沸腾；欢腾；热烈进行；发酵；酝酿；（金属）熔化；熔解</span></li><li><span class=\"k-w\" lang=\"ja\">沸かす</span><span class=\"kana\" lang=\"ja\">わかす</span><span class=\"k-wz\">烧开；加热；准备（浴水、热饮等）；激发；唤起；激励</span></li><li><span class=\"k-w\" lang=\"ja\">沸騰</span><span class=\"kana\" lang=\"ja\">ふっとう</span><span class=\"k-wz\">沸腾；翻滚；激化；兴奋；躁动；发酵；飙升；急剧上升</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">灰</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>灰烬；灰色；石灰</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はい</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">灰皿</span><span class=\"kana\" lang=\"ja\">はいざら</span><span class=\"k-wz\">烟灰缸；烟灰盘</span></li><li><span class=\"k-w\" lang=\"ja\">灰</span><span class=\"kana\" lang=\"ja\">はい</span><span class=\"k-wz\">灰；灰烬</span></li><li><span class=\"k-w\" lang=\"ja\">灰色</span><span class=\"kana\" lang=\"ja\">はいいろ</span><span class=\"k-wz\">灰色；灰；灰白色</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">菓</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>糕点；糖果；水果</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">お菓子</span><span class=\"kana\" lang=\"ja\">おかし</span><span class=\"k-wz\">糖果；糕点；甜食；零食</span></li><li><span class=\"k-w\" lang=\"ja\">菓子</span><span class=\"kana\" lang=\"ja\">かし</span><span class=\"k-wz\">糖果；糕点；甜食；点心</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">帽</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>帽子；头饰</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボウ・モウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ずきん・おお.う</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">帽子</span><span class=\"kana\" lang=\"ja\">ぼうし</span><span class=\"k-wz\">帽子；帽；（围棋）镇；戴帽</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">枯</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>枯萎；干枯；枯死；凋零</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">コ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">か.れる・か.らす</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">