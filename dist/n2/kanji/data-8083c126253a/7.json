["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">幼</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>幼小；童年</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヨウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おさな.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">幼い</span><span class=\"kana\" lang=\"ja\">おさない</span><span class=\"k-wz\">幼小；年幼；幼稚；不成熟</span></li><li><span class=\"k-w\" lang=\"ja\">幼児</span><span class=\"kana\" lang=\"ja\">ようじ</span><span class=\"k-wz\">幼儿；小儿；（法律）幼儿（满一岁以上、未达入学年龄的儿童）</span></li><li><span class=\"k-w\" lang=\"ja\">幼稚</span><span class=\"kana\" lang=\"ja\">ようち</span><span class=\"k-wz\">幼儿期；婴幼儿期；幼稚的；原始；未成熟</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">荷</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>行李；货物；负载；承担；负荷</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">に</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">荷物</span><span class=\"kana\" lang=\"ja\">にもつ</span><span class=\"k-wz\">行李；包裹；货物；负担；包袱；（数据包等的）有效载荷；净荷</span></li><li><span class=\"k-w\" lang=\"ja\">荷</span><span class=\"kana\" lang=\"ja\">に</span><span class=\"k-wz\">货物；行李；货运；商品；负担；责任</span></li><li><span class=\"k-w\" lang=\"ja\">荷造り</span><span class=\"kana\" lang=\"ja\">にづくり</span><span class=\"k-wz\">打包；捆扎；装箱</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">泊</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>停泊；过夜；使停泊</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ハク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">と.まる・と.める</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">泊まる</span><span class=\"kana\" lang=\"ja\">とまる</span><span class=\"k-wz\">住宿；投宿；停泊；系泊；靠泊</span></li><li><span class=\"k-w\" lang=\"ja\">宿泊</span><span class=\"kana\" lang=\"ja\">しゅくはく</span><span class=\"k-wz\">住宿；投宿</span></li><li><span class=\"k-w\" lang=\"ja\">泊める</span><span class=\"kana\" lang=\"ja\">とめる</span><span class=\"k-wz\">收留；住宿；安置；接待</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">黄</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>黄色</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">コウ・オウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">き・こ-</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">黄色</span><span class=\"kana\" lang=\"ja\">きいろ</span><span class=\"k-wz\">黄色；琥珀色</span></li><li><span class=\"k-w\" lang=\"ja\">黄色い</span><span class=\"kana\" lang=\"ja\">きいろい</span><span class=\"k-wz\">黄色的；黄的；（声音）尖细的；尖锐的</span></li><li><span class=\"k-w\" lang=\"ja\">黄金</span><span class=\"kana\" lang=\"ja\">おうごん</span><span class=\"k-wz\">金；黄金；金色的；繁荣的；优秀的；卓越的；金钱；现金；大判金币</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">寿</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>长寿；祝贺；天年</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジュ・ス・シュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ことぶき・ことぶ.く・ことほ.ぐ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">寿命</span><span class=\"kana\" lang=\"ja\">じゅみょう</span><span class=\"k-wz\">寿命；生命；终身；使用寿命；服役期限；有效期</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">甘</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>甜；宽松；天真；撒娇；纵容</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あま.い・あま.える・あま.やかす・うま.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">甘い</span><span class=\"kana\" lang=\"ja\">あまい</span><span class=\"k-wz\">甜的；甜味的；含糖的；芳香的；悦耳的；口味清淡的；少盐的；不辣的；天真的；过于乐观的；心软的；宽容的；纵容的；好说话的；宽松的；敷衍的；不彻底的；没做完的；不足的；不充分的；不到位的；松弛的；温和的；柔和的；诱人的；有诱惑力的；引诱人的</span></li><li><span class=\"k-w\" lang=\"ja\">甘やかす</span><span class=\"kana\" lang=\"ja\">あまやかす</span><span class=\"k-wz\">娇惯；溺爱；宠坏</span></li><li><span class=\"k-w\" lang=\"ja\">甘口</span><span class=\"kana\" lang=\"ja\">あまくち</span><span class=\"k-wz\">甜味；温和；甜言蜜语；奉承；愚蠢；傻</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">臣</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>家臣；臣子</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シン・ジン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">大臣</span><span class=\"kana\" lang=\"ja\">だいじん</span><span class=\"k-wz\">内阁部长；阁僚</span></li><li><span class=\"k-w\" lang=\"ja\">総理大臣</span><span class=\"kana\" lang=\"ja\">そうりだいじん</span><span class=\"k-wz\">总理大臣；首相；总理</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">浅</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>浅；肤浅；轻浮；可耻；悲惨</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あさ.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">浅い</span><span class=\"kana\" lang=\"ja\">あさい</span><span class=\"k-wz\">浅；肤浅；轻微（伤）；浅（眠）；浅淡（颜色）；不足（知识）；短（时间）；早；年轻</span></li><li><span class=\"k-w\" lang=\"ja\">浅ましい</span><span class=\"kana\" lang=\"ja\">あさましい</span><span class=\"k-wz\">可怜；悲惨；可耻；卑劣；卑鄙；卑贱</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">掃</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>扫；刷</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソウ・シュ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">は.く</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">掃除</span><span class=\"kana\" lang=\"ja\">そうじ</span><span class=\"k-wz\">清扫；打扫；擦拭；刷洗</span></li><li><span class=\"k-w\" lang=\"ja\">清掃</span><span class=\"kana\" lang=\"ja\">せいそう</span><span class=\"k-wz\">清扫；清洁；垃圾清理；清除废物</span></li><li><span class=\"k-w\" lang=\"ja\">掃く</span><span class=\"kana\" lang=\"ja\">はく</span><span class=\"k-wz\">扫；打扫；清扫；收集蚕</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">雲</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>云；云状物</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ウン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">くも・-ぐも</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">雲</span><span class=\"kana\" lang=\"ja\">くも</span><span class=\"k-wz\">云；云彩</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">掘</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>挖掘；掘出；刨</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">クツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ほ.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">掘る</span><span class=\"kana\" lang=\"ja\">ほる</span><span class=\"k-wz\">挖；挖掘；凿空；深入探讨；钻研；挖出（蔬菜、宝物等）；采掘（煤、矿石等）；（与另一男性肛交时）担任插入方；做攻方</span></li><li><span class=\"k-w\" lang=\"ja\">採掘</span><span class=\"kana\" lang=\"ja\">さいくつ</span><span class=\"k-wz\">采掘；开采；挖掘</span></li><li><span class=\"k-w\" lang=\"ja\">発掘</span><span class=\"kana\" lang=\"ja\">はっくつ</span><span class=\"k-wz\">挖掘；出土；发掘；发现；发掘；发现人才</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">捨</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>丢弃；抛弃；放弃；舍弃；牺牲</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シャ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">す.てる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">捨てる</span><span class=\"kana\" lang=\"ja\">すてる</span><span class=\"k-wz\">抛弃；丢弃；扔掉；遗弃；抛弃；舍弃；放弃；辞去；弃子（棋子）</span></li><li><span class=\"k-w\" lang=\"ja\">四捨五入</span><span class=\"kana\" lang=\"ja\">ししゃごにゅう</span><span class=\"k-wz\">四舍五入；观点趋同；达成共识</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">軟</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>柔软；柔和；软</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ナン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">やわ.らか・やわ.らかい</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">軟らかい</span><span class=\"kana\" lang=\"ja\">やわらかい</span><span class=\"k-wz\">柔软；柔嫩；柔韧；灵活；柔和；松软；温柔；温和；柔和；圆润；轻松；书籍等内容浅显；非正式；灵活；思维柔和；可塑；适应强</span></li><li><span class=\"k-w\" lang=\"ja\">柔軟</span><span class=\"kana\" lang=\"ja\">じゅうなん</span><span class=\"k-wz\">灵活；柔软</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">沈</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>沉没；下沉；消沉；沉浸；沉（如沉香）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">チン・ジン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">しず.む・しず.める</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">沈む</span><span class=\"kana\" lang=\"ja\">しずむ</span><span class=\"k-wz\">沉没；沉下；淹没；下沉；西沉；西下；心情低落；变得沉闷；变得阴沉</span></li><li><span class=\"k-w\" lang=\"ja\">沈殿</span><span class=\"kana\" lang=\"ja\">ちんでん</span><span class=\"k-wz\">沉淀；析出；沉降</span></li><li><span class=\"k-w\" lang=\"ja\">沈没</span><span class=\"kana\" lang=\"ja\">ちんぼつ</span><span class=\"k-wz\">沉没；下沉；浸没；烂醉；酩酊大醉；沉湎；贪恋（尤指在风月场所等）而荒废工作；长期逗留；在一个地方待很久</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">凍</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>冻结；结冰；冻僵；冷藏</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">トウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">こお.る・こご.える・こご.る・い.てる・し.みる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">凍る</span><span class=\"kana\" lang=\"ja\">こおる</span><span class=\"k-wz\">冻结；冻住；结冰</span></li><li><span class=\"k-w\" lang=\"ja\">冷凍</span><span class=\"kana\" lang=\"ja\">れいとう</span><span class=\"k-wz\">冷冻；冷藏；冷冻保存</span></li><li><span class=\"k-w\" lang=\"ja\">凍える</span><span class=\"kana\" lang=\"ja\">こごえる</span><span class=\"k-wz\">（身体）冻僵；冻住；（因寒冷）麻木；感到寒冷</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">乳</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>乳汁；乳房</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ニュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ちち・ち</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">牛乳</span><span class=\"kana\" lang=\"ja\">ぎゅうにゅう</span><span class=\"k-wz\">牛奶</span></li><li><span class=\"k-w\" lang=\"ja\">乳</span><span class=\"kana\" lang=\"ja\">ちち</span><span class=\"k-wz\">牛奶；乳汁；乳房；胸部；环；圈；（吊钟表面的）乳状装饰凸起；乳钉</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">恋</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>恋爱；爱慕；思念</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">レン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">こ.う・こい・こい.しい</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">恋</span><span class=\"kana\" lang=\"ja\">こい</span><span class=\"k-wz\">恋爱；爱情</span></li><li><span class=\"k-w\" lang=\"ja\">恋人</span><span class=\"kana\" lang=\"ja\">こいびと</span><span class=\"k-wz\">情人；恋人；男友；女友</span></li><li><span class=\"k-w\" lang=\"ja\">失恋</span><span class=\"kana\" lang=\"ja\">しつれん</span><span class=\"k-wz\">失恋；心碎；单相思；相思病</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">紅</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>深红；红色；胭脂；口红</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\