["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">史</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>历史；史书</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">歴史</span><span class=\"kana\" lang=\"ja\">れきし</span><span class=\"k-wz\">历史</span></li><li><span class=\"k-w\" lang=\"ja\">女史</span><span class=\"kana\" lang=\"ja\">じょし</span><span class=\"k-wz\">（高社会地位的）女士（如女学者、女艺术家、女评论家、女政治家等）；女士；夫人；小姐（用作后缀）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">階</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>楼层；楼梯；（建筑物的）层数</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">きざはし</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">階段</span><span class=\"kana\" lang=\"ja\">かいだん</span><span class=\"k-wz\">阶梯；楼梯</span></li><li><span class=\"k-w\" lang=\"ja\">二階建て</span><span class=\"kana\" lang=\"ja\">にかいだて</span><span class=\"k-wz\">两层楼房；二层建筑</span></li><li><span class=\"k-w\" lang=\"ja\">段階</span><span class=\"kana\" lang=\"ja\">だんかい</span><span class=\"k-wz\">阶段；步骤；时期；等级；等次；品级；分级；顺序；台阶；楼梯</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">管</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>管；管辖；管道；管乐器；醉话</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">くだ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">管</span><span class=\"kana\" lang=\"ja\">かん</span><span class=\"k-wz\">管；管子；管状物；管乐器；（解剖）脉管；导管；（体内的）道、管（如消化道、耳道）；管状物的计数词</span></li><li><span class=\"k-w\" lang=\"ja\">管理</span><span class=\"kana\" lang=\"ja\">かんり</span><span class=\"k-wz\">管理；控制</span></li><li><span class=\"k-w\" lang=\"ja\">血管</span><span class=\"kana\" lang=\"ja\">けっかん</span><span class=\"k-wz\">血管；静脉</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">兵</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>士兵；军队；战争；军事；战术</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヘイ・ヒョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つわもの</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">兵隊</span><span class=\"kana\" lang=\"ja\">へいたい</span><span class=\"k-wz\">军队；武装力量；士兵；普通士兵；士卒；下属；普通员工；小人物</span></li><li><span class=\"k-w\" lang=\"ja\">兵器</span><span class=\"kana\" lang=\"ja\">へいき</span><span class=\"k-wz\">武器；军械；兵器</span></li><li><span class=\"k-w\" lang=\"ja\">兵士</span><span class=\"kana\" lang=\"ja\">へいし</span><span class=\"k-wz\">士兵；军人</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">接</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>接触；连接；拼接；接续；接合</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セツ・ショウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つ.ぐ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">直接</span><span class=\"kana\" lang=\"ja\">ちょくせつ</span><span class=\"k-wz\">直接的；无中介的；亲身的；第一手的</span></li><li><span class=\"k-w\" lang=\"ja\">応接</span><span class=\"kana\" lang=\"ja\">おうせつ</span><span class=\"k-wz\">接待；应对</span></li><li><span class=\"k-w\" lang=\"ja\">間接</span><span class=\"kana\" lang=\"ja\">かんせつ</span><span class=\"k-wz\">间接；间接性</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">細</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>细长；细小；精细；瘦削；变细</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">サイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ほそ.い・ほそ.る・こま.か・こま.かい</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">細い</span><span class=\"kana\" lang=\"ja\">ほそい</span><span class=\"k-wz\">细的；纤细的；精细的；（台球行话）运气差的</span></li><li><span class=\"k-w\" lang=\"ja\">細かい</span><span class=\"kana\" lang=\"ja\">こまかい</span><span class=\"k-wz\">细小的；详细的</span></li><li><span class=\"k-w\" lang=\"ja\">細菌</span><span class=\"kana\" lang=\"ja\">さいきん</span><span class=\"k-wz\">细菌；病菌</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">丸</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>圆形；圆满；丸药；弄圆；卷起</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ガン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">まる・まる.める・まる.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">丸い</span><span class=\"kana\" lang=\"ja\">まるい</span><span class=\"k-wz\">圆形的；圆的；球形的；弯曲的；光滑的；和谐的；温和的；平和的；亲切的；友好的</span></li><li><span class=\"k-w\" lang=\"ja\">丸</span><span class=\"kana\" lang=\"ja\">まる</span><span class=\"k-wz\">圆；圆形；整体；全部；完整；钱；金钱；城郭内的围郭区域；鳖；甲鱼；（用于船名、人名（尤指婴儿）、刀剑·铠甲·乐器等名称、犬马等名称的）后缀</span></li><li><span class=\"k-w\" lang=\"ja\">丸々</span><span class=\"kana\" lang=\"ja\">まるまる</span><span class=\"k-wz\">圆润；丰满；肥胖；完全；彻底；全部</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">湾</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>海湾；港湾</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ワン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">いりえ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">湾</span><span class=\"kana\" lang=\"ja\">わん</span><span class=\"k-wz\">湾；海湾</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">録</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>记录；记载；录制；抄录</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ロク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">しる.す・と.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">記録</span><span class=\"kana\" lang=\"ja\">きろく</span><span class=\"k-wz\">记录；文件；会议记录；日志；录音；记载；存档；纪录（如体育比赛）；创纪录；刷新纪录</span></li><li><span class=\"k-w\" lang=\"ja\">録音</span><span class=\"kana\" lang=\"ja\">ろくおん</span><span class=\"k-wz\">录音</span></li><li><span class=\"k-w\" lang=\"ja\">登録</span><span class=\"kana\" lang=\"ja\">とうろく</span><span class=\"k-wz\">登记；注册；登录；记录；订阅</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">省</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>省（政府机构）；省略；省察</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セイ・ショウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かえり.みる・はぶ.く</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">省く</span><span class=\"kana\" lang=\"ja\">はぶく</span><span class=\"k-wz\">省略；节省</span></li><li><span class=\"k-w\" lang=\"ja\">省略</span><span class=\"kana\" lang=\"ja\">しょうりゃく</span><span class=\"k-wz\">省略；略去；缩写；节略；缩短（如名称）</span></li><li><span class=\"k-w\" lang=\"ja\">反省</span><span class=\"kana\" lang=\"ja\">はんせい</span><span class=\"k-wz\">反省；反思；内省；遗憾；悔改；懊悔；自责</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">旧</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>旧时；旧物；旧友；以前；前任</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ふる.い・もと</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">旧</span><span class=\"kana\" lang=\"ja\">きゅう</span><span class=\"k-wz\">旧；老；前；曾经的；旧物；旧事；旧习；往日；过去的日子；旧历；阴历</span></li><li><span class=\"k-w\" lang=\"ja\">旧知</span><span class=\"kana\" lang=\"ja\">きゅうち</span><span class=\"k-wz\">旧友；老相识</span></li><li><span class=\"k-w\" lang=\"ja\">旧事</span><span class=\"kana\" lang=\"ja\">くじ</span><span class=\"k-wz\">往事；陈年旧事</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">橋</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>桥</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はし</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">橋</span><span class=\"kana\" lang=\"ja\">はし</span><span class=\"k-wz\">桥</span></li><li><span class=\"k-w\" lang=\"ja\">鉄橋</span><span class=\"kana\" lang=\"ja\">てっきょう</span><span class=\"k-wz\">铁路桥；铁桥</span></li><li><span class=\"k-w\" lang=\"ja\">桟橋</span><span class=\"kana\" lang=\"ja\">さんばし</span><span class=\"k-wz\">码头；栈桥；突堤</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">岸</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>海岸；河岸；岸边</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ガン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">きし</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">海岸</span><span class=\"kana\" lang=\"ja\">かいがん</span><span class=\"k-wz\">海岸；海滨；滨海；海边；沙滩</span></li><li><span class=\"k-w\" lang=\"ja\">岸</span><span class=\"kana\" lang=\"ja\">きし</span><span class=\"k-wz\">岸；河岸；海岸</span></li><li><span class=\"k-w\" lang=\"ja\">沿岸</span><span class=\"kana\" lang=\"ja\">えんがん</span><span class=\"k-wz\">海岸；岸边；沿岸水域；近海水域；沿岸地区</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">周</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>周围；巡回；一圈</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">まわ.り</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">周り</span><span class=\"kana\" lang=\"ja\">まわり</span><span class=\"k-wz\">周长；圆周；周围；周围；邻近；附近；周边；周围的人；周围的环境；周围的情况</span></li><li><span class=\"k-w\" lang=\"ja\">周囲</span><span class=\"kana\" lang=\"ja\">しゅうい</span><span class=\"k-wz\">周围；周边；周遭；周长；周围长度</span></li><li><span class=\"k-w\" lang=\"ja\">円周</span><span class=\"kana\" lang=\"ja\">えんしゅう</span><span class=\"k-wz\">圆周</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">材</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>木材；材料；原料；才能；资质</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ザイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">材料</span><span class=\"kana\" lang=\"ja\">ざいりょう</span><span class=\"k-wz\">材料；原料；成分；素材；题材；根据；依据；证据；数据；市场因素；行情要因</span></li><li><span class=\"k-w\" lang=\"ja\">材木</span><span class=\"kana\" lang=\"ja\">ざいもく</span><span class=\"k-wz\">建筑用木材；木料；木材</span></li><li><span class=\"k-w\" lang=\"ja\">木材</span><span class=\"kana\" lang=\"ja\">もくざい</span><span class=\"k-wz\">木材；木料；原木</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">戸</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>门；户（房屋计数单位）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">コ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">と</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">戸</span><span class=\"kana\" lang=\"ja\">こ</span><span class=\"k-wz\">户（计数词，用于计算房屋、住户、公寓等）</span></li><li><span class=\"k-w\" lang=\"ja\">雨戸</span><span class=\"kana\" lang=\"ja\">あまど</span><span class=\"k-wz\">滑动式防风雨窗板；推拉式防暴风雨隔板</span></li><li><span class=\"k-w\" lang=\"ja\">井戸</span><span class=\"kana\" lang=\"ja\">いど</span><span class=\"k-wz\">水井；井</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">央</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>中心；中间</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">オウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">中央</span><span class=\"kana\" lang=\"ja\">ちゅうおう</span><span class=\"k-wz\">中央；中心；中部；核心；首都；政府所在地</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">券</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>票券</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ケン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">券</span><span class=\"kana\" lang=\"ja\">けん</span><span class=\"k-wz\">票；券；债券；证书</span></li><li><span class=\"k-w\" lang=\"ja\">回数券</span><span class=\"kana\" lang=\"ja\">かいすうけん</span><span class=\"k-wz\">回数券；优惠票册；联票</span></li><li><span class=\"k-w\" lang=\"ja\">定期券</span><span class=\"kana\" lang=\"ja\">ていきけん</span><span class=\"k-wz\">月票；季票；定期乘车票</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">編</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>编集；编织；编纂；编（书籍部分）；编（诗作）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヘン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あ.む・-あ.み</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">編物</span><span class=\"kana\" lang=\"ja\">あみもの</span><span class=\"k-wz\">编织；针织品；钩编织物</span></li><li><span class=\"k-w\" lang=\"ja\">編む</span><span class=\"kana\" lang=\"ja\">あむ</span><span class=\"k-wz\">编织；打辫子；编辫；汇编；编纂；编辑</span></li><li><span class=\"k-w\" lang=\"ja\">短編</span><span class=\"kana\" lang=\"ja\">たんぺん</span><span class=\"k-wz\">短篇；短篇小说；短篇电影；短篇诗</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">捜</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>搜索；寻找；查找</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソウ・シュ・シュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さが.す</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">捜す</span><span class=\"kana\" lang=\"ja\">さがす</span><span class=\"k-wz\">寻找；查找；搜索；搜查；翻找；搜寻</span></li><li><span class=\"k-w\" lang=\"ja\">捜査</span><span class=\"kana\" lang=\"ja\">そうさ</span><span class=\"k-wz\">搜查；侦查；调查</span></li><li><span class=\"k-w\" lang=\"ja\">捜索</span><span class=\"kana\" lang=\"ja\">そうさく</span><span class=\"k-wz\">搜索；搜寻；搜救；（依法对人或建筑物等的）搜查</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">竹</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>竹子</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">チク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たけ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">竹</span><span class=\"kana\" lang=\"ja\">たけ</span><span class=\"k-wz\">竹；中等；中级（三级等级制中的中位）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">超</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>超越；超-；极</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">チョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">こ.える・こ.す</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">超す</span><span class=\"kana\" lang=\"ja\">こす</span><span class=\"k-wz\">越过；跨越；穿过；克服；渡过；度过；熬过；超过；胜过；超越；搬家；迁居；（尊敬语）去；来；光临</span></li><li><span class=\"k-w\" lang=\"ja\">超過</span><span class=\"kana\" lang=\"ja\">ちょうか</span><span class=\"k-wz\">超过；超额；超出（限度、预计等）；溢出</span></li><li><span class=\"k-w\" lang=\"ja\">超える</span><span class=\"kana\" lang=\"ja\">こえる</span><span class=\"k-wz\">越过；跨越；穿过；经过；超越；超出；超过；超越；胜过；多于</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">並</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>并列；排列；同等；以及；并排</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ヘイ・ホウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">な.み・なみ・なら.べる・なら.ぶ・なら.びに</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">並ぶ</span><span class=\"kana\" lang=\"ja\">ならぶ</span><span class=\"k-wz\">排队；排成一行；相匹敌；媲美；不相上下</span></li><li><span class=\"k-w\" lang=\"ja\">並べる</span><span class=\"kana\" lang=\"ja\">ならべる</span><span class=\"k-wz\">排列；排成一行；摆成一排；列举；枚举；逐一列出；相等；相当；比得上</span></li><li><span class=\"k-w\" lang=\"ja\">並木</span><span class=\"kana\" lang=\"ja\">なみき</span><span class=\"k-wz\">路边树木；成排的树</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">療</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>治疗；治愈</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">リョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">医療</span><span class=\"kana\" lang=\"ja\">いりょう</span><span class=\"k-wz\">医疗；医疗保健</span></li><li><span class=\"k-w\" lang=\"ja\">診療</span><span class=\"kana\" lang=\"ja\">しんりょう</span><span class=\"k-wz\">诊疗；医疗</span></li><li><span class=\"k-w\" lang=\"ja\">治療</span><span class=\"kana\" lang=\"ja\">ちりょう</span><span class=\"k-wz\">（医学）治疗；护理；疗法；治愈；补救</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">採</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>采取；摘取；选取；获取；采用</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">サイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">と.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">採点</span><span class=\"kana\" lang=\"ja\">さいてん</span><span class=\"k-wz\">批改；评分；打分</span></li><li><span class=\"k-w\" lang=\"ja\">採る</span><span class=\"kana\" lang=\"ja\">とる</span><span class=\"k-wz\">采纳（方法、提议等）；采取（措施、行动等）；决定；采摘（如花朵）；采集（如蘑菇）；捕捉（如昆虫）；提取（如果汁）；取样（如样品）；采取（态度）；摆出（姿态）；招收（工人、学生）；录用；引入（如水）；透入（如窗户的光线）</span></li><li><span class=\"k-w\" lang=\"ja\">採掘</span><span class=\"kana\" lang=\"ja\">さいくつ</span><span class=\"k-wz\">采掘；开采；挖掘</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">森</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>森林；树林</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">もり</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">森</span><span class=\"kana\" lang=\"ja\">もり</span><span class=\"k-wz\">森林；神社树林；神社林</span></li><li><span class=\"k-w\" lang=\"ja\">森林</span><span class=\"kana\" lang=\"ja\">しんりん</span><span class=\"k-wz\">森林；树林</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">競</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>竞争；比赛；竞赛；拍卖；较量</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キョウ・ケイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">きそ.う・せ.る・くら.べる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">競争</span><span class=\"kana\" lang=\"ja\">きょうそう</span><span class=\"k-wz\">竞争；竞赛；角逐；比赛；竞争（生物体或物种之间）</span></li><li><span class=\"k-w\" lang=\"ja\">競技</span><span class=\"kana\" lang=\"ja\">きょうぎ</span><span class=\"k-wz\">竞技；比赛；竞赛；运动项目</span></li><li><span class=\"k-w\" lang=\"ja\">競馬</span><span class=\"kana\" lang=\"ja\">けいば</span><span class=\"k-wz\">赛马；赛马运动</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">介</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>介绍；中介；介入；照料；介壳</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">紹介</span><span class=\"kana\" lang=\"ja\">しょうかい</span><span class=\"k-wz\">介绍；引见；推荐；展示</span></li><li><span class=\"k-w\" lang=\"ja\">厄介</span><span class=\"kana\" lang=\"ja\">やっかい</span><span class=\"k-wz\">麻烦；负担；讨厌的事物；烦恼；困扰；照顾；依赖；扶养；恩惠；义务；寄宿</span></li><li><span class=\"k-w\" lang=\"ja\">介護</span><span class=\"kana\" lang=\"ja\">かいご</span><span class=\"k-wz\">护理；照护；看护；护理服务</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">根</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>根；根部；源头；（青春痘的）头</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">コン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ね・-ね</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">根</span><span class=\"kana\" lang=\"ja\">ね</span><span class=\"k-wz\">植物的根；（牙齿、毛发等的）根；（粉刺等的）核；（万恶等的）根源；源头；起因；基础；本性；真性情；（钓鱼用语）暗礁</span></li><li><span class=\"k-w\" lang=\"ja\">屋根</span><span class=\"kana\" lang=\"ja\">やね</span><span class=\"k-wz\">屋顶；房顶</span></li><li><span class=\"k-w\" lang=\"ja\">垣根</span><span class=\"kana\" lang=\"ja\">かきね</span><span class=\"k-wz\">篱笆；围栏；界限；分界线</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">販</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>贩卖；销售；交易</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ハン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">販売</span><span class=\"kana\" lang=\"ja\">はんばい</span><span class=\"k-wz\">销售；出售；售卖；营销</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">歴</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>经历；时间流逝；连续；历程</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">レキ・レッキ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">歴史</span><span class=\"kana\" lang=\"ja\">れきし</span><span class=\"k-wz\">历史</span></li><li><span class=\"k-w\" lang=\"ja\">学歴</span><span class=\"kana\" lang=\"ja\">がくれき</span><span class=\"k-wz\">学历；学业经历；学业背景</span></li><li><span class=\"k-w\" lang=\"ja\">経歴</span><span class=\"kana\" lang=\"ja\">けいれき</span><span class=\"k-wz\">经历；履历；背景</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">将</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>将领；即将；或者；又；率领</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショウ・ソウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">まさ.に・はた・まさ・ひきい.る・もって</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">将来</span><span class=\"kana\" lang=\"ja\">しょうらい</span><span class=\"k-wz\">将来</span></li><li><span class=\"k-w\" lang=\"ja\">将棋</span><span class=\"kana\" lang=\"ja\">しょうぎ</span><span class=\"k-wz\">将棋；日本象棋</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">幅</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>宽度；挂轴</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">フク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はば</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">幅</span><span class=\"kana\" lang=\"ja\">はば</span><span class=\"k-wz\">宽度；宽；余地；幅度；范围；差距；差异；幅度</span></li><li><span class=\"k-w\" lang=\"ja\">大幅</span><span class=\"kana\" lang=\"ja\">おおはば</span><span class=\"k-wz\">大幅度；大规模；剧烈；相当大的；全幅布料（传统和服用约72厘米宽；西式服装用约140厘米宽）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">般</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>一般；全部；种类；搬运</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ハン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">一般</span><span class=\"kana\" lang=\"ja\">いっぱん</span><span class=\"k-wz\">一般；普遍；通用；普通；平均；常见；非名人；相同；无异；如同</span></li><li><span class=\"k-w\" lang=\"ja\">全般</span><span class=\"kana\" lang=\"ja\">ぜんぱん</span><span class=\"k-wz\">全部；整体；总体上；一般而言；大体上</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">貿</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>贸易；交换</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">貿易</span><span class=\"kana\" lang=\"ja\">ぼうえき</span><span class=\"k-wz\">（对外）贸易；国际贸易；进出口贸易</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">講</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>讲解；讲授；讲座；结社</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">コウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">講義</span><span class=\"kana\" lang=\"ja\">こうぎ</span><span class=\"k-wz\">讲课；讲授；授课；讲座</span></li><li><span class=\"k-w\" lang=\"ja\">講堂</span><span class=\"kana\" lang=\"ja\">こうどう</span><span class=\"k-wz\">礼堂；讲堂</span></li><li><span class=\"k-w\" lang=\"ja\">講演</span><span class=\"kana\" lang=\"ja\">こうえん</span><span class=\"k-wz\">讲演；演讲；讲座</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">林</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>树林；森林</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">リン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はやし</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">林</span><span class=\"kana\" lang=\"ja\">はやし</span><span class=\"k-wz\">林木；树林；森林；小树林；灌木丛；一束；一簇；一排；集合</span></li><li><span class=\"k-w\" lang=\"ja\">山林</span><span class=\"kana\" lang=\"ja\">さんりん</span><span class=\"k-wz\">山林；山地林木；林地；林区；山岳与森林；山与林</span></li><li><span class=\"k-w\" lang=\"ja\">森林</span><span class=\"kana\" lang=\"ja\">しんりん</span><span class=\"k-wz\">森林；树林</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">装</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>装备；装置；安装；装扮；假装</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソウ・ショウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">よそお.う・よそお.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">装置</span><span class=\"kana\" lang=\"ja\">そうち</span><span class=\"k-wz\">设备；装置；器械；舞台布景；布景</span></li><li><span class=\"k-w\" lang=\"ja\">服装</span><span class=\"kana\" lang=\"ja\">ふくそう</span><span class=\"k-wz\">衣服；服装；衣着；服饰</span></li><li><span class=\"k-w\" lang=\"ja\">包装</span><span class=\"kana\" lang=\"ja\">ほうそう</span><span class=\"k-wz\">包装；打包</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">諸</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>众多；各种；一起</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">もろ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">諸</span><span class=\"kana\" lang=\"ja\">しょ</span><span class=\"k-wz\">各种；众多；若干</span></li><li><span class=\"k-w\" lang=\"ja\">諸君</span><span class=\"kana\" lang=\"ja\">しょくん</span><span class=\"k-wz\">你们；诸位；诸君；各位；女士们先生们；大家</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">劇</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>戏剧；剧烈</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ゲキ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">劇</span><span class=\"kana\" lang=\"ja\">げき</span><span class=\"k-wz\">戏剧；话剧；戏；烈性药；强效药</span></li><li><span class=\"k-w\" lang=\"ja\">劇場</span><span class=\"kana\" lang=\"ja\">げきじょう</span><span class=\"k-wz\">戏院；剧院；剧场</span></li><li><span class=\"k-w\" lang=\"ja\">悲劇</span><span class=\"kana\" lang=\"ja\">ひげき</span><span class=\"k-wz\">悲剧；悲剧戏剧；悲剧；灾难；不幸事件</span></li></ul></div></li>"]