["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">河</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>河流</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かわ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">河</span><span class=\"kana\" lang=\"ja\">かわ</span><span class=\"k-wz\">河流；溪流；河（用于河流名称）</span></li><li><span class=\"k-w\" lang=\"ja\">運河</span><span class=\"kana\" lang=\"ja\">うんが</span><span class=\"k-wz\">运河；水道</span></li><li><span class=\"k-w\" lang=\"ja\">河川</span><span class=\"kana\" lang=\"ja\">かせん</span><span class=\"k-wz\">河川；河流</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">航</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>航行；飞行；巡航</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">コウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">航空</span><span class=\"kana\" lang=\"ja\">こうくう</span><span class=\"k-wz\">航空；飞行</span></li><li><span class=\"k-w\" lang=\"ja\">航海</span><span class=\"kana\" lang=\"ja\">こうかい</span><span class=\"k-wz\">海上航行；航海；航行；航程；航海旅行</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">鉄</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>铁</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">テツ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">くろがね</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">地下鉄</span><span class=\"kana\" lang=\"ja\">ちかてつ</span><span class=\"k-wz\">地铁</span></li><li><span class=\"k-w\" lang=\"ja\">鉄</span><span class=\"kana\" lang=\"ja\">てつ</span><span class=\"k-wz\">铁；钢；铁的；坚定的；铁血的；铁路；铁道；铁路迷；铁道迷</span></li><li><span class=\"k-w\" lang=\"ja\">鉄道</span><span class=\"kana\" lang=\"ja\">てつどう</span><span class=\"k-wz\">铁路；铁道；轨道运输</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">児</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>婴儿；孩子；幼兽</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジ・ニ・ゲイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">こ・-こ・-っこ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">育児</span><span class=\"kana\" lang=\"ja\">いくじ</span><span class=\"k-wz\">育儿；抚养；养育</span></li><li><span class=\"k-w\" lang=\"ja\">児童</span><span class=\"kana\" lang=\"ja\">じどう</span><span class=\"k-wz\">儿童；少年</span></li><li><span class=\"k-w\" lang=\"ja\">幼児</span><span class=\"kana\" lang=\"ja\">ようじ</span><span class=\"k-wz\">幼儿；小儿；（法律）幼儿（满一岁以上、未达入学年龄的儿童）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">禁</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>禁止；禁令；严禁</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">禁煙</span><span class=\"kana\" lang=\"ja\">きんえん</span><span class=\"k-wz\">戒烟；禁止吸烟；禁烟；（告示牌用语）禁止吸烟；请勿吸烟</span></li><li><span class=\"k-w\" lang=\"ja\">禁止</span><span class=\"kana\" lang=\"ja\">きんし</span><span class=\"k-wz\">禁止；禁令；制止</span></li><li><span class=\"k-w\" lang=\"ja\">禁物</span><span class=\"kana\" lang=\"ja\">きんもつ</span><span class=\"k-wz\">禁忌；忌讳；不能做的事；应该避免的事物</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">印</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>印章；印记；象征；证据；纪念品</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">イン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">しるし・-じるし・しる.す</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">印</span><span class=\"kana\" lang=\"ja\">いん</span><span class=\"k-wz\">印章；图章；戳；印迹；印记；戳记；手印；印契（佛教象征性手势）；忍者手印；印度</span></li><li><span class=\"k-w\" lang=\"ja\">印刷</span><span class=\"kana\" lang=\"ja\">いんさつ</span><span class=\"k-wz\">印刷</span></li><li><span class=\"k-w\" lang=\"ja\">印象</span><span class=\"kana\" lang=\"ja\">いんしょう</span><span class=\"k-wz\">印象</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">逆</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>相反；逆向；颠倒；邪恶</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ギャク・ゲキ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さか・さか.さ・さか.らう</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">逆</span><span class=\"kana\" lang=\"ja\">ぎゃく</span><span class=\"k-wz\">相反；对立；逆向；逆命题；逆（函数）</span></li><li><span class=\"k-w\" lang=\"ja\">逆らう</span><span class=\"kana\" lang=\"ja\">さからう</span><span class=\"k-wz\">违抗；反抗；违逆；不服从</span></li><li><span class=\"k-w\" lang=\"ja\">逆さ</span><span class=\"kana\" lang=\"ja\">さかさ</span><span class=\"k-wz\">倒转的；颠倒的；反向的</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">換</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>交换；更换；替换；转换；兑换</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">か.える・-か.える・か.わる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">乗り換える</span><span class=\"kana\" lang=\"ja\">のりかえる</span><span class=\"k-wz\">换乘；转乘（火车、公交等）；改变；转换；转向（思想、党派、公司等）</span></li><li><span class=\"k-w\" lang=\"ja\">交換</span><span class=\"kana\" lang=\"ja\">こうかん</span><span class=\"k-wz\">交换；互换；转换；互惠；易货；替换；替代；票据交换（支票等）</span></li><li><span class=\"k-w\" lang=\"ja\">換える</span><span class=\"kana\" lang=\"ja\">かえる</span><span class=\"k-wz\">替换；转换；改变；交换；互换；更新；替代（人员、职员、选手等）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">久</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>长久；旧事</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キュウ・ク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ひさ.しい</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">久しぶり</span><span class=\"kana\" lang=\"ja\">ひさしぶり</span><span class=\"k-wz\">久违；阔别已久；许久（未见）；好久不见；许久不见</span></li><li><span class=\"k-w\" lang=\"ja\">永久</span><span class=\"kana\" lang=\"ja\">えいきゅう</span><span class=\"k-wz\">永久；永恒；永远；永久年间（1113年7月13日-1118年4月3日）</span></li><li><span class=\"k-w\" lang=\"ja\">久しい</span><span class=\"kana\" lang=\"ja\">ひさしい</span><span class=\"k-wz\">久远的；长久的；（故事等）久远的</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">短</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>短；缺点；弱点；不足；短暂</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">タン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">みじか.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">短い</span><span class=\"kana\" lang=\"ja\">みじかい</span><span class=\"k-wz\">短的；短小；简短的；短暂的</span></li><li><span class=\"k-w\" lang=\"ja\">短期</span><span class=\"kana\" lang=\"ja\">たんき</span><span class=\"k-wz\">短期；短期的</span></li><li><span class=\"k-w\" lang=\"ja\">短所</span><span class=\"kana\" lang=\"ja\">たんしょ</span><span class=\"k-wz\">缺点；短处；弱点；不足之处</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">油</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>油；脂肪</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ユ・ユウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あぶら</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">油</span><span class=\"kana\" lang=\"ja\">あぶら</span><span class=\"k-wz\">油</span></li><li><span class=\"k-w\" lang=\"ja\">石油</span><span class=\"kana\" lang=\"ja\">せきゆ</span><span class=\"k-wz\">石油；原油；（口语）煤油；火油</span></li><li><span class=\"k-w\" lang=\"ja\">灯油</span><span class=\"kana\" lang=\"ja\">とうゆ</span><span class=\"k-wz\">煤油；石油灯油；灯用油</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">暴</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>爆发；暴力；残酷；狂暴；揭露</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ボウ・バク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あば.く・あば.れる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">乱暴</span><span class=\"kana\" lang=\"ja\">らんぼう</span><span class=\"k-wz\">暴力；殴打；骚乱；蛮横；为非作歹；粗暴；鲁莽；不谨慎；粗糙；无礼；蛮不讲理；荒唐；强奸；性暴力</span></li><li><span class=\"k-w\" lang=\"ja\">暴れる</span><span class=\"kana\" lang=\"ja\">あばれる</span><span class=\"k-wz\">暴动；狂怒；挣扎；骚乱</span></li><li><span class=\"k-w\" lang=\"ja\">暴露</span><span class=\"kana\" lang=\"ja\">ばくろ</span><span class=\"k-wz\">泄露；曝光；揭露</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">輪</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>车轮；圆环；圆圈；轮流；量词（车轮、花）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">リン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">わ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">指輪</span><span class=\"kana\" lang=\"ja\">ゆびわ</span><span class=\"k-wz\">戒指；指环</span></li><li><span class=\"k-w\" lang=\"ja\">輪</span><span class=\"kana\" lang=\"ja\">りん</span><span class=\"k-wz\">轮、花（量词）</span></li><li><span class=\"k-w\" lang=\"ja\">車輪</span><span class=\"kana\" lang=\"ja\">しゃりん</span><span class=\"k-wz\">车轮；车轱辘</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">占</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>占据；占有；占卜；预测</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">し.める・うらな.う</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">占める</span><span class=\"kana\" lang=\"ja\">しめる</span><span class=\"k-wz\">占</span></li><li><span class=\"k-w\" lang=\"ja\">占う</span><span class=\"kana\" lang=\"ja\">うらなう</span><span class=\"k-wz\">占卜；算命；预言未来；预测；预报</span></li><li><span class=\"k-w\" lang=\"ja\">占領</span><span class=\"kana\" lang=\"ja\">せんりょう</span><span class=\"k-wz\">独占；独自拥有；占领；军事占领</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">植</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>种植；栽种</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">う.える・う.わる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">植える</span><span class=\"kana\" lang=\"ja\">うえる</span><span class=\"k-wz\">种植；培育；栽培；插入；移植；植入；排版；接种（如传染性病原体）；灌输（思想、价值观等）；培养</span></li><li><span class=\"k-w\" lang=\"ja\">植物</span><span class=\"kana\" lang=\"ja\">しょくぶつ</span><span class=\"k-wz\">植物；植被</span></li><li><span class=\"k-w\" lang=\"ja\">植木</span><span class=\"kana\" lang=\"ja\">うえき</span><span class=\"k-wz\">庭院植物；庭院树木；盆栽植物</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">清</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>纯净；净化；清除；驱邪；清朝（中国朝代）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セイ・ショウ・シン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">きよ.い・きよ.まる・きよ.める</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">清潔</span><span class=\"kana\" lang=\"ja\">せいけつ</span><span class=\"k-wz\">清洁；卫生；整洁；纯洁；高尚；无瑕</span></li><li><span class=\"k-w\" lang=\"ja\">清い</span><span class=\"kana\" lang=\"ja\">きよい</span><span class=\"k-wz\">洁净；清澈；纯洁；清廉；清白；无辜；柏拉图式的；贞洁</span></li><li><span class=\"k-w\" lang=\"ja\">清む</span><span class=\"kana\" lang=\"ja\">すむ</span><span class=\"k-wz\">（水、空气等）变清澈；变透明；（声音等）清脆响亮；清澈悦耳；变得平静；变得宁静；消除烦恼；发清音；读作清音</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">倍</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>两倍；加倍；倍数；倍率</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">バイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">倍</span><span class=\"kana\" lang=\"ja\">ばい</span><span class=\"k-wz\">两倍；双倍；倍；倍数；n分之一；n分之一的</span></li><li><span class=\"k-w\" lang=\"ja\">倍率</span><span class=\"kana\" lang=\"ja\">ばいりつ</span><span class=\"k-wz\">放大倍数；放大倍率；缩放因子；杠杆倍率；报考倍率；竞争率（报考人数与录取人数之比）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">均</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>平均；均衡；均匀</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">なら.す</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">平均</span><span class=\"kana\" lang=\"ja\">へいきん</span><span class=\"k-wz\">平均；平均值；均值；平衡；均衡；均势</span></li><li><span class=\"k-w\" lang=\"ja\">均衡</span><span class=\"kana\" lang=\"ja\">きんこう</span><span class=\"k-wz\">均衡；平衡；均势</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">億</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>一亿</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">オク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">億</span><span class=\"kana\" lang=\"ja\">おく</span><span class=\"k-wz\">亿；一亿；十的八次方</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">圧</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>压力；压迫；压制；压倒；按压</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">アツ・エン・オウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">お.す・へ.す・おさ.える・お.さえる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">圧縮</span><span class=\"kana\" lang=\"ja\">あっしゅく</span><span class=\"k-wz\">压缩；浓缩；缩短；概括；（数据的）压缩</span></li><li><span class=\"k-w\" lang=\"ja\">気圧</span><span class=\"kana\" lang=\"ja\">きあつ</span><span class=\"k-wz\">气压；大气压；大气压（压强单位）</span></li><li><span class=\"k-w\" lang=\"ja\">血圧</span><span class=\"kana\" lang=\"ja\">けつあつ</span><span class=\"k-wz\">血压</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">芸</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>技艺；表演；技巧；特技；手艺</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ゲイ・ウン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">う.える・のり・わざ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">芸術</span><span class=\"kana\" lang=\"ja\">げいじゅつ</span><span class=\"k-wz\">艺术</span></li><li><span class=\"k-w\" lang=\"ja\">園芸</span><span class=\"kana\" lang=\"ja\">えんげい</span><span class=\"k-wz\">园艺</span></li><li><span class=\"k-w\" lang=\"ja\">芸能</span><span class=\"kana\" lang=\"ja\">げいのう</span><span class=\"k-wz\">公众娱乐；表演艺术；才艺；造诣</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">署</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>署名；政府机关；警察局</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ショ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\"></dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">署名</span><span class=\"kana\" lang=\"ja\">しょめい</span><span class=\"k-wz\">签名；署名；亲笔签名</span></li><li><span class=\"k-w\" lang=\"ja\">消防署</span><span class=\"kana\" lang=\"ja\">しょうぼうしょ</span><span class=\"k-wz\">消防署；消防站</span></li><li><span class=\"k-w\" lang=\"ja\">税務署</span><span class=\"kana\" lang=\"ja\">ぜいむしょ</span><span class=\"k-wz\">税务署；税务所</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">伸</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>伸长；伸展；扩展；延长；增加</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">シン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">の.びる・の.ばす・の.べる・の.す</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">伸ばす</span><span class=\"kana\" lang=\"ja\">のばす</span><span class=\"k-wz\">（头发、指甲等）长长；延长；伸长；拉长；伸出；递出；伸向；拉直；弄平；涂抹均匀；摊平（面团、奶油等）；稀释；冲淡；延迟；推迟；延长；拖长；加强；发展；扩大</span></li><li><span class=\"k-w\" lang=\"ja\">伸びる</span><span class=\"kana\" lang=\"ja\">のびる</span><span class=\"k-wz\">伸长；延长；拉长；生长（头发、身高、草等）；伸直；压平；变光滑；涂开；抹开（油漆、奶油等）；伸出；延伸（如手）；失去弹性；松弛；变软烂（如面条）；取得进展；发展；扩张；增加；提高；筋疲力尽；头昏眼花；被击晕；昏倒；倒下；延长；拖长（会议、寿命等）；延至（截止日期等）；变长（日子等）；延期；延误；推迟；获得关注；获得浏览量；表现良好（网络帖子、视频等）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">停</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>停止；停下；止住</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">テイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">と.める・と.まる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">停留所</span><span class=\"kana\" lang=\"ja\">ていりゅうじょ</span><span class=\"k-wz\">（公交车、电车等的）停靠站；停留所；停靠点</span></li><li><span class=\"k-w\" lang=\"ja\">停止</span><span class=\"kana\" lang=\"ja\">ていし</span><span class=\"k-wz\">停止；停顿；中止；静止；停工；暂停；中断；切断；暂停；禁止；禁令；停演；停舞（作为哀悼重要人物的标志）</span></li><li><span class=\"k-w\" lang=\"ja\">停車</span><span class=\"kana\" lang=\"ja\">ていしゃ</span><span class=\"k-wz\">停车；停止</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">爆</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>爆炸；爆裂；迸开；炸开</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">バク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">は.ぜる</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">爆発</span><span class=\"kana\" lang=\"ja\">ばくはつ</span><span class=\"k-wz\">爆炸；爆发；（情绪的）爆发；（愤怒的）爆发；（不满的）爆发</span></li><li><span class=\"k-w\" lang=\"ja\">原爆</span><span class=\"kana\" lang=\"ja\">げんばく</span><span class=\"k-wz\">原子弹；原爆</span></li><li><span class=\"k-w\" lang=\"ja\">爆弾</span><span class=\"kana\" lang=\"ja\">ばくだん</span><span class=\"k-wz\">炸弹；掺烈酒的饮料（尤指以葡萄酒为基酒的烧酎高球鸡尾酒，也指啤酒兑威士忌）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">陸</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>陆地；六（数字6）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">リク・ロク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おか</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">陸</span><span class=\"kana\" lang=\"ja\">りく</span><span class=\"k-wz\">陆地；岸</span></li><li><span class=\"k-w\" lang=\"ja\">大陸</span><span class=\"kana\" lang=\"ja\">たいりく</span><span class=\"k-wz\">大陆；洲；亚洲大陆（尤指中国大陆）；欧洲大陆</span></li><li><span class=\"k-w\" lang=\"ja\">上陸</span><span class=\"kana\" lang=\"ja\">じょうりく</span><span class=\"k-wz\">登陆；上岸；下船；（台风等）登陆；袭陆</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">玉</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>宝石；球</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ギョク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たま・たま-・-だま</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">玉</span><span class=\"kana\" lang=\"ja\">ぎょく</span><span class=\"k-wz\">玉石；宝石（尤指玉）；（烹饪）蛋；鸡蛋（尤指寿司上的蛋）；交易中的股票或证券；买卖的商品；头寸；持仓；艺妓；艺妓的时间费用；艺妓的陪侍费；（将棋）玉将（下手一方所用的王将）</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">波</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>波浪；波涛；波兰（国名）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ハ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">なみ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">波</span><span class=\"kana\" lang=\"ja\">なみ</span><span class=\"k-wz\">波浪；浪涛；涟漪；拍岸浪；涌浪；起伏；波动；逐步推进；势不可挡的推进；连续变化；趋势；新浪潮</span></li><li><span class=\"k-w\" lang=\"ja\">電波</span><span class=\"kana\" lang=\"ja\">でんぱ</span><span class=\"k-wz\">电波；无线电波；信号接收；说奇怪的话；胡言乱语</span></li><li><span class=\"k-w\" lang=\"ja\">短波</span><span class=\"kana\" lang=\"ja\">たんぱ</span><span class=\"k-wz\">短波</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">狙</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>瞄准；目标；狙击；伺机</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソ・ショ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ねら.う・ねら.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">狙い</span><span class=\"kana\" lang=\"ja\">ねらい</span><span class=\"k-wz\">（枪、弓等的）瞄准；准星；目的；目标；意图；企图</span></li><li><span class=\"k-w\" lang=\"ja\">狙う</span><span class=\"kana\" lang=\"ja\">ねらう</span><span class=\"k-wz\">瞄准；对准；图谋；盯上；企图占为己有；争取；以……为目标</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">帯</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>带子；地带；带有；佩戴；区域</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">タイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">お.びる・おび</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">帯</span><span class=\"kana\" lang=\"ja\">おび</span><span class=\"k-wz\">腰带（和服用）；书腰（套于书籍、CD等外侧的纸带）；带；带状物；条形物；带状结构；环带；带状节目（每天固定时段播出的广播或电视节目）</span></li><li><span class=\"k-w\" lang=\"ja\">熱帯</span><span class=\"kana\" lang=\"ja\">ねったい</span><span class=\"k-wz\">热带</span></li><li><span class=\"k-w\" lang=\"ja\">温帯</span><span class=\"kana\" lang=\"ja\">おんたい</span><span class=\"k-wz\">温带</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">延</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>延长；伸展；推迟；延伸；展开</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">エン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">の.びる・の.べる・の.べ・の.ばす</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">延期</span><span class=\"kana\" lang=\"ja\">えんき</span><span class=\"k-wz\">延期；推迟；展期</span></li><li><span class=\"k-w\" lang=\"ja\">延長</span><span class=\"kana\" lang=\"ja\">えんちょう</span><span class=\"k-wz\">延长；拉长；延伸；延长；（总）长度；延续；继续；延伸（如工作的延伸）；线段的延长线；广延性；占据空间的属性；延长年间（923年4月11日—931年4月26日）；延长赛；加时赛；延长局</span></li><li><span class=\"k-w\" lang=\"ja\">延ばす</span><span class=\"kana\" lang=\"ja\">のばす</span><span class=\"k-wz\">（头发、指甲等）长长；延长；伸长；拉长；伸出；递出；伸向；拉直；弄平；涂抹均匀；摊平（面团、奶油等）；稀释；冲淡；延迟；推迟；延长；拖长；加强；发展；扩大</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">羽</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>羽毛；翅膀；量词（鸟、兔）</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">は・わ・はね</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">羽</span><span class=\"kana\" lang=\"ja\">はね</span><span class=\"k-wz\">羽毛；羽绒；翅膀；翼；叶片；扇叶；螺旋桨叶；羽毛球；羽子（日本羽子板游戏中用板击打的带羽毛的球）；箭羽</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">固</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>凝固；变硬；凝固物；使凝固；坚固</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">コ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かた.める・かた.まる・かた.まり・かた.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">固い</span><span class=\"kana\" lang=\"ja\">かたい</span><span class=\"k-wz\">硬；坚硬；结实；僵硬；生硬；不流畅；不自然（如文章）；强；稳固；不易动摇；安全；稳妥；诚实；可靠；固执；顽固；书面化；正式；古板；拘谨</span></li><li><span class=\"k-w\" lang=\"ja\">固まる</span><span class=\"kana\" lang=\"ja\">かたまる</span><span class=\"k-wz\">变硬；凝固；变得坚定；确定下来；聚集；集合；挤在一起；（电脑）死机；卡住；停止响应</span></li><li><span class=\"k-w\" lang=\"ja\">頑固</span><span class=\"kana\" lang=\"ja\">がんこ</span><span class=\"k-wz\">顽固；固执；死脑筋</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">則</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>法则；遵循；依据；效法</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">のっと.る・のり・すなわち</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">規則</span><span class=\"kana\" lang=\"ja\">きそく</span><span class=\"k-wz\">规则；规定</span></li><li><span class=\"k-w\" lang=\"ja\">法則</span><span class=\"kana\" lang=\"ja\">ほうそく</span><span class=\"k-wz\">法则；规则</span></li><li><span class=\"k-w\" lang=\"ja\">不規則</span><span class=\"kana\" lang=\"ja\">ふきそく</span><span class=\"k-wz\">不规则；无规律；不稳定；混乱</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">乱</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>混乱；骚乱；扰乱；战乱；无序</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ラン・ロン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">みだ.れる・みだ.る・みだ.す・みだ・おさ.める・わた.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">混乱</span><span class=\"kana\" lang=\"ja\">こんらん</span><span class=\"k-wz\">混乱；混沌；无序；混乱状态</span></li><li><span class=\"k-w\" lang=\"ja\">乱暴</span><span class=\"kana\" lang=\"ja\">らんぼう</span><span class=\"k-wz\">暴力；殴打；骚乱；蛮横；为非作歹；粗暴；鲁莽；不谨慎；粗糙；无礼；蛮不讲理；荒唐；强奸；性暴力</span></li><li><span class=\"k-w\" lang=\"ja\">内乱</span><span class=\"kana\" lang=\"ja\">ないらん</span><span class=\"k-wz\">内乱；叛乱；反叛；国内冲突</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">測</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>测量；推测；预测</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">はか.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">予測</span><span class=\"kana\" lang=\"ja\">よそく</span><span class=\"k-wz\">预测；推测</span></li><li><span class=\"k-w\" lang=\"ja\">観測</span><span class=\"kana\" lang=\"ja\">かんそく</span><span class=\"k-wz\">观测；观察；测量；见解；预测；推断</span></li><li><span class=\"k-w\" lang=\"ja\">測定</span><span class=\"kana\" lang=\"ja\">そくてい</span><span class=\"k-wz\">测定；测量</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">豊</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>丰富；丰盛；丰饶；丰裕；丰硕</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ホウ・ブ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ゆた.か・とよ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">豊富</span><span class=\"kana\" lang=\"ja\">ほうふ</span><span class=\"k-wz\">丰富；充裕；富有；充分</span></li><li><span class=\"k-w\" lang=\"ja\">豊か</span><span class=\"kana\" lang=\"ja\">ゆたか</span><span class=\"k-wz\">丰富；充裕；充分；富足；富有；富裕；殷实；宽裕；开放；轻松；从容；丰满；饱满；充盈；超过；远超；轻松超出</span></li><li><span class=\"k-w\" lang=\"ja\">豊作</span><span class=\"kana\" lang=\"ja\">ほうさく</span><span class=\"k-wz\">丰收；大丰收</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">厚</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>厚；浓；深厚；厚颜；亲切</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">コウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あつ.い・あか</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">厚い</span><span class=\"kana\" lang=\"ja\">あつい</span><span class=\"k-wz\">厚；深；重；亲切；热情；好客；温暖；忠实；（病情）严重；丰厚；充裕</span></li><li><span class=\"k-w\" lang=\"ja\">厚かましい</span><span class=\"kana\" lang=\"ja\">あつかましい</span><span class=\"k-wz\">厚颜无耻；恬不知耻；厚脸皮；放肆；冒昧</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">齢</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>年龄</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">レイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">よわい・とし</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">年齢</span><span class=\"kana\" lang=\"ja\">ねんれい</span><span class=\"k-wz\">年龄；年岁</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">囲</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>包围；围困；围栏；围起来；保存</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">イ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">かこ.む・かこ.う・かこ.い</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">囲む</span><span class=\"kana\" lang=\"ja\">かこむ</span><span class=\"k-wz\">围绕；包围；圈围；围护；围困；围攻；下（围棋、将棋等）；对弈</span></li><li><span class=\"k-w\" lang=\"ja\">周囲</span><span class=\"kana\" lang=\"ja\">しゅうい</span><span class=\"k-wz\">周围；周边；周遭；周长；周围长度</span></li><li><span class=\"k-w\" lang=\"ja\">範囲</span><span class=\"kana\" lang=\"ja\">はんい</span><span class=\"k-wz\">范围；范畴；领域；幅度</span></li></ul></div></li>"]