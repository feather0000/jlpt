["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">巾</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>布巾；挂轴；宽度；覆盖；布</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">キン・フク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">おお.い・ちきり・きれ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">雑巾</span><span class=\"kana\" lang=\"ja\">ぞうきん</span><span class=\"k-wz\">抹布；擦布</span></li><li><span class=\"k-w\" lang=\"ja\">布巾</span><span class=\"kana\" lang=\"ja\">ふきん</span><span class=\"k-wz\">擦碗布；茶巾；洗碗布</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">捻</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>扭；拧；捻；玩弄</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ネン・ジョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ね.じる・ねじ.る・ひね.くる・ひね.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">捻る</span><span class=\"kana\" lang=\"ja\">ひねる</span><span class=\"k-wz\">拧；转（水龙头、开关等）；扭动（身体部位）；扭转；弯曲；扭伤；勒死；掐死；拧断（动物的脖子）；轻松击败；打败；使复杂；使奇特；使繁琐；设法写出；创作（俳句、歌曲等）；用纸包裹（礼金）</span></li><li><span class=\"k-w\" lang=\"ja\">捻じれる</span><span class=\"kana\" lang=\"ja\">ねじれる</span><span class=\"k-wz\">扭曲；弯曲；翘曲；心理扭曲；关系扭曲；变得乖张；背离；陷入困境；变得复杂；关系紧张</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">桁</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>横梁；帆桁；位数</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">コウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">けた</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">桁</span><span class=\"kana\" lang=\"ja\">けた</span><span class=\"k-wz\">柱；梁；横梁；大梁；桁条；（帆船的）帆桁；（数字的）位；位数；十进位级；数量级</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">潰</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>压碎；砸碎；打破；消散</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">カイ・エ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">つぶ.す・つぶ.れる・つい.える</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">潰す</span><span class=\"kana\" lang=\"ja\">つぶす</span><span class=\"k-wz\">压碎；压扁；压平；关闭；使停业；迫使（公司）关门；破坏；损坏；阻挠；挫折；屠宰；宰杀；杀死（家畜作为食物）；消磨（时间）；打发（时间）；消耗（时间）；浪费（例如才能）</span></li><li><span class=\"k-w\" lang=\"ja\">潰れる</span><span class=\"kana\" lang=\"ja\">つぶれる</span><span class=\"k-wz\">被压碎；被压扁；被砸碎；被破坏；被打破；坍塌；破产；倒闭；失败；崩溃；（计划）落空；被取消；（项目等）夭折；泡汤；告吹；（嗓音、视力、嗅觉等）丧失；停止工作；（时间）被占用；被浪费；被耗费；（机会）被错过；被失去；（脸面、镇定等）丧失；（勇气等）受挫；心碎；（笔尖、锯齿等）磨损；磨钝；变钝；烂醉；醉得不省人事</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">箋</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>信纸；纸条；标签；注释</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ふだ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">便箋</span><span class=\"kana\" lang=\"ja\">びんせん</span><span class=\"k-wz\">信纸；便笺；信笺</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">羨</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>羡慕；嫉妒</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">セン・エン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">うらや.む・あまり</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">羨む</span><span class=\"kana\" lang=\"ja\">うらやむ</span><span class=\"k-wz\">羡慕；嫉妒</span></li><li><span class=\"k-w\" lang=\"ja\">羨ましい</span><span class=\"kana\" lang=\"ja\">うらやましい</span><span class=\"k-wz\">羡慕的；嫉妒的；令人羡慕的；值得羡慕的</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">肘</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>肘；手臂</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">チュウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">ひじ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">肘</span><span class=\"kana\" lang=\"ja\">ひじ</span><span class=\"k-wz\">肘</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">遜</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>谦逊；恭顺；退让</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソン</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">したが.う・へりくだ.る・ゆず.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">謙遜</span><span class=\"kana\" lang=\"ja\">けんそん</span><span class=\"k-wz\">谦虚；谦逊；谦让</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">遡</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>追溯过去；逆流而上</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ソ・サク</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">さかのぼ.る</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">遡る</span><span class=\"kana\" lang=\"ja\">さかのぼる</span><span class=\"k-wz\">溯流而上；逆流而上；追溯；回溯；往前推；具有溯及力</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">隙</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n2\" href=\"../../n2/kanji/\">N2</a>缝隙；裂痕；分歧；机会；空闲</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ゲキ・キャク・ケキ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">すき・す.く・す.かす・ひま</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">隙間</span><span class=\"kana\" lang=\"ja\">すきま</span><span class=\"k-wz\">间隙；缝隙；孔隙；裂缝；空隙；空闲时间；间隔；间歇；不防备的时刻；疏忽大意；破绽；弱点</span></li></ul></div></li>"]