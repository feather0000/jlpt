["<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">大人</span><span class=\"v-r\" lang=\"ja\">おとな</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/kanji/\">N5</a><span class=\"v-m\">大人；成年人</span></div><div class=\"v-ex\"><span class=\"lx-src\"><span class=\"t-zh\">汉字 </span><span class=\"t-ja\" lang=\"ja\">漢字 </span><a href=\"../../n5/kanji/\" lang=\"ja\">大</a></span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">おなか</span><span class=\"v-r\" lang=\"ja\"></span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">腹部；肚子；胃</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"228315\">ううん、もういいよ。お<ruby>腹<rp>(</rp><rt>なか</rt><rp>)</rp></ruby>いっぱい。</span><span class=\"ex-zh\" lang=\"zh-Hans\">是的,好吧!我饿了。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">同じ</span><span class=\"v-r\" lang=\"ja\">おなじ</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">な形容词</span><span class=\"t-ja\" lang=\"ja\">な形容詞</span></span><span class=\"v-m\">相同；一样；相等；相似；等同；无论如何；总之；如果一定要；既然</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"219452\">この<ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>はあの<ruby>木<rp>(</rp><rt>き</rt><rp>)</rp></ruby>とほぼ<ruby>同<rp>(</rp><rt>おな</rt><rp>)</rp></ruby>じ<ruby>高<rp>(</rp><rt>たか</rt><rp>)</rp></ruby>さだ。</span><span class=\"ex-zh\" lang=\"zh-Hans\">那棵树的身高几乎相同。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">お兄さん</span><span class=\"v-r\" lang=\"ja\">おにいさん</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">哥哥；大哥；小伙子；哥们；老兄</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"161718\"><ruby>私<rp>(</rp><rt>わたし</rt><rp>)</rp></ruby>はあなたのお<ruby>兄<rp>(</rp><rt>にい</rt><rp>)</rp></ruby>さんより<ruby>年上<rp>(</rp><rt>としうえ</rt><rp>)</rp></ruby>です。</span><span class=\"ex-zh\" lang=\"zh-Hans\">我比你哥哥大。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">お姉さん</span><span class=\"v-r\" lang=\"ja\">おねえさん</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">姐姐；大姐；年轻女性；小姐；（称呼女服务员等）小姐；服务员；姐姐（艺伎对前辈的敬称）；大姐姐；年长的女孩</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"233258\">あなたのお<ruby>姉<rp>(</rp><rt>ねえ</rt><rp>)</rp></ruby>さんは<ruby>今<rp>(</rp><rt>いま</rt><rp>)</rp></ruby><ruby>何<rp>(</rp><rt>なに</rt><rp>)</rp></ruby>をしているの？</span><span class=\"ex-zh\" lang=\"zh-Hans\">你的妹妹现在在做什么?</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">お願いします</span><span class=\"v-r\" lang=\"ja\">おねがいします</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"v-m\">请；拜托了；麻烦了</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"197242\">ファーストクラスでお<ruby>願<rp>(</rp><rt>ねが</rt><rp>)</rp></ruby>いします。</span><span class=\"ex-zh\" lang=\"zh-Hans\">请在第一课。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">おはよう</span><span class=\"v-r\" lang=\"ja\"></span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">感叹词</span><span class=\"t-ja\" lang=\"ja\">感動詞</span></span><span class=\"v-m\">早上好</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"76824\">おはよう。ご<ruby>飯<rp>(</rp><rt>はん</rt><rp>)</rp></ruby>をよそっても<ruby>良<rp>(</rp><rt>よ</rt><rp>)</rp></ruby>いかしら？</span><span class=\"ex-zh\" lang=\"zh-Hans\">早上好,可以吃吗?</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">おばあさん</span><span class=\"v-r\" lang=\"ja\"></span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">祖母；奶奶；外婆；老妇人；老年女性</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"200160\">トムのおばあさんは<ruby>元気<rp>(</rp><rt>げんき</rt><rp>)</rp></ruby>そうですよ。</span><span class=\"ex-zh\" lang=\"zh-Hans\">汤姆的祖母看起来很好。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">伯母さん</span><span class=\"v-r\" lang=\"ja\">おばさん</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">姑妈；姨妈；婶婶；舅妈；伯母（对父母的姐妹或叔伯舅之妻的亲切称呼）</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"227572\"><ruby>叔母<rp>(</rp><rt>おば</rt><rp>)</rp></ruby>さんを<ruby>訪<rp>(</rp><rt>たず</rt><rp>)</rp></ruby>ねた<ruby>時<rp>(</rp><rt>とき</rt><rp>)</rp></ruby>はすごいごちそうだったね。</span><span class=\"ex-zh\" lang=\"zh-Hans\">看见叔叔的时候,吃得很棒。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">お風呂</span><span class=\"v-r\" lang=\"ja\">おふろ</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">洗澡；浴缸</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"158918\"><ruby>私<rp>(</rp><rt>わたし</rt><rp>)</rp></ruby>はほとんど<ruby>毎日<rp>(</rp><rt>まいにち</rt><rp>)</rp></ruby>お<ruby>風呂<rp>(</rp><rt>ふろ</rt><rp>)</rp></ruby>に<ruby>入<rp>(</rp><rt>はい</rt><rp>)</rp></ruby>ります。</span><span class=\"ex-zh\" lang=\"zh-Hans\">我几乎每天都在洗澡。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">お弁当</span><span class=\"v-r\" lang=\"ja\">おべんとう</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">便当；日式盒装午餐</span></div><div class=\"v-ex\"></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">覚える</span><span class=\"v-r\" lang=\"ja\">おぼえる</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">动词Ⅱ</span><span class=\"t-ja\" lang=\"ja\">動詞Ⅱ</span></span><span class=\"v-m\">记住；记忆；铭记；背下来；学习；学会；掌握；感到；感受；认为；看作；视为</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"122337\"><ruby>日本語<rp>(</rp><rt>にほんご</rt><rp>)</rp></ruby>は<ruby>外人<rp>(</rp><rt>がいじん</rt><rp>)</rp></ruby>にとって<ruby>覚<rp>(</rp><rt>おぼ</rt><rp>)</rp></ruby>えにくい。</span><span class=\"ex-zh\" lang=\"zh-Hans\">日本语对外国人很难记住。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">おまわりさん</span><span class=\"v-r\" lang=\"ja\"></span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">警察；警察官</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"214211\">すみません、おまわりさん。ここはどこですか。</span><span class=\"ex-zh\" lang=\"zh-Hans\">对不起,亲爱的,这里在哪里?</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">重い</span><span class=\"v-r\" lang=\"ja\">おもい</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">い形容词</span><span class=\"t-ja\" lang=\"ja\">い形容詞</span></span><span class=\"v-m\">沉重；重；沉闷；压抑；郁闷；忧郁；不安；缓慢；迟缓；笨重；笨拙；重要；重大；严肃；严重；严厉；严重；危急；病情严重；稳固；稳重；庄重；明智</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"200082\">トムはジャックよりも１０ポンド<ruby>重<rp>(</rp><rt>おも</rt><rp>)</rp></ruby>い。</span><span class=\"ex-zh\" lang=\"zh-Hans\">汤姆比杰克重10英镑。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">おもしろい</span><span class=\"v-r\" lang=\"ja\"></span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">い形容词</span><span class=\"t-ja\" lang=\"ja\">い形容詞</span></span><span class=\"v-m\">有趣的；引人入胜的；迷人的；有趣的；好笑的；滑稽的；愉快的；有趣的；娱乐性的；令人愉悦的；良好的；令人满意的；有利的；值得期待的</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"214743\">スケートはとてもおもしろかった。</span><span class=\"ex-zh\" lang=\"zh-Hans\">滑雪非常有趣。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">泳ぐ</span><span class=\"v-r\" lang=\"ja\">およぐ</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">动词Ⅰ</span><span class=\"t-ja\" lang=\"ja\">動詞Ⅰ</span></span><span class=\"v-m\">游泳；挤过；穿过（人群）；在世上立足；谋生；混世；蹒跚；踉跄；失去平衡</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"200074\">トムはすぐに<ruby>泳<rp>(</rp><rt>およ</rt><rp>)</rp></ruby>げるようになるよ。</span><span class=\"ex-zh\" lang=\"zh-Hans\">汤姆很快就能游泳。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">降りる</span><span class=\"v-r\" lang=\"ja\">おりる</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">动词Ⅱ</span><span class=\"t-ja\" lang=\"ja\">動詞Ⅱ</span></span><span class=\"v-m\">下降；下来；降下；下车；下船；下马；离开；下台；退职；放弃；退出；认输；获得；颁发；给予；形成；凝结（霜、露、雾等）；排出；排泄（蛔虫等寄生虫）</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"224559\">ここで<ruby>降<rp>(</rp><rt>お</rt><rp>)</rp></ruby>りましょう。</span><span class=\"ex-zh\" lang=\"zh-Hans\">我们在这里下车吧。 <a class=\"ex-attribution\" href=\"https://tatoeba.org/sentences/show/332792\" title=\"Tatoeba · fucongcong\" aria-label=\"Tatoeba · fucongcong\" target=\"_blank\" rel=\"noopener\">↗</a></span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">終る</span><span class=\"v-r\" lang=\"ja\">おわる</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">动词Ⅰ</span><span class=\"t-ja\" lang=\"ja\">動詞Ⅰ</span></span><span class=\"v-m\">结束；完结；终止；完结；完成；结束；做完；做完；完毕；过了最好的时期；不再年轻；糟糕；可怕；差劲；无望</span></div><div class=\"v-ex\"></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">音楽</span><span class=\"v-r\" lang=\"ja\">おんがく</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">音乐</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"222881\">この<ruby>音楽<rp>(</rp><rt>おんがく</rt><rp>)</rp></ruby>を<ruby>聞<rp>(</rp><rt>き</rt><rp>)</rp></ruby>いてくつろぎなさい。</span><span class=\"ex-zh\" lang=\"zh-Hans\">听这首音乐,放心吧。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">女</span><span class=\"v-r\" lang=\"ja\">おんな</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">女人；女性；女友；情妇；情人</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"144456\"><ruby>人<rp>(</rp><rt>ひと</rt><rp>)</rp></ruby>は<ruby>男<rp>(</rp><rt>おとこ</rt><rp>)</rp></ruby>か<ruby>女<rp>(</rp><rt>おんな</rt><rp>)</rp></ruby>のどちらかである。</span><span class=\"ex-zh\" lang=\"zh-Hans\">男人是男人或女人。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">女の子</span><span class=\"v-r\" lang=\"ja\">おんなのこ</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">女孩；女儿；女婴；年轻女性</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"147335\"><ruby>女<rp>(</rp><rt>おんな</rt><rp>)</rp></ruby>の<ruby>子<rp>(</rp><rt>こ</rt><rp>)</rp></ruby>はほとんどみんなやさしい。</span><span class=\"ex-zh\" lang=\"zh-Hans\">几乎所有的女孩都很轻松。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">会社</span><span class=\"v-r\" lang=\"ja\">かいしゃ</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/kanji/\">N5</a><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a><span class=\"v-m\">公司</span></div><div class=\"v-ex\"><span class=\"lx-src\"><span class=\"t-zh\">汉字 </span><span class=\"t-ja\" lang=\"ja\">漢字 </span><a href=\"../../n4/kanji/\" lang=\"ja\">会</a></span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">階段</span><span class=\"v-r\" lang=\"ja\">かいだん</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">阶梯；楼梯</span></div><div class=\"v-ex\"></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">買い物</span><span class=\"v-r\" lang=\"ja\">かいもの</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">购物；购买的商品</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"216415\">ジェーンは<ruby>買<rp>(</rp><rt>か</rt><rp>)</rp></ruby>い<ruby>物<rp>(</rp><rt>もの</rt><rp>)</rp></ruby>に<ruby>出<rp>(</rp><rt>で</rt><rp>)</rp></ruby>かけている。</span><span class=\"ex-zh\" lang=\"zh-Hans\">珍外出购物。 <a class=\"ex-attribution\" href=\"https://tatoeba.org/sentences/show/825932\" title=\"Tatoeba · Martha\" aria-label=\"Tatoeba · Martha\" target=\"_blank\" rel=\"noopener\">↗</a></span></div></li>","<li class=\"vrow\" data-id=\"n5:v:買う\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">買う</span><span class=\"v-r\" lang=\"ja\">かう</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">动词Ⅰ</span><span class=\"t-ja\" lang=\"ja\">動詞Ⅰ</span></span><span class=\"v-m\">买</span></div><div class=\"v-ex\"><span lang=\"ja\">スーパーで<ruby>野菜<rp>(</rp><rt>やさい</rt><rp>)</rp></ruby>を<ruby>買<rp>(</rp><rt>か</rt><rp>)</rp></ruby>いました。</span><span class=\"ex-zh\" lang=\"zh-Hans\">在超市买了蔬菜。</span></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">返す</span><span class=\"v-r\" lang=\"ja\">かえす</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">动词Ⅰ</span><span class=\"t-ja\" lang=\"ja\">動詞Ⅰ</span></span><span class=\"v-m\">归还；返还；放回；翻转；倒转；颠覆；偿还；报复；回报；回应；顶嘴；回答；反驳；反向做……（如反驳；反扔）；再做；反复做</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"149018\"><ruby>車<rp>(</rp><rt>くるま</rt><rp>)</rp></ruby>はいつ<ruby>返<rp>(</rp><rt>かえ</rt><rp>)</rp></ruby>したらいいでしょうか。</span><span class=\"ex-zh\" lang=\"zh-Hans\">什么时候可以把车还回来?</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">帰る</span><span class=\"v-r\" lang=\"ja\">かえる</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">动词Ⅰ</span><span class=\"t-ja\" lang=\"ja\">動詞Ⅰ</span></span><span class=\"v-m\">回家；返回；回去；归来；（客人等）离去；告辞；（棒球）跑回本垒；回本垒得分</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"75070\">「<ruby>帰<rp>(</rp><rt>かえ</rt><rp>)</rp></ruby>ろ」「マックよってかない？」</span><span class=\"ex-zh\" lang=\"zh-Hans\">“回来吧,马克不行吗?”</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">かかる</span><span class=\"v-r\" lang=\"ja\"></span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">动词Ⅰ</span><span class=\"t-ja\" lang=\"ja\">動詞Ⅰ</span></span><span class=\"v-m\">耗费；花费（时间、金钱等）；悬挂；挂着；映入眼帘；到达；受约束；纳入（合同、税收等）；启动；运转（引擎、马达等）；从事；处理；应对；开始（做）……；刚要……；快要……；重叠；覆盖；扑向；攻向；向……扑来；固定；系紧；被覆盖；被盖住（灰尘、桌布等）；被困；陷入；接到电话；依赖于；取决于；开始；着手；动手做</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"201593\">どうしたらエンジンがかかりますか。</span><span class=\"ex-zh\" lang=\"zh-Hans\">如何使用发动机?</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">かぎ</span><span class=\"v-r\" lang=\"ja\"></span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">钥匙；锁；关键；线索</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"149069\"><ruby>車<rp>(</rp><rt>くるま</rt><rp>)</rp></ruby>のカギをなくしちゃった。</span><span class=\"ex-zh\" lang=\"zh-Hans\">我失去了车的钥匙。</span></div></li>","<li class=\"vrow\" data-id=\"n5:v:書く\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">書く</span><span class=\"v-r\" lang=\"ja\">かく</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">动词Ⅰ</span><span class=\"t-ja\" lang=\"ja\">動詞Ⅰ</span></span><span class=\"v-m\">写</span></div><div class=\"v-ex\"><span lang=\"ja\">ここに<ruby>名前<rp>(</rp><rt>なまえ</rt><rp>)</rp></ruby>を<ruby>書<rp>(</rp><rt>か</rt><rp>)</rp></ruby>いてください。</span><span class=\"ex-zh\" lang=\"zh-Hans\">请在这里写名字。</span></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">かける</span><span class=\"v-r\" lang=\"ja\"></span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">动词Ⅱ</span><span class=\"t-ja\" lang=\"ja\">動詞Ⅱ</span></span><span class=\"v-m\">挂起；悬挂；吊起；升起；覆盖；铺盖；罩住；铺在……上面；戴上；佩戴；打电话；拨打；花费；消耗；耗费；浇上；洒上；溅上；泼上；打开；启动；调至；播放；给……添麻烦；使……感到不便；给……造成负担；相乘；乘以；锁上；上锁；坐下；搁置；靠；支撑；捆绑；束缚；赌；打赌；押注；下注；施加（咒语、麻醉等）；使生效；举办；举行；主办；抱有；心怀；寄托；在法庭辩论；在会议上讨论；提出；进一步增加；再加；诱捕；使陷入（陷阱等）；放在……上面；搭在……上面；搭建；架设；竖立；投保；加保；双关；谐音；一语双关；做到一半；开始但未完成；即将；向……说话；向……表达；对……做出</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"236074\">１０<ruby>円<rp>(</rp><rt>えん</rt><rp>)</rp></ruby>で<ruby>電話<rp>(</rp><rt>でんわ</rt><rp>)</rp></ruby>がかけられますか。</span><span class=\"ex-zh\" lang=\"zh-Hans\">我可以用10元打电话吗?</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">傘</span><span class=\"v-r\" lang=\"ja\">かさ</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">雨伞；阳伞；伞形物；灯罩；菌盖；菌伞</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"203724\">タクシーに<ruby>傘<rp>(</rp><rt>かさ</rt><rp>)</rp></ruby>を<ruby>忘<rp>(</rp><rt>わす</rt><rp>)</rp></ruby>れてしまった。</span><span class=\"ex-zh\" lang=\"zh-Hans\">我忘记了出租车的伞。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">火事</span><span class=\"v-r\" lang=\"ja\">かじ</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/kanji/\">N5</a><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a><span class=\"v-m\">火灾</span></div><div class=\"v-ex\"><span class=\"lx-src\"><span class=\"t-zh\">汉字 </span><span class=\"t-ja\" lang=\"ja\">漢字 </span><a href=\"../../n5/kanji/\" lang=\"ja\">火</a></span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">貸す</span><span class=\"v-r\" lang=\"ja\">かす</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">动词Ⅰ</span><span class=\"t-ja\" lang=\"ja\">動詞Ⅰ</span></span><span class=\"v-m\">出借；借出；出租；租出；交给；递给</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"196239\">ホッチキスを<ruby>貸<rp>(</rp><rt>か</rt><rp>)</rp></ruby>してくれませんか。</span><span class=\"ex-zh\" lang=\"zh-Hans\">你能给我一个霍奇吻吗?</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">風</span><span class=\"v-r\" lang=\"ja\">かぜ</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">风；微风；气流；样子；风格；举止；感冒；流感</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"226491\">カーテンが<ruby>風<rp>(</rp><rt>かぜ</rt><rp>)</rp></ruby>になびいた。</span><span class=\"ex-zh\" lang=\"zh-Hans\">窗帘被风吹了。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">風邪</span><span class=\"v-r\" lang=\"ja\">かぜ</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">感冒；流感；流行性感冒；风寒；呼吸道炎症性疾病</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"203635\">ただの<ruby>風邪<rp>(</rp><rt>かぜ</rt><rp>)</rp></ruby>でしょう。</span><span class=\"ex-zh\" lang=\"zh-Hans\">只是一个感冒。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">家族</span><span class=\"v-r\" lang=\"ja\">かぞく</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/kanji/\">N5</a><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a><span class=\"v-m\">家人</span></div><div class=\"v-ex\"><span class=\"lx-src\"><span class=\"t-zh\">汉字 </span><span class=\"t-ja\" lang=\"ja\">漢字 </span><a href=\"../../n4/kanji/\" lang=\"ja\">族</a></span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">方</span><span class=\"v-r\" lang=\"ja\">かた</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">方向；方位；方面；人士；先生；女士；……的方法；……的方式；……的做法；由……转交；寄住在……处（用于地址）；负责人；主管；（……的）一方；……那边（如母亲那边）</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"224157\">こちらはあなたがお<ruby>話<rp>(</rp><rt>はな</rt><rp>)</rp></ruby>しになるお<ruby>方<rp>(</rp><rt>かた</rt><rp>)</rp></ruby>です。</span><span class=\"ex-zh\" lang=\"zh-Hans\">这就是你要说话的方式。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">カップ</span><span class=\"v-r\" lang=\"ja\"></span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">杯子；量杯；文胸；奖杯</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"202407\">テーブルの<ruby>上<rp>(</rp><rt>うえ</rt><rp>)</rp></ruby>にカップがある。</span><span class=\"ex-zh\" lang=\"zh-Hans\">桌子上有杯子。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">家庭</span><span class=\"v-r\" lang=\"ja\">かてい</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/kanji/\">N5</a><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a><span class=\"v-m\">家庭</span></div><div class=\"v-ex\"><span class=\"lx-src\"><span class=\"t-zh\">汉字 </span><span class=\"t-ja\" lang=\"ja\">漢字 </span><a href=\"../../n4/kanji/\" lang=\"ja\">家</a></span></div></li>"]