["<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">会う</span><span class=\"v-r\" lang=\"ja\">あう</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/kanji/\">N5</a><a class=\"lvb\" data-level=\"n4\" href=\"../../n4/kanji/\">N4</a><span class=\"v-m\">见面</span></div><div class=\"v-ex\"><span class=\"lx-src\"><span class=\"t-zh\">汉字 </span><span class=\"t-ja\" lang=\"ja\">漢字 </span><a href=\"../../n4/kanji/\" lang=\"ja\">会</a></span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">青</span><span class=\"v-r\" lang=\"ja\">あお</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">蓝色；青色；绿色；绿灯；黑色（马的毛色）；蓝色五点牌；未成熟的；未熟的；年轻的</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"145720\"><ruby>信号<rp>(</rp><rt>しんごう</rt><rp>)</rp></ruby>が<ruby>青<rp>(</rp><rt>あお</rt><rp>)</rp></ruby>に<ruby>変<rp>(</rp><rt>か</rt><rp>)</rp></ruby>わったわよ。</span><span class=\"ex-zh\" lang=\"zh-Hans\">红绿灯变绿了。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">青い</span><span class=\"v-r\" lang=\"ja\">あおい</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">い形容词</span><span class=\"t-ja\" lang=\"ja\">い形容詞</span></span><span class=\"v-m\">蓝色；蔚蓝；绿色；苍白；灰白；未成熟；不成熟；缺乏经验</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"226939\">お<ruby>前<rp>(</rp><rt>まえ</rt><rp>)</rp></ruby>はまだ「<ruby>青<rp>(</rp><rt>あお</rt><rp>)</rp></ruby>い」な。</span><span class=\"ex-zh\" lang=\"zh-Hans\">你还太嫩了。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">赤</span><span class=\"v-r\" lang=\"ja\">あか</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">红；深红；猩红；含红色的颜色（如褐色、粉红色、橙色等）；红色（共产主义者）；红灯（交通）；红字（财务或校对中）；赤字；完全的；彻底的；完美的；明显的；铜；红色五点牌</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"142280\"><ruby>赤<rp>(</rp><rt>あか</rt><rp>)</rp></ruby>インクで<ruby>書<rp>(</rp><rt>か</rt><rp>)</rp></ruby>いてはいけない。</span><span class=\"ex-zh\" lang=\"zh-Hans\">不要写红墨水。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">赤い</span><span class=\"v-r\" lang=\"ja\">あかい</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">い形容词</span><span class=\"t-ja\" lang=\"ja\">い形容詞</span></span><span class=\"v-m\">红色；深红色；绯红色；朱红色；红色的；共产主义的</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"88306\"><ruby>彼女<rp>(</rp><rt>かのじょ</rt><rp>)</rp></ruby>は<ruby>赤<rp>(</rp><rt>あか</rt><rp>)</rp></ruby>いスカートをはいていた。</span><span class=\"ex-zh\" lang=\"zh-Hans\">她穿着红裙子。 <a class=\"ex-attribution\" href=\"https://tatoeba.org/sentences/show/349263\" title=\"Tatoeba · zhouj1955\" aria-label=\"Tatoeba · zhouj1955\" target=\"_blank\" rel=\"noopener\">↗</a></span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">明るい</span><span class=\"v-r\" lang=\"ja\">あかるい</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">い形容词</span><span class=\"t-ja\" lang=\"ja\">い形容詞</span></span><span class=\"v-m\">光亮；明亮；光线充足；（颜色）鲜艳；明快；（性格等）开朗；乐观；活泼；阳光；（前途等）光明；有希望；乐观；（对某事）熟悉；精通；通晓；（政治等）公正；廉洁；清廉</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"184877\"><ruby>外<rp>(</rp><rt>そと</rt><rp>)</rp></ruby>はだんだん<ruby>明<rp>(</rp><rt>あか</rt><rp>)</rp></ruby>るくなっていく。</span><span class=\"ex-zh\" lang=\"zh-Hans\">外面越来越轻了</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">秋</span><span class=\"v-r\" lang=\"ja\">あき</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">副词</span><span class=\"t-ja\" lang=\"ja\">副詞</span></span><span class=\"v-m\">秋季；秋天</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"148194\"><ruby>秋<rp>(</rp><rt>あき</rt><rp>)</rp></ruby>はもうすぐそこまで<ruby>来<rp>(</rp><rt>き</rt><rp>)</rp></ruby>ている。</span><span class=\"ex-zh\" lang=\"zh-Hans\">马上就要入秋了。 <a class=\"ex-attribution\" href=\"https://tatoeba.org/sentences/show/2312543\" title=\"Tatoeba · fercheung\" aria-label=\"Tatoeba · fercheung\" target=\"_blank\" rel=\"noopener\">↗</a></span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">開く</span><span class=\"v-r\" lang=\"ja\">あく</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">动词Ⅰ</span><span class=\"t-ja\" lang=\"ja\">動詞Ⅰ</span></span><span class=\"v-m\">打开；开启（如门等）；开张；开业（如商店等）；空着；闲置；空闲；有空；没人占用；敞开（如领口等）；（眼、嘴等）已睁开；张着；结束；终止；睁（眼）；张（嘴）；有洞；形成缝隙；间隔</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"225720\">ぐいと<ruby>押<rp>(</rp><rt>お</rt><rp>)</rp></ruby>すとドアは<ruby>開<rp>(</rp><rt>あ</rt><rp>)</rp></ruby>いた。</span><span class=\"ex-zh\" lang=\"zh-Hans\">门被大力推了一把</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">開ける</span><span class=\"v-r\" lang=\"ja\">あける</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">动词Ⅱ</span><span class=\"t-ja\" lang=\"ja\">動詞Ⅱ</span></span><span class=\"v-m\">打开（门等）；拆开（包裹等）；解锁；开门营业；开业；清空；腾出；留出空间；搬出；清空；离开（家等）；暂时外出；破晓；天亮；结束；终了；（新年）开始；新年伊始；空出（时间）；腾出时间；打（洞）；开（洞）</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"201846\">ドアはジムによって<ruby>開<rp>(</rp><rt>あ</rt><rp>)</rp></ruby>けられます。</span><span class=\"ex-zh\" lang=\"zh-Hans\">门是吉姆打开的</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">上げる</span><span class=\"v-r\" lang=\"ja\">あげる</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">动词Ⅱ</span><span class=\"t-ja\" lang=\"ja\">動詞Ⅱ</span></span><span class=\"v-m\">抬起；提高；移到高处；放到（如架子）上；提高（价格、质量、地位等）；涨（工资）；领（某人）进房间；迎入（如客人）；给予；赠与；送（孩子）入学；送去（如上大学）；培养（才能、技能等）；提高；磨练；获得（好的结果）；取得（如好成绩）；得到；提拔（某人）；晋升；完成；做完；发出（大的声音）；提高（嗓音）；抬起（视线）；抬起（脸）；向上看；盘（头发）；梳起（头发）；向神佛供奉（香、祈祷等）；表扬；称赞；奉承；控制在预算内；用给定金额支付开销；控制费用；修完（课业）；上完（课程）；通过（如课程）；上传（如图片）；在网上发布；发帖；提振某人的情绪；使某人振奋；烘托气氛；（潮水）涨潮；上涨；（市价）上涨；（股价）上升；呕吐；吐；为（别人的利益）做；做完…；完成…；谦恭地做…</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"170915\"><ruby>左手<rp>(</rp><rt>ひだりて</rt><rp>)</rp></ruby>を<ruby>上<rp>(</rp><rt>あ</rt><rp>)</rp></ruby>げなさい。</span><span class=\"ex-zh\" lang=\"zh-Hans\">举起左手</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">朝</span><span class=\"v-r\" lang=\"ja\">あさ</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">副词</span><span class=\"t-ja\" lang=\"ja\">副詞</span></span><span class=\"v-m\">早晨；上午；早餐；早饭</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"126237\"><ruby>朝<rp>(</rp><rt>あさ</rt><rp>)</rp></ruby>のラッシュは<ruby>今<rp>(</rp><rt>いま</rt><rp>)</rp></ruby>がピークだ。</span><span class=\"ex-zh\" lang=\"zh-Hans\">早上的赶时间已经到了顶峰</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">朝ごはん</span><span class=\"v-r\" lang=\"ja\">あさごはん</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">早餐；早饭</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"126246\"><ruby>朝<rp>(</rp><rt>あさ</rt><rp>)</rp></ruby>ご<ruby>飯<rp>(</rp><rt>はん</rt><rp>)</rp></ruby>に<ruby>何<rp>(</rp><rt>なに</rt><rp>)</rp></ruby>を<ruby>食<rp>(</rp><rt>た</rt><rp>)</rp></ruby>べますか。</span><span class=\"ex-zh\" lang=\"zh-Hans\">你通常早餐吃点什么?</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">あさって</span><span class=\"v-r\" lang=\"ja\"></span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">副词</span><span class=\"t-ja\" lang=\"ja\">副詞</span></span><span class=\"v-m\">后天；错误的；不对的</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"234491\">あさって<ruby>彼<rp>(</rp><rt>かれ</rt><rp>)</rp></ruby>にここへ<ruby>来<rp>(</rp><rt>き</rt><rp>)</rp></ruby>てもらうつもりです。</span><span class=\"ex-zh\" lang=\"zh-Hans\">后天我会让他来这里</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">足</span><span class=\"v-r\" lang=\"ja\">あし</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">脚；爪；腕（章鱼、乌贼等的）；腿；步态；步法；步速；步调；汉字的脚（下部偏旁）；交通工具；车辆；钱；硬币</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"195414\">また<ruby>足<rp>(</rp><rt>あし</rt><rp>)</rp></ruby>がしびれた。</span><span class=\"ex-zh\" lang=\"zh-Hans\">我的脚又睡着了!</span></div></li>","<li class=\"vrow\" data-id=\"n5:v:明日\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">明日</span><span class=\"v-r\" lang=\"ja\">あした</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">明天</span></div><div class=\"v-ex\"><span lang=\"ja\"><ruby>明日<rp>(</rp><rt>あした</rt><rp>)</rp></ruby>、<ruby>東京<rp>(</rp><rt>とうきょう</rt><rp>)</rp></ruby>へ<ruby>行<rp>(</rp><rt>い</rt><rp>)</rp></ruby>きます。</span><span class=\"ex-zh\" lang=\"zh-Hans\">明天去东京。</span></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">あそこ</span><span class=\"v-r\" lang=\"ja\"></span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">代词</span><span class=\"t-ja\" lang=\"ja\">代名詞</span></span><span class=\"v-m\">那里；那边；那个地方；那儿；生殖器；隐私部位；下体；那么远；那么多；那种程度</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"2733322\"><ruby>先生<rp>(</rp><rt>せんせい</rt><rp>)</rp></ruby>、アソコがかゆいんです。</span><span class=\"ex-zh\" lang=\"zh-Hans\">医生,我的内裤有痒</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">遊ぶ</span><span class=\"v-r\" lang=\"ja\">あそぶ</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">动词Ⅰ</span><span class=\"t-ja\" lang=\"ja\">動詞Ⅰ</span></span><span class=\"v-m\">玩耍；游戏；娱乐；消遣；鬼混；胡闹；寻欢作乐（指酒色、赌博等）；闲着；无所事事；闲置；未被使用；（和朋友）一起玩；出去玩；聚会；沉溺；放纵（赌博、饮酒等）；前往；去（为了娱乐或学习）；逗弄；戏弄；调侃；（棒球）故意投坏球以扰乱打者注意力</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"197343\">ビルはよく<ruby>一人<rp>(</rp><rt>ひとり</rt><rp>)</rp></ruby>でおもちゃで<ruby>遊<rp>(</rp><rt>あそ</rt><rp>)</rp></ruby>ぶ。</span><span class=\"ex-zh\" lang=\"zh-Hans\">比尔经常一个人玩玩具</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">暖かい</span><span class=\"v-r\" lang=\"ja\">あたたかい</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">い形容词</span><span class=\"t-ja\" lang=\"ja\">い形容詞</span></span><span class=\"v-m\">温暖；温和；（令人舒适的）炎热；体贴；亲切；和蔼；（颜色）温暖的；柔和的；手头宽裕；富裕</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"203062\">だんだん<ruby>暖<rp>(</rp><rt>あたた</rt><rp>)</rp></ruby>かくなります。</span><span class=\"ex-zh\" lang=\"zh-Hans\">它会越来越温暖。</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">頭</span><span class=\"v-r\" lang=\"ja\">あたま</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">头；头部；头发；头脑；思维；智力；领导；首领；头目；队长；顶端；顶部；尖端；开始；起始；人头；人；首付；预付款；定金；汉字的上部部件；（麻将）雀头；将牌</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"229971\">アリスは<ruby>頭<rp>(</rp><rt>あたま</rt><rp>)</rp></ruby>に<ruby>花<rp>(</rp><rt>はな</rt><rp>)</rp></ruby>をさしています。</span><span class=\"ex-zh\" lang=\"zh-Hans\">爱丽丝头发里有朵花</span></div></li>","<li class=\"vrow\" data-id=\"n5:v:新しい\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">新しい</span><span class=\"v-r\" lang=\"ja\">あたらしい</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">い形容词</span><span class=\"t-ja\" lang=\"ja\">い形容詞</span></span><span class=\"v-m\">新的</span></div><div class=\"v-ex\"><span lang=\"ja\"><ruby>新<rp>(</rp><rt>あたら</rt><rp>)</rp></ruby>しい<ruby>靴<rp>(</rp><rt>くつ</rt><rp>)</rp></ruby>を<ruby>買<rp>(</rp><rt>か</rt><rp>)</rp></ruby>いました。</span><span class=\"ex-zh\" lang=\"zh-Hans\">买了新鞋。</span></div><span class=\"st\" aria-hidden=\"true\"></span></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">あちら</span><span class=\"v-r\" lang=\"ja\"></span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">代词</span><span class=\"t-ja\" lang=\"ja\">代名詞</span></span><span class=\"v-m\">那边；那个方向；那里；远处；那个；那个人；那边；那里；外国（尤指西方国家）</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"217779\">こっちの<ruby>本<rp>(</rp><rt>ほん</rt><rp>)</rp></ruby>はあっちの<ruby>本<rp>(</rp><rt>ほん</rt><rp>)</rp></ruby>よりやさしい。</span><span class=\"ex-zh\" lang=\"zh-Hans\">这些书比那些书简单。 <a class=\"ex-attribution\" href=\"https://tatoeba.org/sentences/show/3667782\" title=\"Tatoeba · inkarl\" aria-label=\"Tatoeba · inkarl\" target=\"_blank\" rel=\"noopener\">↗</a></span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">あっち</span><span class=\"v-r\" lang=\"ja\"></span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">代词</span><span class=\"t-ja\" lang=\"ja\">代名詞</span></span><span class=\"v-m\">那边；那个方向；那里；远处；那个；那个人；那边；那里；外国（尤指西方国家）</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"217779\">こっちの<ruby>本<rp>(</rp><rt>ほん</rt><rp>)</rp></ruby>はあっちの<ruby>本<rp>(</rp><rt>ほん</rt><rp>)</rp></ruby>よりやさしい。</span><span class=\"ex-zh\" lang=\"zh-Hans\">这些书比那些书简单。 <a class=\"ex-attribution\" href=\"https://tatoeba.org/sentences/show/3667782\" title=\"Tatoeba · inkarl\" aria-label=\"Tatoeba · inkarl\" target=\"_blank\" rel=\"noopener\">↗</a></span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">厚い</span><span class=\"v-r\" lang=\"ja\">あつい</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">い形容词</span><span class=\"t-ja\" lang=\"ja\">い形容詞</span></span><span class=\"v-m\">厚；深；重；亲切；热情；好客；温暖；忠实；（病情）严重；丰厚；充裕</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"205578\">それは４ｃｍの<ruby>厚<rp>(</rp><rt>あつ</rt><rp>)</rp></ruby>さです。</span><span class=\"ex-zh\" lang=\"zh-Hans\">它有四厘米厚</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">暑い</span><span class=\"v-r\" lang=\"ja\">あつい</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">い形容词</span><span class=\"t-ja\" lang=\"ja\">い形容詞</span></span><span class=\"v-m\">炎热；闷热；酷热；热情的；激情的；炽热的（欲望等）；引人关注的；时下热门的；备受瞩目的</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"201579\">どうして、こんなに<ruby>暑<rp>(</rp><rt>あつ</rt><rp>)</rp></ruby>いのですか。</span><span class=\"ex-zh\" lang=\"zh-Hans\">为什么这么热?</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">熱い</span><span class=\"v-r\" lang=\"ja\">あつい</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">い形容词</span><span class=\"t-ja\" lang=\"ja\">い形容詞</span></span><span class=\"v-m\">热；烫；滚烫；热烈；炽热；火热；急躁；易怒；热情洋溢；热血；激烈；剧烈；极端；热门；受关注的</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"147486\"><ruby>熱<rp>(</rp><rt>あつ</rt><rp>)</rp></ruby>いコーヒーを<ruby>入<rp>(</rp><rt>い</rt><rp>)</rp></ruby>れてあげましょう。</span><span class=\"ex-zh\" lang=\"zh-Hans\">我给你泡杯咖啡</span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">後</span><span class=\"v-r\" lang=\"ja\">あと</span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\">名词</span><span class=\"t-ja\" lang=\"ja\">名詞</span></span><span class=\"v-m\">后面；背后；之后；以后；剩余；其余；还（剩）；再（如再过五分钟）；也；此外；后代；继承人；后继者；死后；过去；以前</span></div><div class=\"v-ex\"><span lang=\"ja\" data-tatoeba-id=\"189518\"><ruby>雨天<rp>(</rp><rt>うてん</rt><rp>)</rp></ruby>の<ruby>後<rp>(</rp><rt>あと</rt><rp>)</rp></ruby>には<ruby>晴天<rp>(</rp><rt>せいてん</rt><rp>)</rp></ruby>が<ruby>来<rp>(</rp><rt>く</rt><rp>)</rp></ruby>る。</span><span class=\"ex-zh\" lang=\"zh-Hans\">风暴过后，太阳出来了。 <a class=\"ex-attribution\" href=\"https://tatoeba.org/sentences/show/7768231\" title=\"Tatoeba · jiangche\" aria-label=\"Tatoeba · jiangche\" target=\"_blank\" rel=\"noopener\">↗</a></span></div></li>","<li class=\"vrow\"><div class=\"v-head\"><span class=\"v-w\" lang=\"ja\">あなた</span><span class=\"v-r\" lang=\"ja\"></span></div><div class=\"v-mid\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/vocab/\">N5</a><span class=\"pos\"><span class=\"t-zh\"