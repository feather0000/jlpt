["<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">雨</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/kanji/\">N5</a>雨</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">あめ・あま-・-さめ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">雨</span><span class=\"kana\" lang=\"ja\">あめ</span><span class=\"k-wz\">雨；雨天；阴雨天气；花札十一月组</span></li><li><span class=\"k-w\" lang=\"ja\">梅雨</span><span class=\"kana\" lang=\"ja\">つゆ</span><span class=\"k-wz\">梅雨季节；雨季（东亚地区，在日本通常从6月初到7月中旬）；梅雨</span></li><li><span class=\"k-w\" lang=\"ja\">雨戸</span><span class=\"kana\" lang=\"ja\">あまど</span><span class=\"k-wz\">滑动式防风雨窗板；推拉式防暴风雨隔板</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">丈</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/kanji/\">N5</a>长度；身高；仅；十尺；丈</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">ジョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">たけ・だけ</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">丈夫</span><span class=\"kana\" lang=\"ja\">じょうふ</span><span class=\"k-wz\">英雄；男子汉；勇士</span></li><li><span class=\"k-w\" lang=\"ja\">大丈夫</span><span class=\"kana\" lang=\"ja\">だいじょうぶ</span><span class=\"k-wz\">安全；牢靠；稳妥；无虑；没问题；没关系；确实；必然；无疑；不用了；谢了；算了；大丈夫；堂堂正正的男子汉</span></li><li><span class=\"k-w\" lang=\"ja\">丈</span><span class=\"kana\" lang=\"ja\">たけ</span><span class=\"k-wz\">身高；身材；（衣物的）长度；全部；所有；（和歌等的）雄浑；壮美</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">誰</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/kanji/\">N5</a>谁；某人</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">スイ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">だれ・たれ・た</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">誰</span><span class=\"kana\" lang=\"ja\">だれ</span><span class=\"k-wz\">谁</span></li><li><span class=\"k-w\" lang=\"ja\">誰か</span><span class=\"kana\" lang=\"ja\">だれか</span><span class=\"k-wz\">某人；某个人</span></li></ul></div></li>","<li class=\"kcard\"><div class=\"k-ch\" lang=\"ja\">貼</div><div class=\"k-body\"><p class=\"k-m\"><a class=\"lvb\" data-level=\"n5\" href=\"../../n5/kanji/\">N5</a>粘贴；附着；贴附</p><dl class=\"k-yomi\"><dt><span class=\"t-zh\">音读</span><span class=\"t-ja\" lang=\"ja\">音読み</span></dt><dd lang=\"ja\">テン・チョウ</dd><dt><span class=\"t-zh\">训读</span><span class=\"t-ja\" lang=\"ja\">訓読み</span></dt><dd lang=\"ja\">は.る・つ.く</dd></dl><ul class=\"k-ws\"><li><span class=\"k-w\" lang=\"ja\">貼る</span><span class=\"kana\" lang=\"ja\">はる</span><span class=\"k-wz\">粘贴；贴上；粘附；拉伸；展开；绷紧；张开；搭建；形成（如池塘结冰）；充盈；肿胀；伸出；突出；发布；张贴（链接等）；昂贵；价高；监视；留意；守望；拍打；扇打；听牌；（数学）张成；生成</span></li></ul></div></li>"]